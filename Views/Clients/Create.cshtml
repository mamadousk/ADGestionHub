@model AdGestionHub.Models.ViewModels.ClientFormViewModel
@{
    var ctx = await TenantCtx.GetContextAsync();
    ViewData["Title"] = L.T("Nouveau client", "New Customer");
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="panel-card p-4">
            <h1 class="h5 mb-3">@ViewData["Title"]</h1>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label">@L.T("Nom complet ou Raison sociale", "Full Name or Company") *</label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-sober-red small"></span>
                    </div>

                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input class="form-check-input" asp-for="IsBusinessClient" />
                            <label class="form-check-label small" asp-for="IsBusinessClient">
                                @L.T("Client professionnel (B2B)", "Business client (B2B)")
                            </label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">@L.T("Téléphone", "Phone") (@ctx.Settings.PhoneDialCode)</label>
                        <input asp-for="Phone" class="form-control num" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" />
                    </div>

                    @if (ctx.IsFormalized)
                    {
                        <div class="col-12">
                            <label asp-for="TaxIdentificationNumber" class="form-label">@L.T("Identifiant fiscal client", "Customer Tax ID") (@ctx.TaxIdLabel)</label>
                            <input asp-for="TaxIdentificationNumber" class="form-control num" placeholder="@L.T("Pour la facturation B2B", "For B2B invoicing")" />
                        </div>
                    }

                    <div class="col-12">
                        <label asp-for="Address" class="form-label">@L.T("Adresse", "Address")</label>
                        <input asp-for="Address" class="form-control" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label">@L.T("Notes internes", "Internal notes")</label>
                        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-secondary-outline">@L["Action.Cancel"]</a>
                    <button type="submit" class="btn btn-accent">@L["Action.Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
