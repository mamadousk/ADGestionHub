@model IEnumerable<AdGestionHub.Models.GlobalNotification>
@{
    ViewData["Title"] = L["Nav.SystemNotices"];
    var list = Model?.ToList() ?? new List<AdGestionHub.Models.GlobalNotification>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h4 mb-0">@ViewData["Title"]</h1>
    <a asp-action="Index" class="btn btn-secondary-outline">@L["Action.Back"]</a>
</div>

<div class="panel-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-ledger">
            <thead>
                <tr>
                    <th>@L.T("Expiration", "Expires")</th>
                    <th>Message</th>
                    <th>@L.T("Niveau", "Severity")</th>
                    <th class="text-end">@L.T("Action", "Action")</th>
                </tr>
            </thead>
            <tbody>
                @if (!list.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-slate py-5">@L.T("Aucune annonce enregistrée.", "No notices recorded.")</td>
                    </tr>
                }
                else
                {
                    foreach (var item in list)
                    {
                        <tr>
                            <td class="num text-slate">@item.ExpiryDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-medium">@item.Message</td>
                            <td>
                                @if (item.IsCritical)
                                {
                                    <span class="status-pill danger">@L.T("Critique", "Critical")</span>
                                }
                                else
                                {
                                    <span class="status-pill info">@L.T("Information", "Info")</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="DeleteNotification" asp-route-id="@item.Id" method="post" onsubmit="return confirm('@L.T("Supprimer cette annonce ?", "Delete this notice?")');" class="d-inline">
                                    <button type="submit" class="btn btn-danger-outline btn-sm py-1 px-2">
                                        @LucideIcons.Svg("trash-2", 14)
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
