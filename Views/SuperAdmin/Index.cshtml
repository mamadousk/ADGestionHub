@model IEnumerable<AdGestionHub.Models.Boutique>
@{
    ViewData["Title"] = "Super Admin";
    var saleCount = ViewBag.SaleCount as int? ?? 0;
    var boutiqueCount = ViewBag.BoutiqueCount as int? ?? 0;
    var activeBoutiqueCount = ViewBag.ActiveBoutiqueCount as int? ?? 0;
    var totalProducts = ViewBag.TotalProducts as int? ?? 0;
    var waitingListCount = ViewBag.WaitingListCount as int? ?? 0;
    var feedbacks = ViewBag.Feedbacks as IEnumerable<AdGestionHub.Models.UserFeedback>;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h4 mb-1">@L.T("Console d'administration plateforme", "Platform Administration Console")</h1>
        <p class="text-slate small mb-0">@L.T("Supervision des entreprises, annonces et retours utilisateurs", "Multi-tenant oversight, global notices, and user feedback")</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ManagePopups" class="btn btn-accent">@LucideIcons.Svg("globe", 17, "me-1") Pop-ups publics</a>
        <a asp-controller="Marketing" asp-action="AdminDashboard" class="btn btn-secondary-outline num">
            @L.T("Leads Pro", "Pro Leads") (@waitingListCount)
        </a>
        <a asp-action="Logs" class="btn btn-secondary-outline">
            @L["Nav.ErrorLogs"]
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label">@L.T("Établissements actifs", "Active Establishments")</div>
            <div class="kpi-value">@activeBoutiqueCount / @boutiqueCount</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label">@L.T("Ventes enregistrées", "Recorded Sales")</div>
            <div class="kpi-value">@saleCount.ToString("N0")</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label">@L.T("Articles référencés", "Catalog Items")</div>
            <div class="kpi-value">@totalProducts</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label">@L.T("Inscriptions Pro", "Pro Signups")</div>
            <div class="kpi-value">@waitingListCount</div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="panel-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h6 mb-0">@L.T("Diffuser une annonce système", "Broadcast System Notice")</h2>
                <a asp-action="ManageNotifications" class="btn btn-secondary-outline btn-sm">@L.T("Historique", "History")</a>
            </div>
            <p class="small text-slate mb-3"><span class="status-pill info me-1">Connectés uniquement</span> L’annonce s’affiche en bandeau dans le site.</p>
            <form asp-action="SendNotification" method="post">
                <div class="mb-3">
                    <label class="form-label" for="systemNoticeMessage">@L.T("Message", "Message")</label>
                    <input id="systemNoticeMessage" type="text" name="message" class="form-control" maxlength="300" required />
                </div>
                <div class="row g-3 align-items-end mb-3">
                    <div class="col-sm-6">
                        <label class="form-label" for="systemNoticeDuration">@L.T("Durée (heures)", "Duration (hours)")</label>
                        <input id="systemNoticeDuration" type="number" name="hoursActive" value="4" min="1" max="720" class="form-control num" />
                    </div>
                    <div class="col-sm-6">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" name="isCritical" value="true" id="isCriticalSwitch" />
                            <label class="form-check-label small text-sober-red fw-medium" for="isCriticalSwitch">@L.T("Alerte critique", "Critical notice")</label>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-secondary-outline w-100">Publier l’annonce système</button>
            </form>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="panel-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h6 mb-0">@L.T("Derniers avis utilisateurs", "Recent User Feedback")</h2>
                <a asp-controller="Marketing" asp-action="AdminDashboard" class="btn btn-secondary-outline btn-sm">@L.T("Tout voir", "View all")</a>
            </div>
            @if (feedbacks != null && feedbacks.Any())
            {
                foreach (var fb in feedbacks)
                {
                    <div class="py-2 border-bottom">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-medium small">@fb.UserName</span>
                            <span class="status-pill num">@Math.Clamp(fb.Note, 1, 5) / 5</span>
                        </div>
                        <p class="text-slate small mb-0 mt-1">@fb.Commentaire</p>
                    </div>
                }
            }
            else
            {
                <p class="text-slate small mb-0">@L.T("Aucun retour reçu.", "No feedback yet.")</p>
            }
        </div>
    </div>
</div>

<div class="panel-card overflow-hidden">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <h2 class="h6 mb-0 num">@L.T("Établissements inscrits", "Registered Establishments") (@boutiqueCount)</h2>
    </div>
    <div class="table-responsive">
        <table class="table table-ledger">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>@L.T("Établissement", "Business")</th>
                    <th>Email</th>
                    <th>@L.T("Téléphone", "Phone")</th>
                    <th>@L.T("Statut", "Status")</th>
                    <th>@L["Doc.Date"]</th>
                    <th class="text-end">@L.T("Actions", "Actions")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var boutique in Model)
                {
                    <tr>
                        <td class="num text-slate">#@boutique.Id</td>
                        <td class="fw-medium">@boutique.Nom</td>
                        <td class="text-slate">@boutique.Email</td>
                        <td class="num text-slate">@(string.IsNullOrWhiteSpace(boutique.Telephone) ? "—" : boutique.Telephone)</td>
                        <td>
                            @if (boutique.IsActive)
                            {
                                <span class="status-pill success">@L.T("Actif", "Active")</span>
                            }
                            else
                            {
                                <span class="status-pill danger">@L.T("Suspendu", "Suspended")</span>
                            }
                        </td>
                        <td class="num text-slate">@boutique.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="BoutiqueDetails" asp-route-id="@boutique.Id" class="btn btn-secondary-outline btn-sm py-1 px-2 me-1">
                                @LucideIcons.Svg("eye", 15)
                            </a>
                            <form asp-action="ToggleBoutiqueStatus" asp-route-id="@boutique.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('@(boutique.IsActive ? "Suspendre cet établissement ?" : "Réactiver cet établissement ?")');">
                                <button type="submit" class="btn btn-sm py-1 px-2 @(boutique.IsActive ? "btn-danger-outline" : "btn-secondary-outline")">
                                    @(boutique.IsActive ? L.T("Suspendre", "Suspend") : L.T("Activer", "Enable"))
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
