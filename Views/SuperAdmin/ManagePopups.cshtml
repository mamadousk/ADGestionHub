@model ManagePopupsViewModel
@{
    ViewData["Title"] = "Pop-ups publics";
    var now = DateTimeOffset.UtcNow;
    var latest = Model.History.FirstOrDefault();
    var live = latest?.IsVisibleAt(now) == true;
    string AtUtc(DateTimeOffset value) => value.ToString("dd/MM/yyyy HH:mm 'UTC'");
}

<div class="page-heading">
    <div>
        <p class="section-eyebrow">Communication plateforme</p>
        <h1>Pop-ups publics</h1>
        <p>Affichez un message à tous les visiteurs, même ceux qui ne sont pas connectés.</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary-outline">Retour à la console</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <section class="panel-card p-3 p-md-4 h-100" aria-labelledby="popupEditorTitle">
            <p class="section-eyebrow">Nouvelle publication</p>
            <h2 class="h5 mb-1" id="popupEditorTitle">Rédiger un pop-up</h2>
            <p class="text-slate small mb-4">Un pop-up à la fois. Une nouvelle publication remplace la précédente.</p>
            <form asp-action="SavePopup" method="post">
                <div asp-validation-summary="All" class="validation-banner" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Input.Title" class="form-label">Titre</label>
                    <input asp-for="Input.Title" class="form-control" maxlength="@PublicPopup.MaxTitleLength" placeholder="Ex. Maintenance prévue dimanche" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Input.MessageHtml" class="form-label">Message <span class="fw-normal text-slate">(texte ou HTML)</span></label>
                    <textarea asp-for="Input.MessageHtml" class="form-control popup-editor" rows="7" maxlength="@PublicPopupHtml.MaxInputLength"
                              aria-describedby="popupHtmlHelp" spellcheck="false" placeholder="&lt;p&gt;Bienvenue sur &lt;strong&gt;AD Gestion Hub&lt;/strong&gt;.&lt;/p&gt;" required></textarea>
                    <p id="popupHtmlHelp" class="form-text mb-0">
                        Paragraphes, titres, gras, italique, listes et liens <code>https://</code> ou chemins du site (<code>/Infos/CGU</code>) sont acceptés.
                        Les scripts, styles, images et formulaires sont retirés. Vérifiez le résultat dans l’aperçu.
                    </p>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.HoursActive" class="form-label">Durée de diffusion (heures)</label>
                    <input asp-for="Input.HoursActive" type="number" class="form-control num popup-hours" min="1" max="720" step="1" required />
                </div>
                <div class="d-flex flex-wrap gap-2 pt-2">
                    <button type="submit" asp-action="SavePopup" asp-fragment="popupPreview" name="command" value="preview" class="btn btn-secondary-outline">@LucideIcons.Svg("eye", 16, "me-1") Aperçu</button>
                    <button type="submit" name="command" value="publish" class="btn btn-accent">Publier pour tous</button>
                </div>
            </form>
        </section>
    </div>
    <div class="col-lg-5">
        <section class="panel-card p-3 p-md-4 mb-3" aria-labelledby="livePopupHeading">
            <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-2">
                <h2 class="h6 mb-0" id="livePopupHeading">Diffusion actuelle</h2>
                <span class="status-pill @(live ? "success" : "info")">@(live ? "En ligne" : "Aucun pop-up actif")</span>
            </div>
            @if (live && latest != null)
            {
                <p class="fw-semibold text-break mb-1">@latest.Title</p>
                <p class="small text-slate mb-3">Expire le <time datetime="@latest.ExpiresAtUtc.ToString("O")">@AtUtc(latest.ExpiresAtUtc)</time>.</p>
                <form asp-action="WithdrawPopup" asp-route-id="@latest.Id" method="post">
                    <button type="submit" class="btn btn-danger-outline btn-sm">Retirer de la diffusion</button>
                </form>
            }
            else
            {
                <p class="small text-slate mb-0">Les visiteurs naviguent sans pop-up public.</p>
            }
        </section>
        <section class="panel-card p-3 p-md-4" aria-labelledby="popupPreviewHeading">
            <h2 class="h6 mb-1" id="popupPreviewHeading">Aperçu</h2>
            <p class="small text-slate mb-3">Le brouillon n’est visible que dans cette console.</p>
            @if (Model.PreviewHtml is string preview)
            {
                <div class="public-popup-preview" id="popupPreview">
                    <div class="public-popup-header public-popup-heading">
                        <span class="public-popup-mark" aria-hidden="true">@LucideIcons.Svg("bell", 20)</span>
                        <div class="public-popup-title-wrap">
                            <p class="public-popup-kicker">Information de la plateforme</p>
                            <h3 class="public-popup-title">@Model.Input.Title.Trim()</h3>
                        </div>
                    </div>
                    <div class="public-popup-message">@PublicPopupHtml.Render(preview)</div>
                </div>
            }
            else
            {
                <div class="public-popup-preview-empty text-slate small">Cliquez sur « Aperçu » pour voir exactement le contenu autorisé avant de publier.</div>
            }
        </section>
    </div>
</div>

<section class="panel-card overflow-hidden" aria-labelledby="popupHistoryHeading">
    <div class="p-3 p-md-4 border-bottom">
        <h2 class="h6 mb-1" id="popupHistoryHeading">Historique des publications</h2>
        <p class="text-slate small mb-0">Les 20 dernières publications. Les brouillons ne sont pas conservés.</p>
    </div>
    @if (Model.History.Count == 0)
    {
        <p class="small text-slate px-3 px-md-4 py-3 mb-0">Aucun pop-up publié pour le moment.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-ledger">
                <thead><tr><th scope="col">Titre</th><th scope="col">Publication</th><th scope="col">Expiration</th><th scope="col">Statut</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.History)
                    {
                        var current = item.Id == latest?.Id && live;
                        var status = current ? "En ligne" : item.WithdrawnAtUtc.HasValue ? "Retiré" : item.Id != latest?.Id ? "Remplacé" : "Expiré";
                        <tr>
                            <td class="fw-semibold">@item.Title</td>
                            <td class="num text-nowrap">@AtUtc(item.PublishedAtUtc)</td>
                            <td class="num text-nowrap">@AtUtc(item.ExpiresAtUtc)</td>
                            <td><span class="status-pill @(current ? "success" : "info")">@status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
