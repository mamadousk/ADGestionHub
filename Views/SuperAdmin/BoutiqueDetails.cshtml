@model AdGestionHub.Models.Boutique
@{
    ViewData["Title"] = "Détails de la boutique";
    var salesTotal = ViewBag.SalesTotal as decimal? ?? 0m;
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-0" style="color:#FF8C00;">🏪 @Model.Nom</h1>
            <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger") mt-1">
                @(Model.IsActive ? "Boutique Active" : "Boutique Suspendue")
            </span>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <form asp-action="ToggleBoutiqueStatus" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn @(Model.IsActive ? "btn-outline-danger" : "btn-success") rounded-pill px-4">
                    <i class="fas @(Model.IsActive ? "fa-ban" : "fa-check") me-1"></i>
                    @(Model.IsActive ? "Suspendre la boutique" : "Réactiver la boutique")
                </button>
            </form>
            <a asp-action="Index" class="btn btn-soft">
                <i class="fas fa-arrow-left me-1"></i> Retour
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Informations générales</h5>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="fw-semibold">ID</span>
                            <span>#@Model.Id</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="fw-semibold">Nom</span>
                            <span>@Model.Nom</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="fw-semibold">Adresse</span>
                            <span>@(string.IsNullOrWhiteSpace(Model.Adresse) ? "Non renseignée" : Model.Adresse)</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="fw-semibold">Téléphone</span>
                            <span>@(string.IsNullOrWhiteSpace(Model.Telephone) ? "Non renseigné" : Model.Telephone)</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="fw-semibold">Email</span>
                            <span>@Model.Email</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="fw-semibold">Chiffre d'affaires cumulé</span>
                            <strong class="text-success">@salesTotal.ToString("N2") $</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="fw-semibold">Date de création</span>
                            <span>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">Indicateurs d'activité</h5>
                    <div class="row text-center g-3">
                        <div class="col-6">
                            <div class="p-4 bg-primary bg-opacity-10 rounded-4">
                                <h3 class="fw-bold text-primary mb-0">@ViewBag.ProductCount</h3>
                                <small class="text-muted">Produits</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-4 bg-success bg-opacity-10 rounded-4">
                                <h3 class="fw-bold text-success mb-0">@ViewBag.SaleCount</h3>
                                <small class="text-muted">Ventes</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-4 bg-warning bg-opacity-10 rounded-4">
                                <h3 class="fw-bold text-warning mb-0">@ViewBag.EmployeeCount</h3>
                                <small class="text-muted">Utilisateurs</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-4 bg-danger bg-opacity-10 rounded-4">
                                <h3 class="fw-bold text-danger mb-0">@ViewBag.DebtCount</h3>
                                <small class="text-muted">Dettes impayées</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
