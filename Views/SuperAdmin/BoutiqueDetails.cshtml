@model AdGestionHub.Models.Boutique
@{
    ViewData["Title"] = Model.Nom;
    var salesTotal = ViewBag.SalesTotal as decimal? ?? 0m;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h1 class="h4 mb-0">@Model.Nom</h1>
            <span class="status-pill @(Model.IsActive ? "success" : "danger")">
                @(Model.IsActive ? L.T("Actif", "Active") : L.T("Suspendu", "Suspended"))
            </span>
        </div>
        <p class="text-slate small mb-0 num">ID #@Model.Id · @Model.Email</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="ToggleBoutiqueStatus" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn @(Model.IsActive ? "btn-danger-outline" : "btn-accent")">
                @(Model.IsActive ? L.T("Suspendre", "Suspend") : L.T("Réactiver", "Reactivate"))
            </button>
        </form>
        <a asp-action="Index" class="btn btn-secondary-outline">@L["Action.Back"]</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="panel-card p-4 h-100">
            <h2 class="h6 mb-3">@L.T("Informations générales", "General Information")</h2>
            <div class="d-flex justify-content-between py-2 border-bottom">
                <span class="text-slate small">@L.T("Adresse", "Address")</span>
                <span class="small">@(string.IsNullOrWhiteSpace(Model.Adresse) ? "—" : Model.Adresse)</span>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom">
                <span class="text-slate small">@L.T("Téléphone", "Phone")</span>
                <span class="small num">@(string.IsNullOrWhiteSpace(Model.Telephone) ? "—" : Model.Telephone)</span>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom">
                <span class="text-slate small">@L.T("Volume brut", "Gross Volume")</span>
                <span class="small num fw-semibold">@salesTotal.ToString("N2")</span>
            </div>
            <div class="d-flex justify-content-between py-2">
                <span class="text-slate small">@L.T("Créé le", "Created")</span>
                <span class="small num">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="row g-3">
            <div class="col-6">
                <div class="kpi-card">
                    <div class="kpi-label">@L["Nav.Products"]</div>
                    <div class="kpi-value">@ViewBag.ProductCount</div>
                </div>
            </div>
            <div class="col-6">
                <div class="kpi-card">
                    <div class="kpi-label">@L["Nav.Sales"]</div>
                    <div class="kpi-value">@ViewBag.SaleCount</div>
                </div>
            </div>
            <div class="col-6">
                <div class="kpi-card">
                    <div class="kpi-label">@L["Nav.Users"]</div>
                    <div class="kpi-value">@ViewBag.EmployeeCount</div>
                </div>
            </div>
            <div class="col-6">
                <div class="kpi-card">
                    <div class="kpi-label">@L["Nav.Debts"]</div>
                    <div class="kpi-value">@ViewBag.DebtCount</div>
                </div>
            </div>
        </div>
    </div>
</div>
