@using System.Text.Encodings.Web
@model IEnumerable<AdGestionHub.Models.ErrorLog>
@{
    ViewData["Title"] = L["Nav.ErrorLogs"];
    var list = Model?.ToList() ?? new List<AdGestionHub.Models.ErrorLog>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h4 mb-1">@ViewData["Title"]</h1>
        <p class="text-slate small mb-0 num">@list.Count @L.T("entrée(s)", "entry(ies)")</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary-outline">@L["Action.Back"]</a>
</div>

<div class="panel-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-ledger">
            <thead>
                <tr>
                    <th>@L["Doc.Date"]</th>
                    <th>@L.T("Utilisateur", "User")</th>
                    <th>@L.T("Contrôleur", "Controller")</th>
                    <th>Message</th>
                    <th class="text-end">@L.T("Trace", "Trace")</th>
                </tr>
            </thead>
            <tbody>
                @if (!list.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-slate py-5">@L.T("Aucune exception enregistrée.", "No exceptions logged.")</td>
                    </tr>
                }
                else
                {
                    foreach (var log in list)
                    {
                        <tr>
                            <td class="num text-slate text-nowrap">@log.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(log.UserEmail ?? "—")</td>
                            <td class="text-slate small">@log.ControllerName / @log.ActionName</td>
                            <td class="small">@log.Message</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-secondary-outline btn-sm py-1 px-2" onclick="alert('@Html.Raw(JavaScriptEncoder.Default.Encode(log.StackTrace ?? "—"))')">
                                    @LucideIcons.Svg("eye", 14)
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
