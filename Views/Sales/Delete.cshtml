@model Sale
@{ ViewData["Title"] = "Annuler la vente"; }
<div class="page-heading"><div><p class="section-eyebrow">Ventes</p><h1>Annuler la vente @Model.Number</h1><p>La vente sera conservée dans l’historique et ses produits seront remis en stock.</p></div></div>
<div class="panel-card p-3 p-md-4 compact-form">
    @if (Model.IsCancelled || Model.Payments.Count != 0)
    {
        <p class="mb-3">@(Model.IsCancelled ? "Cette vente est déjà annulée." : "Une vente avec règlement ne peut pas être annulée en V1.")</p>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary-outline">Retour</a>
    }
    else
    {
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <label for="voidReason" class="form-label">Motif de l’annulation</label><textarea id="voidReason" name="reason" class="form-control" maxlength="300" rows="3" required></textarea>
            <div class="form-actions"><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary-outline">Retour</a><button type="submit" class="btn btn-danger-outline">Confirmer l’annulation</button></div>
        </form>
    }
</div>
