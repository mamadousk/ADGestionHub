@model IReadOnlyList<Sale>
@{ ViewData["Title"] = "Ventes et factures"; }
<div class="page-heading">
    <div><p class="section-eyebrow">Opérations</p><h1>Ventes et factures</h1><p>Suivez les ventes, leurs règlements et les factures commerciales.</p></div>
    @if ((await StaffCtx.CurrentAsync()).Has(StaffPermission.Sell))
    {
        <a asp-action="Create" class="btn btn-accent">@LucideIcons.Svg("plus", 17, "me-1") Nouvelle vente</a>
    }
</div>
@if (Model.Count == 0)
{
    <div class="panel-card empty-panel"><h2 class="h5">Aucune vente pour le moment</h2><p class="text-slate mb-0">Votre première vente apparaîtra ici avec son total et son solde.</p></div>
}
else
{
    <div class="panel-card table-responsive"><table class="table table-ledger">
        <thead><tr><th scope="col">Vente</th><th scope="col">Client</th><th scope="col" class="text-end">Total</th><th scope="col" class="text-end">Reste dû</th><th scope="col">Règlement</th></tr></thead>
        <tbody>
        @foreach (var sale in Model)
        {
            var badge = sale.IsCancelled ? "danger" : sale.Balance == 0 ? "success" : "warning";
            <tr><td><a class="fw-semibold" asp-action="Details" asp-route-id="@sale.Id">@sale.Number</a><div class="text-slate small">@sale.SaleDate.ToString("dd/MM/yyyy HH:mm")</div></td>
                <td>@(sale.CustomerName ?? "Client de passage")</td><td class="text-end text-nowrap">@Money.Display(sale.FinalPrice, sale.CurrencyCode)</td><td class="text-end text-nowrap">@Money.Display(sale.Balance, sale.CurrencyCode)</td><td><span class="status-pill @badge">@sale.PaymentStatus</span></td></tr>
        }
        </tbody>
    </table></div>
}
