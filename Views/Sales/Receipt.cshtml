@model Sale
@{
    Layout = null;
    var settings = (StoreSettings)ViewData["StoreSettings"]!;
    var logo = ViewData["LogoDataUrl"] as string;
    var title = Model.DocumentType == "Invoice" ? "Facture commerciale" : "Reçu commercial";
    var rate = PdfReportService.HistoricalRate(Model.CdfPerUsd, Model.SecondaryCurrencyCode, Model.ExchangeRateToSecondary, Model.CurrencyCode);
    var lines = new CommercialTable(Model.Items.Select(i => new CommercialLine(i.ProductName, i.Quantity, i.UnitPrice, i.EffectiveLineTotal)), Model.CurrencyCode);
}
<!doctype html>
<html lang="fr"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@title @Model.Number | AD Gestion Hub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body>
<div class="print-shell mx-auto p-3 p-md-4">
    <div class="d-flex flex-wrap gap-2 mb-3 no-print">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary-outline">Retour à la vente</a>
        <button type="button" class="btn btn-secondary-outline" onclick="window.print()">Imprimer</button>
        <a asp-action="Receipt" asp-route-id="@Model.Id" asp-route-format="pdf" class="btn btn-accent">Télécharger le PDF</a>
    </div>
    <main class="panel-card print-document p-3 p-md-5">
        <div class="receipt-heading d-flex flex-wrap justify-content-between gap-3 pb-3 mb-3 border-bottom">
            <div><h1 class="h3 mb-1">@title</h1><p class="text-slate mb-1">@Model.Number · @Model.SaleDate.ToString("dd/MM/yyyy")</p><span class="status-pill">@Model.PaymentStatus</span></div>
            <div class="receipt-store">
                @if (logo != null) { <img class="receipt-logo" src="@logo" alt="" /> }
                <div><div class="fw-bold">@settings.StoreName</div><div>@settings.Address</div><div>@settings.Phone</div><div>@settings.ContactEmail</div></div>
            </div>
        </div>
        <p><strong>Client :</strong> @(Model.CustomerName ?? "Client de passage")</p>
        <partial name="_CommercialLines" model="lines" />
        <div class="doc-totals pt-3">
            @if (Model.Discount != 0) { <div><span>Remise</span><b>@Money.Display(Model.Discount, Model.CurrencyCode)</b></div> }
            @if (Model.TaxAmount != 0) { <div><span>Taxe historique</span><b>@Money.Display(Model.TaxAmount, Model.CurrencyCode)</b></div> }
            <div class="total-line"><span>Total</span><b>@Money.Display(Model.FinalPrice, Model.CurrencyCode)</b></div>
            @if (!Model.IsCancelled) { <div><span>Réglé</span><b>@Money.Display(Model.Paid, Model.CurrencyCode)</b></div><div><span>Reste à régler</span><b>@Money.Display(Model.Balance, Model.CurrencyCode)</b></div> }
            @if (rate != null) { <p class="text-slate small mt-2 mb-0">Taux enregistré : @rate</p> }
        </div>
        @if (Model.IsCancelled) { <p class="mt-3">Motif d’annulation : @Model.CancellationReason</p> }
        @if (!string.IsNullOrWhiteSpace(settings.FooterMessage)) { <p class="text-slate mt-4 mb-2">@settings.FooterMessage</p> }
        <footer class="receipt-footer border-top pt-3 mt-3 text-slate small">
            <span>Document commercial ordinaire — non normalisé DGI.</span>
            <strong>Généré par AdGestionHub</strong>
        </footer>
    </main>
</div>
</body></html>
