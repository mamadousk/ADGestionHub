@model AdGestionHub.Models.Sale
@{
    ViewData["Title"] = "Reçu de vente";
    var settings = ViewBag.StoreSettings as AdGestionHub.Models.StoreSettings;
    var items = ViewBag.Items as IEnumerable<AdGestionHub.Models.SaleItem>;
    var finalPrice = ViewBag.FinalPrice as decimal? ?? 0;
    var discount = ViewBag.Discount as decimal? ?? 0;
    var netTotal = ViewBag.NetTotal as decimal? ?? finalPrice;
}

<div class="container py-4">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4 p-lg-5">
            <!-- En-tête -->
            <div class="text-center border-bottom pb-3 mb-4">
                <h2 class="fw-bold" style="color:#FF8C00;">@(settings?.StoreName ?? "AdGestionHub")</h2>
                <p class="text-muted mb-0">@(settings?.Address ?? "")</p>
                <p class="text-muted mb-0"><i class="fas fa-phone me-1"></i> @(settings?.Phone ?? "Non renseigné")</p>
                <p class="text-muted mb-0"><i class="fas fa-envelope me-1"></i> @(settings?.ContactEmail ?? "")</p>
            </div>

            <!-- Infos vente -->
            <div class="row mb-4">
                <div class="col-6">
                    <strong>N° facture :</strong> @Model.Id<br />
                    <strong>Date :</strong> @Model.SaleDate.ToString("dd/MM/yyyy HH:mm")
                </div>
                <div class="col-6 text-end">
                    <strong>Client :</strong> @(Model.CustomerName ?? "Client particulier")
                </div>
            </div>

            <!-- Tableau des articles -->
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead class="bg-light">
                        <tr>
                            <th>Produit</th>
                            <th class="text-center">Qté</th>
                            <th class="text-end">Prix unit.</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (items != null && items.Any())
                        {
                            foreach (var item in items)
                            {
                                <tr>
                                    <td>@(item.ProductName ?? "Produit inconnu")</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">@item.UnitPrice.ToString("C")</td>
                                    <td class="text-end">@(item.Quantity * item.UnitPrice).ToString("C")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center text-muted">Aucun article</td></tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Total TTC :</th>
                            <th class="text-end">@finalPrice.ToString("C")</th>
                        </tr>
                        @if (discount > 0)
                        {
                            <tr>
                                <th colspan="3" class="text-end text-danger">Réduction :</th>
                                <th class="text-end text-danger">-@discount.ToString("C")</th>
                            </tr>
                            <tr>
                                <th colspan="3" class="text-end">Net à payer :</th>
                                <th class="text-end">@netTotal.ToString("C")</th>
                            </tr>
                        }
                    </tfoot>
                </table>
            </div>

            <!-- Pied de page -->
            <div class="text-center text-muted small border-top pt-3 mt-4">
                @if (!string.IsNullOrEmpty(settings?.FooterMessage))
                {
                    <p>@settings.FooterMessage</p>
                }
                else
                {
                    <p>Merci de votre achat. Revenez vite !</p>
                }
                <p class="mb-0">© @DateTime.Now.Year AdGestionHub - Reçu généré automatiquement</p>
            </div>

            <!-- Boutons -->
            <div class="text-center mt-4">
                <button onclick="window.print()" class="btn btn-orange-gradient px-4">
                    <i class="fas fa-print me-2"></i> Imprimer
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Retour</a>
            </div>
        </div>
    </div>
</div>