@model SaleInput
@{
    ViewData["Title"] = "Nouvelle vente";
    var contacts = (IReadOnlyList<ContactPick>)ViewData["TradeContacts"]!;
    var products = (IReadOnlyList<CatalogPick>)ViewData["TradeProducts"]!;
}
<div class="page-heading">
    <div><p class="section-eyebrow">Ventes / Saisie</p><h1>Nouvelle vente</h1><p>Choisissez les articles, puis indiquez ce qui a été encaissé.</p></div>
    <a asp-action="Index" class="btn btn-secondary-outline">Historique des ventes</a>
</div>
@if (products.Count == 0)
{
    <div class="panel-card empty-panel">
        <div class="section-eyebrow">Première étape</div><h2 class="h5">Aucun produit en stock</h2>
        <p class="text-slate">Ajoutez un produit avec une quantité initiale ou réapprovisionnez votre stock.</p>
        @if (User.IsInRole("Admin")) { <a asp-controller="Products" asp-action="Create" class="btn btn-accent">Ajouter un produit</a> }
        else { <a asp-controller="Products" asp-action="Index" class="btn btn-secondary-outline">Voir le catalogue</a> }
    </div>
}
else
{
    <form asp-action="Create" method="post" data-trade>
        <div asp-validation-summary="All" class="validation-banner" role="alert"></div>
        <section class="panel-card p-3 p-md-4 mb-3">
            <h2 class="h6 mb-3">Client et devise</h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="ClientId" class="form-label">Client du répertoire</label>
                    <select asp-for="ClientId" class="form-select">
                        <option value="">Client de passage</option>
                        @foreach (var contact in contacts) { <option value="@contact.Id">@contact.Name</option> }
                    </select>
                    <small class="form-text">Vente à crédit ? <a asp-controller="Clients" asp-action="Create">Ajouter un client</a>.</small>
                </div>
                <div class="col-md-4">
                    <label asp-for="CustomerName" class="form-label">Ou nom du client</label>
                    <input asp-for="CustomerName" class="form-control" placeholder="Facultatif si la vente est réglée" />
                </div>
                <div class="col-md-4"><partial name="_TradeCurrency" model="Model" /></div>
            </div>
        </section>
        <partial name="_TradeLines" model="Model" />
        <section class="panel-card p-3 p-md-4">
            <h2 class="h6">Règlement</h2>
            @if (User.IsInRole("Admin"))
            {
                <div class="row g-3">
                    <div class="col-md-4"><label asp-for="Discount" class="form-label">Remise sur la vente</label><input asp-for="Discount" class="form-control num" inputmode="decimal" data-trade-discount /></div>
                </div>
            }
            <partial name="_InitialPayment" model="Model" />
            <p class="form-text mb-0">Le règlement initial est saisi dans la devise de la vente. Les règlements suivants peuvent être enregistrés en CDF ou USD si le taux est configuré.</p>
            <div class="trade-totals"><div><span>Total de la vente</span><strong class="num" data-trade-total aria-live="polite">—</strong></div><button type="submit" class="btn btn-accent">Enregistrer la vente</button></div>
        </section>
    </form>
}
@section Scripts { <script src="~/js/trade.js" asp-append-version="true"></script> }
