@using AdGestionHub.Models
@model Sale

@{
    var ctx = await TenantCtx.GetContextAsync();
    ViewData["Title"] = L["Nav.NewSale"];
    var canOverridePrice = User.IsInRole("Admin");
    var clients = ViewBag.Clients as List<Client> ?? new List<Client>();
    var paymentMethods = ctx.Country.DefaultPaymentMethods;
    var decimals = ctx.PrimaryCurrency.Decimals;
    var symbol = ctx.PrimaryCurrency.Symbol;
    var isVat = ctx.IsVatEnabled;
    var isFormalized = ctx.IsFormalized;
    var secEnabled = ctx.Settings.SecondaryCurrencyEnabled && ctx.SecondaryCurrency != null;
    var lang = L.CurrentLanguage;
}

<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-1">@(isFormalized ? L.T("Nouvelle facture / Encaissement", "New Invoice / Checkout") : L.T("Nouvelle vente comptoir", "New Counter Sale"))</h1>
        <p class="text-slate small mb-0">
            @L.T("Devise active :", "Active currency:") <strong class="num">@ctx.PrimaryCurrency.Code (@symbol)</strong>
            @if (isVat)
            {
                <span>· @L.T("TVA standard :", "Standard VAT:") <strong class="num">@ctx.DefaultVatRate.ToString("0.##")%</strong></span>
            }
        </p>
    </div>
    <a asp-action="Index" class="btn btn-secondary-outline">@L["Action.Back"]</a>
</div>

<form asp-action="Create" method="post" id="saleForm">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
    <div id="cartClientError" class="alert alert-warning d-none mb-3"></div>

    <div class="row g-4">
        <!-- Zone de saisie gauche -->
        <div class="col-lg-8">
            <div class="panel-card p-4 mb-3">
                <h2 class="h6 mb-3">@L.T("Ajouter un article au panier", "Add Item to Cart")</h2>
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label">@L.T("Produit (nom ou SKU)", "Product (name or SKU)")</label>
                        <input type="text" id="productInput" class="form-control" placeholder="@L.T("Rechercher en stock...", "Search in stock...")" autocomplete="off" />
                        <input type="hidden" id="selectedProductId" />
                        <input type="hidden" id="selectedProductName" />
                        <input type="hidden" id="selectedProductStock" />
                        <input type="hidden" id="selectedProductVat" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">
                            @(isVat ? L.T("P.U. HT", "Unit Excl.") : L["Doc.UnitPrice"]) (@symbol)
                        </label>
                        <input type="number" id="tempPrice" class="form-control num" step="@ctx.NumberInputStep" min="0" readonly="@(!canOverridePrice)" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">@L["Doc.Qty"]</label>
                        <input type="number" id="tempQty" class="form-control num" value="1" min="1" max="100000" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" id="btnAddItem" class="btn btn-accent w-100">
                            @LucideIcons.Svg("plus", 15, "me-1")
                            <span>@L["Action.Add"]</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Panier -->
            <div class="panel-card overflow-hidden">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                    <h2 class="h6 mb-0">@L.T("Lignes de l'opération", "Line Items")</h2>
                    <button type="button" id="btnClearCart" class="btn btn-secondary-outline btn-sm">
                        @L.T("Vider", "Clear")
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-ledger" id="cartTable">
                        <thead>
                            <tr>
                                <th>@L["Doc.Description"]</th>
                                <th class="text-end">@(isVat ? L.T("P.U. HT", "Unit Excl.") : L["Doc.UnitPrice"])</th>
                                <th class="text-center">@L["Doc.Qty"]</th>
                                @if (isVat)
                                {
                                    <th class="text-end">TVA</th>
                                }
                                <th class="text-end">@(isVat ? L.T("Montant HT", "Line Excl.") : L.T("Montant", "Amount"))</th>
                                <th class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody id="cartBody">
                            <tr id="emptyCartRow">
                                <td colspan="@(isVat ? 6 : 5)" class="text-center text-slate py-4">
                                    @L.T("Aucun article dans le panier.", "Cart is currently empty.")
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Colonne droite : Client, Règlement & Récapitulatif -->
        <div class="col-lg-4">
            <div class="panel-card p-4 mb-3">
                <h2 class="h6 mb-3">@L.T("Client & Règlement", "Customer & Payment")</h2>

                @if (clients.Any())
                {
                    <div class="mb-3">
                        <label class="form-label">@L.T("Répertoire client (optionnel)", "Saved customer (optional)")</label>
                        <select name="ClientId" id="clientSelect" class="form-select">
                            <option value="">— @L["Doc.WalkInCustomer"] —</option>
                            @foreach (var cl in clients)
                            {
                                <option value="@cl.Id" data-name="@cl.Name" data-tax="@cl.TaxIdentificationNumber">@cl.Name</option>
                            }
                        </select>
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="CustomerName" class="form-label">@L.T("Nom sur le document", "Customer Name")</label>
                    <input asp-for="CustomerName" id="customerNameInput" class="form-control" maxlength="150" placeholder="@L["Doc.WalkInCustomer"]" />
                </div>

                @if (isFormalized)
                {
                    <div class="mb-3">
                        <label asp-for="CustomerTaxId" class="form-label">@ctx.TaxIdLabel (@L.T("client B2B, optionnel", "B2B client, optional"))</label>
                        <input asp-for="CustomerTaxId" id="customerTaxInput" class="form-control num" maxlength="100" />
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="PaymentMethod" class="form-label">@L["Doc.PaymentMethod"]</label>
                    <select asp-for="PaymentMethod" class="form-select">
                        @foreach (var pm in paymentMethods)
                        {
                            <option value="@pm">@pm</option>
                        }
                    </select>
                </div>

                @if (secEnabled && ctx.SecondaryCurrency != null)
                {
                    <div class="mb-2">
                        <label class="form-label">@L.T("Devise remise en caisse", "Tendered Currency")</label>
                        <select name="PaidInCurrencyCode" class="form-select num">
                            <option value="@ctx.PrimaryCurrency.Code">@ctx.PrimaryCurrency.Code (@ctx.PrimaryCurrency.Symbol)</option>
                            <option value="@ctx.SecondaryCurrency.Code">@ctx.SecondaryCurrency.Code (@ctx.SecondaryCurrency.Symbol)</option>
                        </select>
                    </div>
                }
            </div>

            <!-- Récapitulatif financier -->
            <div class="panel-card p-4">
                <h2 class="h6 mb-3">@L.T("Récapitulatif", "Summary")</h2>

                @if (isVat)
                {
                    <div class="d-flex justify-content-between text-slate small mb-2 num">
                        <span>@L["Doc.SubtotalExclTax"]</span>
                        <span id="sumSubtotal">0</span>
                    </div>
                    <div class="d-flex justify-content-between text-slate small pb-2 mb-2 border-bottom num">
                        <span>@L["Doc.VatAmount"]</span>
                        <span id="sumTax">0</span>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-baseline mb-2 num">
                    <span class="fw-semibold">@(isVat ? L["Doc.TotalInclTax"] : L["Doc.TotalDue"])</span>
                    <span class="h4 fw-bold mb-0 text-forest" id="sumGrandTotal">0</span>
                </div>

                @if (secEnabled && ctx.SecondaryCurrency != null)
                {
                    <div class="d-flex justify-content-between text-slate small mb-3 num pt-2 border-top">
                        <span>@L["Doc.SecondaryEquivalent"] (@ctx.SecondaryCurrency.Code)</span>
                        <span class="fw-medium" id="sumSecondaryTotal">0</span>
                    </div>
                }

                <button type="submit" class="btn btn-accent w-100 py-2 mt-2">
                    @LucideIcons.Svg("check", 16, "me-1")
                    <span>@L["Action.Charge"]</span>
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script>
        (function () {
            "use strict";

            const cart = [];
            const decimals = @decimals;
            const symbol = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(symbol));
            const lang = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(lang));
            const isVat = @(isVat ? "true" : "false");
            const defaultVat = @ctx.DefaultVatRate.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const secEnabled = @(secEnabled ? "true" : "false");
            const secRate = @ctx.Settings.SecondaryExchangeRate.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const secDecimals = @(ctx.SecondaryCurrency?.Decimals ?? 2);
            const secSymbol = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ctx.SecondaryCurrency?.Symbol ?? "$"));

            const errorBox = document.getElementById("cartClientError");

            function fmt(amount, dec, sym) {
                const rounded = dec === 0 ? Math.round(amount) : Number(amount.toFixed(dec));
                const parts = rounded.toFixed(dec).split(".");
                parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, lang === "en" ? "," : " ");
                const numStr = dec > 0 ? parts.join(lang === "en" ? "." : ",") : parts[0];
                if (lang === "en" && (sym === "$" || sym === "£" || sym === "₦")) return sym + numStr;
                return numStr + " " + sym;
            }

            function showClientError(msg) {
                if (!msg) {
                    errorBox.classList.add("d-none");
                    errorBox.textContent = "";
                    return;
                }
                errorBox.textContent = msg;
                errorBox.classList.remove("d-none");
            }

            const clientSelect = document.getElementById("clientSelect");
            if (clientSelect) {
                clientSelect.addEventListener("change", function () {
                    const opt = clientSelect.options[clientSelect.selectedIndex];
                    if (opt && opt.value) {
                        document.getElementById("customerNameInput").value = opt.getAttribute("data-name") || "";
                        const taxInput = document.getElementById("customerTaxInput");
                        if (taxInput) taxInput.value = opt.getAttribute("data-tax") || "";
                    }
                });
            }

            $(function () {
                $("#productInput").autocomplete({
                    source: function (request, response) {
                        $.ajax({
                            url: '@Url.Action("GetProducts", "Sales")',
                            dataType: "json",
                            data: { term: request.term },
                            success: function (data) {
                                response($.map(data, function (item) {
                                    return {
                                        label: item.label,
                                        value: item.name,
                                        id: item.id,
                                        name: item.name,
                                        price: item.price,
                                        vatRate: item.vatRate,
                                        stock: item.stock
                                    };
                                }));
                            }
                        });
                    },
                    minLength: 1,
                    delay: 120,
                    select: function (event, ui) {
                        $("#selectedProductId").val(ui.item.id);
                        $("#selectedProductName").val(ui.item.name);
                        $("#selectedProductStock").val(ui.item.stock);
                        $("#selectedProductVat").val(ui.item.vatRate);
                        $("#tempPrice").val(Number(ui.item.price).toFixed(decimals));
                        $("#tempQty").attr("max", ui.item.stock).val(1).focus();
                        showClientError(null);
                    }
                });
            });

            function renderCart() {
                const tbody = document.getElementById("cartBody");
                tbody.innerHTML = "";

                if (cart.length === 0) {
                    const tr = document.createElement("tr");
                    const td = document.createElement("td");
                    td.colSpan = isVat ? 6 : 5;
                    td.className = "text-center text-slate py-4";
                    td.textContent = '@L.T("Aucun article dans le panier.", "Cart is currently empty.")';
                    tr.appendChild(td);
                    tbody.appendChild(tr);
                }

                let sumNet = 0;
                let sumTax = 0;

                cart.forEach(function (item, idx) {
                    const lineNet = item.price * item.qty;
                    const lineTax = isVat ? (lineNet * item.vatRate / 100.0) : 0;
                    sumNet += lineNet;
                    sumTax += lineTax;

                    const tr = document.createElement("tr");

                    const tdName = document.createElement("td");
                    tdName.className = "fw-medium";
                    tdName.textContent = item.name;

                    const inputId = document.createElement("input");
                    inputId.type = "hidden";
                    inputId.name = `Items[${idx}].ProductId`;
                    inputId.value = String(item.productId);
                    tdName.appendChild(inputId);

                    const inputPrice = document.createElement("input");
                    inputPrice.type = "hidden";
                    inputPrice.name = `Items[${idx}].UnitPrice`;
                    inputPrice.value = item.price.toFixed(decimals);
                    tdName.appendChild(inputPrice);

                    const inputQty = document.createElement("input");
                    inputQty.type = "hidden";
                    inputQty.name = `Items[${idx}].Quantity`;
                    inputQty.value = String(item.qty);
                    tdName.appendChild(inputQty);

                    const tdPrice = document.createElement("td");
                    tdPrice.className = "text-end num";
                    tdPrice.textContent = fmt(item.price, decimals, symbol);

                    const tdQty = document.createElement("td");
                    tdQty.className = "text-center num";
                    tdQty.textContent = String(item.qty);

                    tr.appendChild(tdName);
                    tr.appendChild(tdPrice);
                    tr.appendChild(tdQty);

                    if (isVat) {
                        const tdVat = document.createElement("td");
                        tdVat.className = "text-end num text-slate";
                        tdVat.textContent = item.vatRate + "%";
                        tr.appendChild(tdVat);
                    }

                    const tdSub = document.createElement("td");
                    tdSub.className = "text-end num fw-semibold";
                    tdSub.textContent = fmt(lineNet, decimals, symbol);
                    tr.appendChild(tdSub);

                    const tdAction = document.createElement("td");
                    tdAction.className = "text-end";
                    const removeBtn = document.createElement("button");
                    removeBtn.type = "button";
                    removeBtn.className = "btn btn-danger-outline btn-sm py-0 px-2";
                    removeBtn.textContent = "×";
                    removeBtn.addEventListener("click", function () {
                        cart.splice(idx, 1);
                        renderCart();
                    });
                    tdAction.appendChild(removeBtn);
                    tr.appendChild(tdAction);

                    tbody.appendChild(tr);
                });

                const grandTotal = sumNet + sumTax;
                if (isVat) {
                    document.getElementById("sumSubtotal").textContent = fmt(sumNet, decimals, symbol);
                    document.getElementById("sumTax").textContent = fmt(sumTax, decimals, symbol);
                }
                document.getElementById("sumGrandTotal").textContent = fmt(grandTotal, decimals, symbol);

                if (secEnabled && secRate > 0) {
                    const secVal = grandTotal / secRate;
                    document.getElementById("sumSecondaryTotal").textContent = fmt(secVal, secDecimals, secSymbol);
                }
            }

            document.getElementById("btnAddItem").addEventListener("click", function () {
                const productId = parseInt(document.getElementById("selectedProductId").value, 10);
                const productName = document.getElementById("selectedProductName").value || document.getElementById("productInput").value.trim();
                const maxStock = parseInt(document.getElementById("selectedProductStock").value, 10) || 100000;
                const vatRate = parseFloat(document.getElementById("selectedProductVat").value) || defaultVat;
                const price = parseFloat(String(document.getElementById("tempPrice").value).replace(",", "."));
                const qty = parseInt(document.getElementById("tempQty").value, 10);

                if (!productId || !productName || isNaN(price) || price <= 0 || isNaN(qty) || qty <= 0) {
                    showClientError('@L.T("Sélectionnez un article proposé et vérifiez la quantité.", "Select a suggested item and verify the quantity.")');
                    return;
                }

                const existing = cart.find(c => c.productId === productId && Math.abs(c.price - price) < 0.001);
                const totalQty = cart.filter(c => c.productId === productId).reduce((s, c) => s + c.qty, 0) + qty;

                if (totalQty > maxStock) {
                    showClientError(`@L.T("Stock disponible insuffisant :", "Insufficient available stock:") ${maxStock}`);
                    return;
                }

                if (existing) {
                    existing.qty += qty;
                } else {
                    cart.push({ productId, name: productName, price, qty, vatRate, stock: maxStock });
                }

                showClientError(null);
                renderCart();

                document.getElementById("productInput").value = "";
                document.getElementById("selectedProductId").value = "";
                document.getElementById("selectedProductName").value = "";
                document.getElementById("selectedProductStock").value = "";
                document.getElementById("tempPrice").value = "";
                document.getElementById("tempQty").value = "1";
                document.getElementById("productInput").focus();
            });

            document.getElementById("btnClearCart").addEventListener("click", function () {
                cart.length = 0;
                renderCart();
            });

            document.getElementById("saleForm").addEventListener("submit", function (e) {
                if (cart.length === 0) {
                    e.preventDefault();
                    showClientError('@L.T("Ajoutez au moins un article au panier.", "Add at least one item before completing the sale.")');
                }
            });

            renderCart();
        })();
    </script>
}
