@model BusinessReport
@{
    ViewData["Title"] = "Tableau de bord";
    var admin = User.IsInRole("Admin");
    var permissions = await StaffCtx.CurrentAsync();
    var canViewStock = permissions.Has(StaffPermission.Catalogue);
    var low = Model.Stock.Where(p => p.IsLow).OrderBy(p => p.Quantity).ToList();
    string Format(decimal amount) => Money.Display(amount, Model.Currency);
    var stats = new List<(string Label, string Value, string Icon, string Info, string Tone, string? Currency, string? DetailAmount)>
    {
        ("Chiffre d’affaires", Format(Model.Revenue), "bar-chart-3", "Ventes hors taxes historiques", "indigo", Model.Currency, null),
        ("Total des ventes", Format(Model.Invoiced), "receipt", $"{Model.Sales.Count} vente(s) sur la période", "orange", Model.Currency, null)
    };
    if (admin)
    {
        stats.Add(("Recettes encaissées", Format(Model.Received), "wallet", "Dont ventes :", "green", Model.Currency, Format(Model.SalesReceipts)));
        stats.Add(("Créances clients", Format(Model.Receivables), "clock", "Reste à recevoir à la fin de période", "amber", Model.Currency, null));
        stats.Add(("Dépenses", Format(Model.Expensed), "wallet", "Charges courantes sur la période", "orange", Model.Currency, null));
        var stockCurrency = Model.Settings.PrimaryCurrencyCode;
        stats.Add(("Valeur du stock", Money.Display(Model.StockValue, stockCurrency), "package", $"{Model.StockUnits} unité(s) · coût catalogue actuel", "green", stockCurrency, null));
    }
    else if (canViewStock) { stats.Add(("Stock disponible", $"{Model.StockUnits} unité(s)", "package", $"{low.Count} article(s) sous le seuil", "green", null, null)); }
    if (ViewData["ProfitSummary"] is ProfitSummary profit)
    {
        var info = !profit.HasMissingCosts ? "Après remises, hors taxes et charges"
            : profit.Total.HasValue ? "Total partiel : coûts d’achat manquants" : "Coûts d’achat non historisés";
        stats.Add(("Bénéfice", profit.Total is decimal total ? Format(total) : "—", "bar-chart-3", info, "green", profit.Total.HasValue ? Model.Currency : null, null));
    }
    var trend = Model.Trend();
    var peak = trend.Max(p => p.Total);
}
<div class="page-heading dash-heading">
    <div><p class="section-eyebrow"><span class="tiny-dot"></span> Vue d’ensemble</p><h1>Tableau de bord</h1><p>Voici l’activité de <strong>@Model.Settings.StoreName</strong> sur la période sélectionnée.</p></div>
    <div class="d-flex flex-wrap align-items-end gap-2">
        <button type="button" class="btn btn-secondary-outline dashboard-amount-toggle" data-dashboard-amount-toggle
                aria-label="Masquer les montants" title="Masquer les montants" hidden>
            <span data-dashboard-eye>@LucideIcons.Svg("eye", 18)</span>
            <span data-dashboard-eye-off hidden>@LucideIcons.Svg("eye-off", 18)</span>
        </button>
        @if (permissions.Has(StaffPermission.Sell))
        {
            <a asp-controller="Sales" asp-action="Create" class="btn btn-accent">@LucideIcons.Svg("plus", 17, "me-1") Nouvelle vente</a>
        }
    </div>
</div>
@if (admin && (Model.Stock.Count == 0 || Model.Settings.CdfPerUsd == null))
{
    <div class="dashboard-guide mb-3">
        <div class="guide-icon">@LucideIcons.Svg(Model.Stock.Count == 0 ? "package" : "settings", 21)</div>
        <div><strong>@(Model.Stock.Count == 0 ? "Commencez par votre premier produit" : "Activez les opérations dans les deux devises")</strong><div class="small">@(Model.Stock.Count == 0 ? "Renseignez un prix et un stock initial, puis enregistrez votre première vente." : "Saisissez votre taux manuel dans les paramètres. Les opérations passées garderont leur taux.")</div></div>
        @if (Model.Stock.Count == 0) { <a asp-controller="Products" asp-action="Create" class="btn btn-secondary-outline">Ajouter un produit</a> }
        else { <a asp-controller="Settings" asp-action="Index" class="btn btn-secondary-outline">Configurer le taux</a> }
    </div>
}
<partial name="_PeriodFilter" model="Model" />
<div class="metric-grid mb-4">
    @foreach (var item in stats)
    {
        <article class="panel-card metric-tile">
            <div class="metric-title"><span class="metric-icon @item.Tone">@LucideIcons.Svg(item.Icon, 17)</span><h2>@item.Label</h2></div>
            @if (item.Currency != null)
            {
                <strong class="metric-value num" data-dashboard-amount="@item.Currency">@item.Value</strong>
            }
            else { <strong class="metric-value num">@item.Value</strong> }
            <small>@item.Info
                @if (item.DetailAmount is string detail) { <span data-dashboard-amount="@Model.Currency">@detail</span> }
            </small>
        </article>
    }
</div>
<div class="@(canViewStock ? "dashboard-columns " : "")mb-4">
    <section class="panel-card p-3 p-md-4">
        <div class="d-flex flex-wrap justify-content-between gap-2 align-items-start"><div><h2 class="h6 mb-1">Évolution des ventes</h2><p class="text-slate small">Montants des ventes par intervalle · @Model.Currency</p></div><span class="status-pill">@Model.Period.Start.ToString("dd/MM") – @Model.Period.End.ToString("dd/MM")</span></div>
        @if (peak <= 0)
        {
            <div class="chart-empty"><div class="metric-icon indigo">@LucideIcons.Svg("bar-chart-3", 23)</div><strong>Aucun montant vendu sur cette période</strong><small>Le graphique se met à jour après vos ventes.</small></div>
        }
        else
        {
            <div class="trend-chart" style="--columns:@trend.Count" role="region" tabindex="0" aria-label="Graphique de l’évolution des ventes">
                @foreach (var point in trend)
                {
                    var height = (100m * point.Total / peak).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
                    <div class="trend-slot" title="@point.Label : @Format(point.Total)" data-dashboard-tooltip="@point.Label : •••• @Model.Currency"><div class="trend-track"><div class="trend-fill" style="height:@(height)%"></div></div><small>@point.Label</small><span class="visually-hidden" data-dashboard-amount="@Model.Currency">@Format(point.Total)</span></div>
                }
            </div>
            <details class="mt-2 small">
                <summary class="fw-semibold">Voir les montants du graphique</summary>
                <table class="table table-ledger trend-values mb-0 mt-2">
                    <thead><tr><th scope="col">Début de l’intervalle</th><th scope="col" class="text-end">Total des ventes</th></tr></thead>
                    <tbody>
                        @foreach (var point in trend)
                        {
                            <tr><th scope="row">@point.Label</th><td class="text-end num" data-dashboard-amount="@Model.Currency">@Format(point.Total)</td></tr>
                        }
                    </tbody>
                </table>
            </details>
        }
    </section>
    @if (canViewStock)
    {
        <section class="panel-card p-3 p-md-4">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-2"><div><h2 class="h6 mb-1">Alertes stock</h2><p class="text-slate small">Quantités actuelles, hors filtre de période</p></div><span class="status-pill @(low.Count > 0 ? "warning" : "success")">@low.Count</span></div>
            @if (low.Count == 0) { <p class="text-slate small mb-3">Aucun article sous son seuil d’alerte.</p> }
            @foreach (var product in low.Take(5))
            {
                <div class="quick-line"><a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">@product.Name</a><span class="status-pill @(product.Quantity == 0 ? "danger" : "warning") num">@product.Quantity en stock</span></div>
            }
            <a asp-controller="Products" asp-action="Index" asp-route-status="low" class="btn btn-secondary-outline btn-sm mt-3">Voir le stock</a>
        </section>
    }
</div>
@if (permissions.Has(StaffPermission.SalesHistory))
{
    <section class="panel-card mb-2">
        <div class="p-3 p-md-4 d-flex flex-wrap justify-content-between gap-2 align-items-center"><div><h2 class="h6 mb-1">Dernières ventes de la période</h2><p class="text-slate small mb-0">Ventes enregistrées en @Model.Currency</p></div><a asp-controller="Sales" asp-action="Index" class="btn btn-secondary-outline btn-sm">Toutes les ventes</a></div>
        @if (Model.Sales.Count == 0) { <p class="text-slate px-3 px-md-4 pb-4 mb-0">Aucune vente à afficher.</p> }
        else
        {
            <div class="table-responsive"><table class="table table-ledger"><thead><tr><th scope="col">Vente</th><th scope="col">Client</th><th scope="col" class="text-end">Total</th></tr></thead><tbody>
                @foreach (var sale in Model.Sales.Take(5))
                { <tr><td><a asp-controller="Sales" asp-action="Details" asp-route-id="@sale.Id" class="fw-semibold">@sale.Number</a><div class="text-slate small">@sale.SaleDate.ToString("dd/MM/yyyy")</div></td><td>@(sale.CustomerName ?? "Client de passage")</td><td class="text-end text-nowrap" data-dashboard-amount="@Model.Currency">@Format(sale.FinalPrice)</td></tr> }
            </tbody></table></div>
        }
    </section>
}
@section Scripts {
    <script src="~/js/dashboard-amounts.js" asp-append-version="true"></script>
}
