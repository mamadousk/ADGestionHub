<figure class="marketing-preview">
    <div class="marketing-device-scene">
        <svg class="marketing-commerce-vectors" viewBox="0 0 640 480" preserveAspectRatio="none" fill="none" aria-hidden="true" focusable="false">
            <defs>
                <linearGradient id="commerce-trace-ink" x1="0%" y1="100%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#d37c54" />
                    <stop offset="53%" stop-color="#9781cb" />
                    <stop offset="100%" stop-color="#7457be" />
                </linearGradient>
                <path id="commerce-trace" pathLength="100" d="M-30 418C67 489 184 453 281 408S435 318 484 229 561 100 671 79" />
            </defs>
            <path class="marketing-vector-orbit" d="M-26 386C75 470 212 442 311 390S471 298 529 184 581 116 667 109" />
            <path class="marketing-vector-orbit marketing-vector-orbit--dotted" d="M-24 441C79 507 206 476 323 418S472 301 522 218 582 142 659 125" />
            <path class="marketing-vector-orbit marketing-vector-orbit--dotted" d="M-18 76C131 5 259 41 361 66S532 101 656 39" />
            <use class="marketing-vector-rail" href="#commerce-trace" />
            <use class="marketing-vector-flow" href="#commerce-trace" />
            <circle class="marketing-vector-halo" cx="87" cy="451" r="12" />
            <circle class="marketing-vector-halo marketing-vector-halo--late" cx="610" cy="97" r="12" />
            <circle class="marketing-vector-node" cx="87" cy="451" r="4" />
            <circle class="marketing-vector-node" cx="610" cy="97" r="4" />
            <circle class="marketing-vector-node" cx="525" cy="59" r="3" />
            <circle class="marketing-vector-node" cx="47" cy="416" r="3" />
        </svg>
        <span class="marketing-vector-badge marketing-vector-badge--report" aria-hidden="true">@LucideIcons.Svg("bar-chart-3", 22)</span>
        <span class="marketing-vector-badge marketing-vector-badge--payment" aria-hidden="true">@LucideIcons.Svg("wallet", 22)</span>
        <div class="marketing-scene-head" aria-hidden="true">
            <span class="marketing-scene-label"><span class="tiny-dot"></span> Le logiciel en aperçu</span>
            <span class="marketing-scene-chip marketing-scene-sale">@LucideIcons.Svg("shopping-bag", 15) Vente suivie</span>
        </div>

        <a class="marketing-desktop-device" href="@Url.Content("~/images/demo/tableau-de-bord.webp")" target="_blank" rel="noopener" aria-label="Agrandir la vue ordinateur (nouvel onglet)">
            <span class="marketing-desktop-frame">
                <span class="marketing-desktop-chrome" aria-hidden="true"><i></i><i></i><i></i></span>
                <img src="~/images/demo/tableau-de-bord.webp" asp-append-version="true" width="1160" height="860"
                     alt="Tableau de bord de Comptoir Démo sur ordinateur : ventes, recettes encaissées, créances et alertes de stock."
                     fetchpriority="high" decoding="async" />
            </span>
            <span class="marketing-monitor-stand" aria-hidden="true"></span>
        </a>
        <a class="marketing-phone-device" href="@Url.Content("~/images/demo/tableau-de-bord-mobile.webp")" target="_blank" rel="noopener" aria-label="Agrandir la vue iPhone 18 Pro Max (nouvel onglet)">
            <span class="marketing-phone-display">
                <img src="~/images/demo/tableau-de-bord-mobile.webp" asp-append-version="true" width="824" height="1710"
                     alt="Maquette du tableau de bord sur iPhone 18 Pro Max : 244 000 CDF de ventes, 214 000 CDF encaissés et 30 000 CDF à recevoir."
                     decoding="async" />
                <span class="marketing-phone-island" aria-hidden="true"></span>
                <span class="marketing-phone-home" aria-hidden="true"></span>
            </span>
        </a>
        <span class="marketing-scene-chip marketing-scene-stock" aria-hidden="true">@LucideIcons.Svg("package", 16) Stock à jour</span>
    </div>
    <figcaption>Aperçus illustrés · Données fictives</figcaption>
</figure>
