@{
    ViewData["Title"] = L.T("Plateforme de gestion commerciale", "Retail & SMB Management Platform");
    Layout = "_Layout";
}

<section class="py-5 hero-shell">
    <div class="container position-relative">
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <span class="status-pill info mb-3">AdGestionHub v2.0</span>
                <h1 class="display-5 fw-bold mb-3 hero-gradient-text" style="letter-spacing:-0.03em; line-height:1.15;">
                    @L.T(
                        "Encaissement, stocks et gestion fiscale structurée pour votre commerce",
                        "Structured point-of-sale, inventory, and fiscal compliance for your business")
                </h1>
                <p class="text-slate mb-4 mx-auto" style="max-width: 620px; font-size: 1rem;">
                    @L.T(
                        "Conçu pour s'adapter automatiquement à votre pays, votre devise (CDF, FCFA, KES, NGN, USD) et votre régime fiscal, sans complexité superflue.",
                        "Automatically adapts to your country, local currency (CDF, XOF, XAF, KES, NGN, USD), and tax regime without unnecessary friction.")
                </p>
                <div class="d-flex justify-content-center flex-wrap gap-2">
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-accent px-4 py-2">
                        @L.T("Créer un compte établissement", "Create business account")
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-secondary-outline px-4 py-2">
                        @L["Nav.Login"]
                    </a>
                </div>
            </div>
        </div>

        <!-- Offres -->
        <div class="row justify-content-center g-4 mb-5">
            <div class="col-md-6 col-lg-5">
                <div class="panel-card p-4 h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-semibold">@L.T("Édition Standard", "Standard Edition")</span>
                        <span class="status-pill success">@L.T("Accès immédiat", "Available now")</span>
                    </div>
                    <div class="h3 fw-semibold num my-2">@L.T("Gratuit", "Free")</div>
                    <p class="text-slate small mb-3">
                        @L.T("Pour boutiques indépendantes et PME en croissance.", "For independent retail stores and growing SMBs.")
                    </p>
                    <ul class="list-unstyled small text-slate mb-4 flex-grow-1 d-flex flex-column gap-2 border-top pt-3">
                        <li class="d-flex align-items-center gap-2">@LucideIcons.Svg("check", 15, "text-forest") <span>@L.T("Caisse rapide, reçus thermiques 58mm & factures A4", "Fast POS, 58mm thermal receipts & A4 invoices")</span></li>
                        <li class="d-flex align-items-center gap-2">@LucideIcons.Svg("check", 15, "text-forest") <span>@L.T("Multi-devises, bi-monétarisme & TVA paramétrable", "Multi-currency, dual-currency & configurable VAT")</span></li>
                        <li class="d-flex align-items-center gap-2">@LucideIcons.Svg("check", 15, "text-forest") <span>@L.T("Gestion des stocks atomique, dépenses & créances clients", "Atomic stock control, expenses & customer receivables")</span></li>
                        <li class="d-flex align-items-center gap-2">@LucideIcons.Svg("check", 15, "text-forest") <span>@L.T("Comptes vendeurs cloisonnés (marges confidentielles)", "Role-based staff accounts (protected cost margins)")</span></li>
                    </ul>
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-accent w-100">
                        @L.T("Démarrer gratuitement", "Start for free")
                    </a>
                </div>
            </div>

            <div class="col-md-6 col-lg-5">
                <div class="panel-card p-4 h-100 d-flex flex-column" style="background: var(--bg-canvas) !important;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-semibold">@L.T("Édition Multi-Sites", "Multi-Branch Edition")</span>
                        <span class="status-pill warning">@L.T("Prochainement", "Coming soon")</span>
                    </div>
                    <div class="h3 fw-semibold my-2">Pro</div>
                    <p class="text-slate small mb-3">
                        @L.T("Consolidation multi-points de vente et intégrations comptables.", "Multi-store consolidation and accounting exports.")
                    </p>
                    <ul class="list-unstyled small text-slate mb-4 flex-grow-1 d-flex flex-column gap-2 border-top pt-3">
                        <li class="d-flex align-items-center gap-2">@LucideIcons.Svg("building-2", 15) <span>@L.T("Supervision centralisée de plusieurs établissements", "Centralized multi-branch supervision")</span></li>
                        <li class="d-flex align-items-center gap-2">@LucideIcons.Svg("file-text", 15) <span>@L["Status.EInvoicingTitle"]</span></li>
                        <li class="d-flex align-items-center gap-2">@LucideIcons.Svg("bar-chart-3", 15) <span>@L.T("Exports comptables analytiques", "Analytical accounting exports")</span></li>
                    </ul>

                    <form id="waitingListForm" class="mt-auto" onsubmit="sendToWaitingList(event)">
                        @Html.AntiForgeryToken()
                        <div class="d-flex gap-2">
                            <input type="email" id="waitingEmail" class="form-control" placeholder="contact@entreprise.com" required />
                            <button type="submit" id="waitingSubmitBtn" class="btn btn-secondary-outline text-nowrap">
                                @L.T("M'inscrire", "Notify me")
                            </button>
                        </div>
                        <small id="waitingListFeedback" class="text-slate mt-2 d-block">
                            @L.T("Recevoir une notification lors de l'ouverture du plan Pro.", "Get notified when Multi-Branch launches.")
                        </small>
                    </form>
                </div>
            </div>
        </div>

        <!-- Piliers fonctionnels -->
        <div class="row g-3">
            <div class="col-md-4">
                <div class="panel-card p-4 h-100">
                    <div class="mb-2 text-slate">@LucideIcons.Svg("globe", 20)</div>
                    <h2 class="h6 mb-1">@L.T("Localisation automatique", "Automatic Localization")</h2>
                    <p class="text-slate small mb-0">
                        @L.T("Devises sans centimes (XOF/XAF) ou décimales (CDF/USD/KES), indicatifs téléphoniques et identifiants légaux par pays.", "Zero-decimal (XOF/XAF) or two-decimal (CDF/USD/KES) formatting, dial codes, and country-specific legal IDs.")
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="panel-card p-4 h-100">
                    <div class="mb-2 text-slate">@LucideIcons.Svg("receipt", 20)</div>
                    <h2 class="h6 mb-1">@L.T("Isolation historique stricte", "Strict Historical Isolation")</h2>
                    <p class="text-slate small mb-0">
                        @L.T("Tout changement de devise, de TVA ou de statut formalisé s'applique uniquement aux nouvelles opérations sans altérer vos archives.", "Currency, VAT, or formalization changes apply strictly to future operations without altering historical records.")
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="panel-card p-4 h-100">
                    <div class="icon-tile emerald mb-3">@LucideIcons.Svg("shield", 22)</div>
                    <h2 class="h6 mb-1">@L.T("Contrôle interne & Audit", "Internal Control & Audit")</h2>
                    <p class="text-slate small mb-0">
                        @L.T("Numérotation séquentielle sans rupture, journal d'audit horodaté et séparation stricte propriétaire / vendeurs.", "Gap-free sequential numbering, timestamped audit logs, and strict owner vs. cashier role separation.")
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function sendToWaitingList(e) {
            e.preventDefault();
            const form = document.getElementById('waitingListForm');
            const emailInput = document.getElementById('waitingEmail');
            const btn = document.getElementById('waitingSubmitBtn');
            const feedback = document.getElementById('waitingListFeedback');
            const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
            if (!emailInput.value || !tokenInput) return;

            btn.disabled = true;
            fetch('/Marketing/JoinWaitingList', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({
                    email: emailInput.value.trim(),
                    __RequestVerificationToken: tokenInput.value
                })
            })
            .then(r => {
                if (r.ok) {
                    feedback.className = 'text-forest small mt-2 d-block';
                    feedback.textContent = '@L.T("Inscription enregistrée.", "Request registered.")';
                    emailInput.value = '';
                } else {
                    feedback.className = 'text-sober-red small mt-2 d-block';
                    feedback.textContent = '@L.T("Adresse email invalide.", "Invalid email address.")';
                }
            })
            .catch(() => {
                feedback.className = 'text-sober-red small mt-2 d-block';
                feedback.textContent = '@L.T("Erreur réseau.", "Network error.")';
            })
            .finally(() => { btn.disabled = false; });
        }
    </script>
}
