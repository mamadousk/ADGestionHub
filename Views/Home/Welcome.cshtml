@{ ViewData["Title"] = "Gestion commerciale en RDC"; }
<div class="container welcome-surface py-4 py-lg-5">
    <section class="welcome-hero">
        <div class="welcome-copy">
            <span class="welcome-kicker"><span class="tiny-dot"></span> Gestion commerciale · RDC</span>
            <h1>Pilotez votre activité.<br /><span>Maîtrisez vos chiffres.</span></h1>
            <p>Ventes, stocks, achats et règlements : gérez votre commerce au même endroit et voyez ce qui reste à encaisser, en CDF ou en USD.</p>
            <div class="d-flex flex-wrap gap-2"><a asp-area="Identity" asp-page="/Account/Register" class="btn btn-accent">Créer mon entreprise @LucideIcons.Svg("arrow-right", 17, "ms-2")</a><a asp-area="Identity" asp-page="/Account/Login" class="btn btn-secondary-outline">Se connecter</a></div>
            <div class="welcome-footnote">@LucideIcons.Svg("check", 16, "me-1") Accessible sur téléphone et ordinateur</div>
        </div>
        <div class="welcome-preview" aria-label="Exemple de tableau de bord">
            <div class="preview-top"><span class="brand-mark">A</span><div><strong>Tableau de bord</strong><small>Boutique exemple</small></div><span class="status-pill ms-auto">CDF</span></div>
            <div class="preview-metrics">
                <div><small>Ventes du mois</small><b class="num">1 245 000 CDF</b></div>
                <div><small>Recettes encaissées</small><b class="num">970 000 CDF</b></div>
            </div>
            <div class="preview-chart"><div class="d-flex justify-content-between gap-2"><strong>Évolution des ventes</strong><small>Exemple</small></div>
                <svg viewBox="0 0 360 105" role="img" aria-label="Courbe illustrative des ventes">
                    <defs><linearGradient id="previewGradient" x1="0" x2="0" y1="0" y2="1" gradientUnits="objectBoundingBox"><stop offset="0%" stop-color="#ff6539" stop-opacity=".25"/><stop offset="100%" stop-color="#ff6539" stop-opacity="0"/></linearGradient></defs>
                    <path d="M4 93 H356 M4 60 H356 M4 27 H356" fill="none" stroke="#e8eaf2" stroke-dasharray="4 4" />
                    <path d="M4 90 C40 91 52 70 79 75 S111 52 145 56 S175 81 211 53 S242 65 269 43 S309 53 356 13 V103 H4 Z" fill="url(#previewGradient)"/>
                    <path d="M4 90 C40 91 52 70 79 75 S111 52 145 56 S175 81 211 53 S242 65 269 43 S309 53 356 13" fill="none" stroke="#e8552e" stroke-width="3" stroke-linecap="round"/>
                    <circle cx="356" cy="13" r="4" fill="#e8552e"/>
                </svg>
            </div>
            <div class="preview-bottom"><span>@LucideIcons.Svg("package", 16) Suivi du stock</span><span class="status-pill warning">2 alertes</span></div>
        </div>
    </section>
    <section class="welcome-features" aria-label="Fonctionnalités principales">
        <article class="panel-card"><span class="metric-icon orange">@LucideIcons.Svg("shopping-bag", 21)</span><h2>Vendez au quotidien</h2><p>Enregistrez une vente à plusieurs articles et imprimez sa facture commerciale.</p></article>
        <article class="panel-card"><span class="metric-icon indigo">@LucideIcons.Svg("package", 21)</span><h2>Gardez le stock à jour</h2><p>Suivez les quantités, les livraisons fournisseurs et les articles à réapprovisionner.</p></article>
        <article class="panel-card"><span class="metric-icon green">@LucideIcons.Svg("wallet", 21)</span><h2>Sachez ce qui est payé</h2><p>Retrouvez les règlements partiels, les créances et les dettes, sans mélanger les devises.</p></article>
    </section>
    <p class="text-slate small mb-0 mt-4">Les factures émises sont des documents commerciaux ordinaires, non normalisés par la DGI.</p>
</div>
