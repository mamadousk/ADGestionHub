@{
    ViewData["Title"] = L.T("Politique de Confidentialité", "Privacy Policy");
}

<div class="container py-4" style="max-width: 820px;">
    <div class="panel-card p-4">
        <h1 class="h4 mb-2">@ViewData["Title"]</h1>
        <p class="text-slate small mb-0">
            @L.T("Consultez notre politique complète de protection des données.", "View our complete data protection policy.")
            <a asp-controller="Infos" asp-action="Confidentialite" class="ms-1" style="color: var(--accent);">@L.T("Ouvrir", "Open")</a>
        </p>
    </div>
</div>
