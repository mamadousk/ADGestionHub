@model IEnumerable<AdGestionHub.Models.UserFeedback>
@{
    ViewData["Title"] = "Marketing & Feedback";
    var waitingList = (ViewBag.WaitingList as IEnumerable<AdGestionHub.Models.WaitingListPro>)?.ToList()
                      ?? new List<AdGestionHub.Models.WaitingListPro>();
    var feedbacks = Model?.ToList() ?? new List<AdGestionHub.Models.UserFeedback>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h4 mb-1">@L.T("Suivi des inscriptions Pro & avis", "Pro Signups & User Feedback")</h1>
        <p class="text-slate small mb-0 num">@waitingList.Count @L.T("lead(s)", "lead(s)") · @feedbacks.Count @L.T("avis", "review(s)")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportLeads" class="btn btn-accent">
            @LucideIcons.Svg("download", 15, "me-1")
            <span>@L.T("Exporter CSV", "Export CSV")</span>
        </a>
        <a asp-controller="SuperAdmin" asp-action="Index" class="btn btn-secondary-outline">@L["Action.Back"]</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="panel-card p-4 h-100">
            <h2 class="h6 mb-3">@L.T("Liste d'attente Pro", "Pro Waiting List")</h2>
            @if (waitingList.Any())
            {
                foreach (var lead in waitingList)
                {
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="small fw-medium">@lead.Email</span>
                        <span class="text-slate small num">@lead.DateInscription.ToString("dd/MM/yyyy")</span>
                    </div>
                }
            }
            else
            {
                <p class="text-slate small mb-0">@L.T("Aucune inscription enregistrée.", "No leads recorded yet.")</p>
            }
        </div>
    </div>

    <div class="col-lg-7">
        <div class="panel-card overflow-hidden h-100">
            <div class="p-3 border-bottom">
                <h2 class="h6 mb-0">@L.T("Retours utilisateurs", "User Feedback")</h2>
            </div>
            <div class="table-responsive">
                <table class="table table-ledger">
                    <thead>
                        <tr>
                            <th>@L.T("Utilisateur", "User")</th>
                            <th>@L.T("Note", "Score")</th>
                            <th>@L.T("Commentaire", "Comment")</th>
                            <th class="text-end">@L["Doc.Date"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!feedbacks.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-slate py-5">@L.T("Aucun avis enregistré.", "No feedback recorded.")</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in feedbacks)
                            {
                                <tr>
                                    <td class="fw-medium">@item.UserName</td>
                                    <td><span class="status-pill num">@Math.Clamp(item.Note, 1, 5) / 5</span></td>
                                    <td class="small">@item.Commentaire</td>
                                    <td class="text-end text-slate small num">@item.DateEnvoi.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
