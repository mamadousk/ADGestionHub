@model TradeInput
@{
    var count = Math.Max(1, Math.Min(Model.Items.Count, CommerceOperations.MaxLines));
}
<div class="pos-fallback">
    <noscript><p class="form-text">Activez JavaScript pour la caisse rapide. Les montants sont calculés côté serveur dans la devise choisie.</p></noscript>
    <div class="trade-lines" data-trade-lines>
        @for (var index = 0; index < count; index++)
        {
            <partial name="_TradeLine" model="@(new TradeLineRow(Model.Items.ElementAtOrDefault(index) ?? new TradeLineInput(), index))" />
        }
    </div>
</div>
