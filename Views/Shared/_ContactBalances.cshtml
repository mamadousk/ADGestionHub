@model IReadOnlyList<DocumentBalance>
<section class="panel-card mb-3">
    <div class="p-3 p-md-4">
        <h2 class="h6 mb-2">Solde par devise</h2>
        <div class="d-flex gap-2 flex-wrap">
            @if (Model.Count == 0) { <span class="text-slate small">Aucun solde.</span> }
            @foreach (var currency in Model.GroupBy(d => d.Currency).OrderBy(g => g.Key))
            { <span class="status-pill num">@Money.Display(currency.Sum(d => d.Balance), currency.Key)</span> }
        </div>
    </div>
</section>
<section class="panel-card mb-3"><h2 class="h6 p-3 p-md-4 mb-0">Historique des opérations</h2><partial name="_BalanceTable" model="Model" /></section>
