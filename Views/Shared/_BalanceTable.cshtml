@model IReadOnlyList<DocumentBalance>
@{
    var salesHistory = (await StaffCtx.CurrentAsync()).Has(StaffPermission.SalesHistory);
    var admin = User.IsInRole("Admin");
    var authors = ViewData["OperationAuthors"] as IReadOnlyDictionary<string, OperationAuthor>;
}
@if (Model.Count == 0)
{
    <p class="text-slate px-3 px-md-4 pb-3 mb-0">Aucune opération à afficher.</p>
}
else
{
    <div class="table-responsive"><table class="table table-ledger">
        <thead><tr><th scope="col">Document</th><th scope="col">Contact</th><th scope="col" class="text-end">Total</th><th scope="col" class="text-end">Réglé</th><th scope="col" class="text-end">Solde</th></tr></thead>
        <tbody>
        @foreach (var row in Model)
        {
            var controller = row.Kind == "Sale" ? "Sales" : "Debts";
            var canOpen = row.Kind == "Sale" ? salesHistory : row.Kind == "Debt" && admin;
            <tr><td>@if (!canOpen) { <strong>@row.Number</strong> }
                else { <a class="fw-semibold" asp-controller="@controller" asp-action="Details" asp-route-id="@row.Id">@row.Number</a> }<div class="text-slate small">@row.Date.ToString("dd/MM/yyyy")</div>
                <partial name="_OperationAuthor" model="@(authors?.GetValueOrDefault(row.CreatedByUserId ?? string.Empty))" /></td>
                <td>@row.Contact</td><td class="text-end text-nowrap">@Money.Display(row.Total, row.Currency)</td><td class="text-end text-nowrap">@Money.Display(row.Paid, row.Currency)</td><td class="text-end text-nowrap fw-semibold">@Money.Display(row.Balance, row.Currency)</td></tr>
        }
        </tbody>
    </table></div>
}
