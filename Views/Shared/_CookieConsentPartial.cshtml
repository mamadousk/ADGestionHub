@using Microsoft.AspNetCore.Http.Features
@{
    var consentFeature = Context.Features.Get<ITrackingConsentFeature>();
    var showBanner = !consentFeature?.CanTrack ?? false;
    var cookieString = consentFeature?.CreateConsentCookie();
}

@if (showBanner)
{
    <div id="cookieConsent" class="alert alert-dismissible fade show fixed-bottom mb-0 rounded-0 border-top" style="background: #0F172A; color: #FFFFFF; border-color: #1E293B !important; z-index: 1080; padding: 0.85rem 0;">
        <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2">
            <span class="small" style="color: #CBD5E1;">
                @L.T("Nous utilisons uniquement des cookies techniques essentiels au fonctionnement et à la sécurité de la session.", "We use strictly necessary technical cookies for session security and localization.")
                <a asp-controller="Infos" asp-action="Cookies" class="text-white text-decoration-underline ms-1">@L.T("Détails", "Details")</a>
            </span>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-sm btn-outline-light" data-bs-dismiss="alert" data-cookie-string="@cookieString">
                    @L.T("Fermer", "Close")
                </button>
                <button type="button" class="btn btn-sm btn-accent" data-bs-dismiss="alert" data-cookie-string="@cookieString">
                    @L.T("Accepter", "Accept")
                </button>
            </div>
        </div>
    </div>
    <script>
        (function () {
            document.querySelectorAll("#cookieConsent button[data-cookie-string]").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    document.cookie = btn.getAttribute("data-cookie-string");
                });
            });
        })();
    </script>
}
