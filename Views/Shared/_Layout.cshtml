@using Microsoft.EntityFrameworkCore
@inject AdGestionHub.Data.ApplicationDbContext _context

@{
    AdGestionHub.Models.GlobalNotification? activeNotification = null;
    try
    {
        activeNotification = _context.GlobalNotifications
            .AsNoTracking()
            .OrderByDescending(n => n.CreatedAt)
            .FirstOrDefault(n => n.ExpiryDate > DateTime.Now && n.IsActive);
    }
    catch { }

    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isSuperAdmin = User.IsInRole("SuperAdmin");
    var isAdmin = User.IsInRole("Admin");
    var publicShell = !isAuthenticated || ViewData["PublicShell"] is true;
    var marketing = ViewData["Marketing"] is true;

    TenantFiscalContext? fiscalCtx = null;
    if (!publicShell && !isSuperAdmin)
    {
        try { fiscalCtx = await TenantCtx.GetContextAsync(); } catch { }
    }

    var lang = L.CurrentLanguage;
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — AD Gestion Hub</title>

    @if (ViewData["MetaDescription"] is string description) { <meta name="description" content="@description" /> }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (activeNotification != null)
    {
        <div class="alert @(activeNotification.IsCritical ? "alert-danger" : "alert-warning") mb-0 rounded-0 border-0 border-bottom text-center py-2 px-3">
            @LucideIcons.Svg("bell", 16, "me-2")
            <span>@activeNotification.Message</span>
        </div>
    }

    @if (!publicShell)
    {
        <div class="sidebar-backdrop" onclick="document.body.classList.remove('sidebar-open')"></div>

        <div class="app-shell">
            <!-- Navigation latérale sobre -->
            <aside class="app-sidebar">
                <a class="sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="d-flex align-items-center"><span class="brand-mark">A</span>AD Gestion Hub</span>
                </a>

                @if (fiscalCtx != null)
                {
                    <div class="sidebar-store-meta">
                        <div class="sidebar-store-name">@fiscalCtx.Settings.StoreName</div>
                        <div class="sidebar-store-sub num">
                            @fiscalCtx.PrimaryCurrency.Code · RD Congo
                        </div>
                    </div>
                }

                <nav class="sidebar-nav">
                    @if (isSuperAdmin)
                    {
                        <div class="sidebar-section-label">@L["Nav.SystemConsole"]</div>
                        <a class="sidebar-link @(ctrl == "SuperAdmin" && act == "Index" ? "active" : "")" asp-area="" asp-controller="SuperAdmin" asp-action="Index">
                            @LucideIcons.Svg("layout-dashboard", 17)
                            <span>@L.T("Vue d'ensemble", "Overview")</span>
                        </a>
                        <a class="sidebar-link @(ctrl == "Marketing" ? "active" : "")" asp-area="" asp-controller="Marketing" asp-action="AdminDashboard">
                            @LucideIcons.Svg("bar-chart-3", 17)
                            <span>@L.T("Leads & Feedback", "Leads & Feedback")</span>
                        </a>
                        <a class="sidebar-link @(ctrl == "SuperAdmin" && act == "ManageNotifications" ? "active" : "")" asp-area="" asp-controller="SuperAdmin" asp-action="ManageNotifications">
                            @LucideIcons.Svg("bell", 17)
                            <span>@L.T("Annonces globales", "Global Notices")</span>
                        </a>
                        <a class="sidebar-link @(ctrl == "SuperAdmin" && act == "Logs" ? "active" : "")" asp-area="" asp-controller="SuperAdmin" asp-action="Logs">
                            @LucideIcons.Svg("alert-circle", 17)
                            <span>@L.T("Journal d'erreurs", "Error Logs")</span>
                        </a>
                    }
                    else
                    {
                        <div class="sidebar-section-label">@L.T("Opérations", "Operations")</div>
                        <a class="sidebar-link @(ctrl == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">
                            @LucideIcons.Svg("layout-dashboard", 17)
                            <span>@L["Nav.Dashboard"]</span>
                        </a>
                        <a class="sidebar-link @(ctrl == "Sales" && act == "Create" ? "active" : "")" asp-area="" asp-controller="Sales" asp-action="Create">
                            @LucideIcons.Svg("shopping-bag", 17)
                            <span>Nouvelle vente</span>
                        </a>
                        <a class="sidebar-link @(ctrl == "Sales" && act != "Create" ? "active" : "")" asp-area="" asp-controller="Sales" asp-action="Index">
                            @LucideIcons.Svg("receipt", 17)
                            <span>Ventes et factures</span>
                        </a>
                        <a class="sidebar-link @(ctrl == "Products" ? "active" : "")" asp-area="" asp-controller="Products" asp-action="Index">
                            @LucideIcons.Svg("package", 17)
                            <span>@L["Nav.Products"]</span>
                        </a>
                        <a class="sidebar-link @(ctrl == "Clients" ? "active" : "")" asp-area="" asp-controller="Clients" asp-action="Index">
                            @LucideIcons.Svg("users", 17)
                            <span>@L["Nav.Clients"]</span>
                        </a>
                        <div class="sidebar-section-label mt-2">Trésorerie</div>
                        <a class="sidebar-link @(ctrl == "Expenses" ? "active" : "")" asp-area="" asp-controller="Expenses" asp-action="Index">
                            @LucideIcons.Svg("wallet", 17)
                            <span>@L["Nav.Expenses"]</span>
                        </a>

                        @if (isAdmin)
                        {
                            <a class="sidebar-link @(ctrl == "Payments" ? "active" : "")" asp-area="" asp-controller="Payments" asp-action="Index">
                                @LucideIcons.Svg("wallet", 17)
                                <span>Encaissements et règlements</span>
                            </a>
                            <a class="sidebar-link @(ctrl == "Debts" ? "active" : "")" asp-area="" asp-controller="Debts" asp-action="Index">
                                @LucideIcons.Svg("clock", 17)
                                <span>Créances clients</span>
                            </a>
                            <div class="sidebar-section-label mt-2">Pilotage</div>
                            <a class="sidebar-link @(ctrl == "Reports" ? "active" : "")" asp-area="" asp-controller="Reports" asp-action="Index">
                                @LucideIcons.Svg("bar-chart-3", 17)
                                <span>@L["Nav.Reports"]</span>
                            </a>
                            <a class="sidebar-link @(ctrl == "Users" ? "active" : "")" asp-area="" asp-controller="Users" asp-action="Index">
                                @LucideIcons.Svg("user-check", 17)
                                <span>@L["Nav.Staff"]</span>
                            </a>
                            <a class="sidebar-link @(ctrl == "Settings" ? "active" : "")" asp-area="" asp-controller="Settings" asp-action="Index">
                                @LucideIcons.Svg("settings", 17)
                                <span>@L["Nav.Settings"]</span>
                            </a>
                        }
                    }
                </nav>

                <div class="sidebar-footer d-flex justify-content-between align-items-center">
                    <span>AD Gestion Hub</span>
                    <button type="button" class="btn btn-link p-0 text-decoration-none text-slate" style="font-size:0.75rem;" data-bs-toggle="modal" data-bs-target="#feedbackModal">
                        @L["Nav.Feedback"]
                    </button>
                </div>
            </aside>

            <!-- Zone principale -->
            <div class="app-main-wrap">
                <header class="app-topbar no-print">
                    <div class="d-flex align-items-center gap-3">
                        <button type="button" class="btn btn-secondary-outline d-lg-none py-1 px-2" onclick="document.body.classList.toggle('sidebar-open')" aria-label="Menu">
                            @LucideIcons.Svg("menu", 18)
                        </button>
                        <span class="fw-bold" style="font-size:0.98rem; letter-spacing:-0.02em;">@ViewData["Title"]</span>
                        @if (!isSuperAdmin)
                        {
                            <form method="get" asp-area="" asp-controller="Products" asp-action="Index" class="topbar-search d-none d-md-flex" role="search">
                                @LucideIcons.Svg("search", 15)
                                <input type="text" name="search" placeholder="@L.T("Rechercher un produit...", "Search a product...")" aria-label="@L.T("Rechercher", "Search")" />
                            </form>
                        }
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        @if (fiscalCtx != null)
                        {
                            <div class="d-none d-md-flex align-items-center gap-2">
                                <span class="status-pill info num">
                                    @fiscalCtx.PrimaryCurrency.Code
                                    @if (fiscalCtx.SecondaryCurrency != null)
                                    {
                                        <span>/ @fiscalCtx.SecondaryCurrency.Code</span>
                                    }
                                </span>
                            </div>
                        }

                        @{
                            var userName = User.Identity?.Name ?? "User";
                            var shortUser = userName.Split('@')[0];
                            var initials = string.Join("", shortUser.Split(new[] { '.', '_', '-', ' ' }, StringSplitOptions.RemoveEmptyEntries).Select(p => p.Length > 0 ? char.ToUpperInvariant(p[0]) : '\0').Where(c => c != '\0').Take(2));
                            if (string.IsNullOrEmpty(initials)) { initials = shortUser.Length > 0 ? char.ToUpperInvariant(shortUser[0]).ToString() : "U"; }
                        }
                        <div class="dropdown">
                            <button class="btn btn-secondary-outline py-1 px-2 dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                <span class="avatar-circle">@initials</span>
                                <span class="topbar-account-name fw-semibold d-none d-sm-inline-block text-truncate">@shortUser</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end border shadow-sm mt-1" style="font-size:0.85rem;">
                                <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">@L["Nav.Profile"]</a></li>
                                @if (isAdmin)
                                {
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Settings" asp-action="Index">@L["Nav.MyStore"]</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="m-0">
                                        <button type="submit" class="dropdown-item text-sober-red">@L["Nav.Logout"]</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <main class="app-content">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success d-flex align-items-center justify-content-between mb-3 py-2 px-3" role="alert">
                            <div class="d-flex align-items-center gap-2">
                                @LucideIcons.Svg("check", 16)
                                <span>@TempData["SuccessMessage"]</span>
                            </div>
                            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center justify-content-between mb-3 py-2 px-3" role="alert">
                            <div class="d-flex align-items-center gap-2">
                                @LucideIcons.Svg("alert-circle", 16)
                                <span>@TempData["ErrorMessage"]</span>
                            </div>
                            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @RenderBody()
                </main>
                <footer class="app-footer no-print">
                    <a asp-area="" asp-controller="Infos" asp-action="MentionsLegales">Mentions légales</a>
                    <a asp-area="" asp-controller="Infos" asp-action="Confidentialite">Confidentialité</a>
                </footer>
            </div>
        </div>
    }
    else
    {
        <header class="public-topbar">
            <div class="container public-nav">
                <a class="sidebar-brand border-0 px-0 public-brand" asp-area="" asp-controller="Home" asp-action="@(isAuthenticated ? "Index" : "Welcome")">
                    <span class="d-flex align-items-center"><span class="brand-mark" aria-hidden="true">A</span>AD Gestion Hub</span>
                </a>
                @if (marketing)
                {
                    <nav class="public-nav-links" aria-label="Découvrir le produit">
                        <a href="#fonctionnalites">Fonctionnalités</a>
                        <a href="#demarrage">Bien démarrer</a>
                        <a href="#faq">Questions fréquentes</a>
                    </nav>
                }
                <div class="d-flex flex-wrap align-items-center gap-2">
                    @if (isAuthenticated)
                    {
                        if (ViewData["AccountFlow"] is not true)
                        {
                            <a class="btn btn-accent" asp-area="" asp-controller="Home" asp-action="Index">Mon espace</a>
                        }
                        <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-secondary-outline">Se déconnecter</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-secondary-outline" asp-area="Identity" asp-page="/Account/Login">Se connecter</a>
                        <a class="btn btn-accent" asp-area="Identity" asp-page="/Account/Register">Créer un compte</a>
                    }
                </div>
            </div>
        </header>

        <main class="@(marketing ? "marketing-main" : "py-4")" id="contenu">
            <div class="container">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success mb-3">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger mb-3">@TempData["ErrorMessage"]</div>
                }
                @RenderBody()
            </div>
        </main>

        <footer class="public-footer @(marketing ? "" : "mt-5")">
            <div class="container">
                <div class="row g-4">
                    <div class="col-md-5">
                        <div class="fw-semibold text-dark mb-2">AD Gestion Hub</div>
                        <p class="mb-2">
                            @L.T(
                                "Gestion commerciale, stocks et trésorerie pour les commerçants et PME en RDC.",
                                "Commercial management, stock and cash flow for businesses in the DRC.")
                        </p>
                        <span class="status-pill">@LegalPublication.Publisher</span>
                    </div>
                    <div class="col-md-4">
                        <div class="fw-semibold text-dark mb-2">@L.T("Informations légales", "Legal")</div>
                        <div class="d-flex flex-column gap-1">
                            <a asp-area="" asp-controller="Infos" asp-action="Confidentialite">@L.T("Politique de confidentialité", "Privacy Policy")</a>
                            <a asp-area="" asp-controller="Infos" asp-action="CGU">@L.T("Conditions générales d'utilisation", "Terms of Service")</a>
                            <a asp-area="" asp-controller="Infos" asp-action="MentionsLegales">@L.T("Mentions légales", "Legal Notice")</a>
                            <a asp-area="" asp-controller="Infos" asp-action="Cookies">@L.T("Politique de cookies", "Cookie Policy")</a>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="fw-semibold text-dark mb-2">Contact</div>
                        <div class="mb-1">@LegalPublication.Address</div>
                        <a href="mailto:@LegalPublication.Email">@LegalPublication.Email</a><br />
                        @if (ViewData["AccountFlow"] is not true)
                        {
                            <button type="button" class="btn btn-secondary-outline btn-sm mt-2" data-bs-toggle="modal" data-bs-target="#feedbackModal">
                                @L["Nav.Feedback"]
                            </button>
                        }
                    </div>
                </div>
                <div class="border-top mt-4 pt-3 small">
                    <span>&copy; @DateTime.Now.Year AD Gestion Hub — @LegalPublication.Publisher</span>
                </div>
            </div>
        </footer>
    }

    <!-- Modale Feedback sobre (sans emojis) -->
    <div class="modal fade" id="feedbackModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border">
                <div class="modal-header border-bottom py-3 px-4">
                    <h6 class="modal-title fw-semibold mb-0">@L["Nav.Feedback"]</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form id="globalFeedbackForm" asp-area="" asp-controller="Marketing" asp-action="SubmitFeedback" method="post">
                    <div class="modal-body p-4">
                        <div id="feedbackFormAlert" class="d-none" role="alert"></div>
                        <div class="mb-3">
                            <label class="form-label">@L.T("Évaluation", "Rating")</label>
                            <select name="note" class="form-select num">
                                <option value="5">5 / 5 — @L.T("Excellent", "Excellent")</option>
                                <option value="4">4 / 5 — @L.T("Très bien", "Very good")</option>
                                <option value="3">3 / 5 — @L.T("Satisfaisant", "Satisfactory")</option>
                                <option value="2">2 / 5 — @L.T("À améliorer", "Needs improvement")</option>
                                <option value="1">1 / 5 — @L.T("Insuffisant", "Poor")</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label">@L.T("Commentaire", "Comment")</label>
                            <textarea name="commentaire" class="form-control" rows="3" maxlength="2000" placeholder="@L.T("Vos retours ou besoins métier...", "Share your feedback or feature requests...")" required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top py-2 px-4">
                        <button type="button" class="btn btn-secondary-outline" data-bs-dismiss="modal">@L["Action.Cancel"]</button>
                        <button type="submit" class="btn btn-accent">@L["Action.Save"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
