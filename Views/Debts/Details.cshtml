@model Debt
@{ ViewData["Title"] = "Créance historique"; }
<div class="page-heading"><div><p class="section-eyebrow"><a asp-action="Index">Créances et dettes</a></p><h1>Créance historique @("#" + Model.Id)</h1><p>@Model.ClientName · @Model.DateCreated.ToString("dd/MM/yyyy")</p></div></div>
<section class="panel-card p-3 p-md-4 mb-3">
    <h2 class="h6 mb-2">Montant dû</h2><p class="num">@Money.Display(Model.Amount, Model.CurrencyCode) · Reste : <strong>@Money.Display(Model.Balance, Model.CurrencyCode)</strong></p>
    @if (Model.DueDate is DateTime due) { <p class="text-slate">Échéance : @due.ToString("dd/MM/yyyy")</p> }
    @if (Model.Note != null) { <p class="mb-0">@Model.Note</p> }
    @if (Model.IsArchived || Model.IsPaid) { <small class="text-slate">État repris de la version précédente.</small> }
</section>
@if (!Model.IsArchived && Model.Balance > 0) { <partial name="_Settle" model="@(new NewPaymentForm("Debt", Model.Id, Model.CurrencyCode, Model.Balance))" /> }
<section class="panel-card p-3 p-md-4"><h2 class="h6 mb-3">Historique des règlements V1</h2><partial name="_PaymentHistory" model="Model.Payments" /></section>
