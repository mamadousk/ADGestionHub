@model AdGestionHub.Models.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = L.T("Modifier l'utilisateur", "Edit Staff Account");
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="panel-card p-4">
            <h1 class="h5 mb-1">@ViewData["Title"] — @Model.UserName</h1>
            <p class="text-slate small mb-4">@L.T("Mettez à jour les informations ou réinitialisez le mot de passe.", "Update account information or reset password.")</p>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="UserName" class="form-label">@L.T("Identifiant", "Username")</label>
                        <input asp-for="UserName" class="form-control" />
                        <span asp-validation-for="UserName" class="text-sober-red small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label">@L.T("Nom complet", "Full Name")</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-sober-red small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-sober-red small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label">@L.T("Rôle", "Role")</label>
                        <select asp-for="Role" class="form-select" asp-items="@(new SelectList(ViewBag.Roles))"></select>
                        <span asp-validation-for="Role" class="text-sober-red small"></span>
                    </div>
                </div>

                <div class="border-top pt-3 mb-4">
                    <div class="fw-semibold small mb-2">@L.T("Réinitialiser le mot de passe (optionnel)", "Reset Password (optional)")</div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="NewPassword" class="form-label">@L.T("Nouveau mot de passe", "New password")</label>
                            <input asp-for="NewPassword" class="form-control" />
                            <span asp-validation-for="NewPassword" class="text-sober-red small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmNewPassword" class="form-label">@L.T("Confirmer", "Confirm")</label>
                            <input asp-for="ConfirmNewPassword" class="form-control" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-sober-red small"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-secondary-outline">@L["Action.Cancel"]</a>
                    <button type="submit" class="btn btn-accent">@L["Action.Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
