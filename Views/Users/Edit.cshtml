@model EditUserViewModel
@{
    ViewData["Title"] = "Modifier les accès";
}
<div class="staff-page">
    <div class="page-heading staff-heading">
        <div><p class="section-eyebrow"><span class="tiny-dot" aria-hidden="true"></span> Équipe et accès</p><h1>Modifier les accès</h1><p>@Model.UserName · Les nouveaux accès s’appliquent à la prochaine requête, sans nouvelle connexion.</p></div>
        <a asp-action="Index" class="btn btn-secondary-outline">@LucideIcons.Svg("arrow-left", 17, "me-1") Retour à l’équipe</a>
    </div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="validation-banner" role="alert"></div>
        <div class="staff-editor-grid">
            <section class="panel-card staff-editor-panel staff-identity" aria-labelledby="staff-account-title">
                <div class="staff-section-heading">
                    <span class="staff-symbol">@LucideIcons.Svg("user-check", 21)</span>
                    <div><p class="section-eyebrow">01 · Compte</p><h2 id="staff-account-title">Informations du compte</h2></div>
                </div>
                <div class="staff-fields"><partial name="_AccountFields" model="Model" /></div>
                <details class="staff-password-fields">
                    <summary>Réinitialiser le mot de passe</summary>
                    <div class="staff-fields mt-3">
                        <div><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="text-sober-red small"></span></div>
                        <div><label asp-for="ConfirmNewPassword" class="form-label"></label><input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmNewPassword" class="text-sober-red small"></span></div>
                    </div>
                </details>
            </section>
            <partial name="_AccessEditor" model="Model" />
        </div>
        <div class="staff-form-actions">
            <a asp-action="Index" class="btn btn-secondary-outline">Annuler</a>
            <button type="submit" class="btn btn-accent">@LucideIcons.Svg("check", 17, "me-1") Enregistrer les accès</button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/staff-access.js" asp-append-version="true"></script>
}
