@model IReadOnlyList<UserViewModel>
@{
    ViewData["Title"] = "Équipe et accès";
}
<div class="staff-page">
    <div class="page-heading staff-heading">
        <div><p class="section-eyebrow"><span class="tiny-dot" aria-hidden="true"></span> Administration</p><h1>Équipe et accès</h1><p>Choisissez ce que chaque collaborateur peut faire et consulter.</p></div>
        <a asp-action="Create" class="btn btn-accent">@LucideIcons.Svg("plus", 17, "me-1") Nouvel employé</a>
    </div>
    @if (Model.Count == 0)
    {
        <div class="panel-card empty-panel">
            <span class="staff-symbol">@LucideIcons.Svg("users", 23)</span>
            <h2 class="h5 mt-3">Aucun employé pour le moment</h2>
            <p class="text-slate mb-0">Créez un compte individuel. Le profil Caisse uniquement est proposé par défaut.</p>
        </div>
    }
    else
    {
        <div class="staff-directory">
            @foreach (var user in Model)
            {
                var features = StaffAccessRules.Features.Where(feature => user.Permissions.Has(feature.Permission)).ToList();
                <article class="panel-card staff-member">
                    <header>
                        <span class="staff-symbol">@LucideIcons.Svg("user-check", 20)</span>
                        <div><h2><a asp-action="History" asp-route-id="@user.Id">@(user.FullName ?? user.UserName)</a></h2><p>@(user.FullName != null ? $"{user.UserName} · " : "")@user.Email</p></div>
                    </header>
                    <div class="staff-member-permissions">
                        <span class="status-pill info">@StaffAccessRules.ProfileName(user.Permissions)</span>
                        @if (features.Count > 0)
                        {
                            <ul class="staff-tags" aria-label="Fonctionnalités autorisées">
                                @foreach (var feature in features) { <li>@feature.Name</li> }
                            </ul>
                        }
                    </div>
                    <footer>
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-secondary-outline">@LucideIcons.Svg("edit-3", 16, "me-1") Modifier les accès</a>
                        <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-danger-outline" aria-label="Supprimer le compte de @user.UserName">@LucideIcons.Svg("trash-2", 16)</a>
                    </footer>
                </article>
            }
        </div>
    }
</div>
