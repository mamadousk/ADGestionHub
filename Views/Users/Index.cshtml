@model IEnumerable<AdGestionHub.Models.ViewModels.UserViewModel>
@{
    ViewData["Title"] = "Gestion des employés";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-6 fw-bold mb-0"><i class="fas fa-users me-2 text-primary"></i> Employés</h1>
        <p class="text-muted mb-0">Gérez les comptes vendeurs rattachés à votre boutique</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-gradient mt-2 mt-md-0">
        <i class="fas fa-plus-circle me-1"></i> Ajouter un employé
    </a>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-modern mb-0">
                <thead>
                    <tr>
                        <th>Identifiant</th>
                        <th>Nom complet</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fas fa-users-slash fa-2x d-block mb-2"></i>
                                Aucun employé enregistré pour cette boutique.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td><strong>@user.UserName</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(user.FullName) ? "—" : user.FullName)</td>
                                <td>@user.Email</td>
                                <td><span class="badge-status info">@user.Role</span></td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-soft me-1" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-soft text-danger" title="Supprimer">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
