@model IEnumerable<AdGestionHub.Models.ViewModels.UserViewModel>
@{
    ViewData["Title"] = L["Nav.Users"];
    var list = Model?.ToList() ?? new List<AdGestionHub.Models.ViewModels.UserViewModel>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h4 mb-1">@L["Nav.Users"]</h1>
        <p class="text-slate small mb-0">@L.T("Gérez les accès vendeurs et collaborateurs rattachés à votre établissement", "Manage cashier and staff accounts assigned to your business")</p>
    </div>
    <a asp-action="Create" class="btn btn-accent">
        @LucideIcons.Svg("plus", 16, "me-1")
        <span>@L.T("Nouvel utilisateur", "New user")</span>
    </a>
</div>

<div class="panel-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-ledger">
            <thead>
                <tr>
                    <th>@L.T("Identifiant", "Username")</th>
                    <th>@L.T("Nom complet", "Full Name")</th>
                    <th>Email</th>
                    <th>@L.T("Rôle", "Role")</th>
                    <th class="text-end">@L.T("Actions", "Actions")</th>
                </tr>
            </thead>
            <tbody>
                @if (!list.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-slate py-5">@L.T("Aucun employé enregistré.", "No staff members registered.")</td>
                    </tr>
                }
                else
                {
                    foreach (var user in list)
                    {
                        <tr>
                            <td class="fw-medium">@user.UserName</td>
                            <td>@(string.IsNullOrWhiteSpace(user.FullName) ? "—" : user.FullName)</td>
                            <td class="text-slate">@user.Email</td>
                            <td><span class="status-pill info">@user.Role</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-secondary-outline btn-sm py-1 px-2">
                                    @LucideIcons.Svg("edit-3", 15)
                                </a>
                                <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-danger-outline btn-sm py-1 px-2">
                                    @LucideIcons.Svg("trash-2", 15)
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
