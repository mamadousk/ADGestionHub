@model IEnumerable<AdGestionHub.Models.ViewModels.UserViewModel>
@{
    ViewData["Title"] = "Gestion des employés";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-users me-2 text-primary"></i> Employés</h1>
    <a asp-action="Create" class="btn btn-primary-gradient">
        <i class="fas fa-plus-circle me-1"></i> Ajouter un employé
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th>Nom d'utilisateur</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                <i class="fas fa-users-slash fa-2x d-block mb-2"></i>
                                Aucun employé trouvé.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td><strong>@user.UserName</strong></td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="badge bg-@(user.Role == "Admin" ? "warning" : "info") rounded-pill px-3 py-2">
                                        @user.Role
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary btn-sm me-1">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-outline-danger btn-sm">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-fermeture des alertes après 5 secondes
        setTimeout(function() {
            $('.alert').alert('close');
        }, 5000);
    </script>
}