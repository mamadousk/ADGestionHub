@model AdGestionHub.Models.ViewModels.UserViewModel
@{
    ViewData["Title"] = L.T("Supprimer l'utilisateur", "Remove Staff Account");
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="panel-card p-4">
            <h1 class="h5 mb-2">@ViewData["Title"]</h1>
            <p class="text-slate small mb-3">
                @L.T("Confirmez-vous la révocation définitive du compte suivant ?", "Confirm permanent removal of the following account?")
            </p>
            <div class="p-3 rounded border mb-4" style="background: var(--bg-canvas);">
                <div class="fw-semibold">@Model.UserName</div>
                <div class="text-slate small">@Model.Email · @StaffAccessRules.ProfileName(Model.Permissions)</div>
            </div>
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary-outline">@L["Action.Cancel"]</a>
                <form asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger-outline">@L["Action.Delete"]</button>
                </form>
            </div>
        </div>
    </div>
</div>
