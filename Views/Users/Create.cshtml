@model CreateUserViewModel
@{
    ViewData["Title"] = "Nouvel employé";
}
<div class="staff-page">
    <div class="page-heading staff-heading">
        <div><p class="section-eyebrow"><span class="tiny-dot" aria-hidden="true"></span> Équipe et accès</p><h1>Nouvel employé</h1><p>Créez le compte, puis choisissez ce que l’employé pourra faire et voir.</p></div>
        <a asp-action="Index" class="btn btn-secondary-outline">@LucideIcons.Svg("arrow-left", 17, "me-1") Retour à l’équipe</a>
    </div>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="validation-banner" role="alert"></div>
        <div class="staff-editor-grid">
            <section class="panel-card staff-editor-panel staff-identity" aria-labelledby="staff-account-title">
                <div class="staff-section-heading">
                    <span class="staff-symbol">@LucideIcons.Svg("user-check", 21)</span>
                    <div><p class="section-eyebrow">01 · Compte</p><h2 id="staff-account-title">Informations du compte</h2></div>
                </div>
                <div class="staff-fields"><partial name="_AccountFields" model="Model" /></div>
                <div class="staff-fields staff-password-fields">
                    <div><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-sober-red small"></span></div>
                    <div><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-sober-red small"></span></div>
                </div>
                <p class="staff-account-note"><span class="status-pill info">Employé</span><span>Un compte est personnel. Donnez à chaque collaborateur son propre identifiant.</span></p>
            </section>
            <partial name="_AccessEditor" model="Model" />
        </div>
        <div class="staff-form-actions">
            <a asp-action="Index" class="btn btn-secondary-outline">Annuler</a>
            <button type="submit" class="btn btn-accent">@LucideIcons.Svg("check", 17, "me-1") Créer le compte</button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/staff-access.js" asp-append-version="true"></script>
}
