@{
    ViewData["Title"] = L.T("Politique de Confidentialité", "Privacy Policy");
}

<div class="container py-5" style="max-width: 820px;">
    <div class="panel-card p-4 p-lg-5">
        <h1 class="h3 fw-bold mb-1">@ViewData["Title"]</h1>
        <p class="text-slate small mb-4 num">@L.T("Mise à jour :", "Updated:") @DateTime.UtcNow.ToString("dd/MM/yyyy")</p>

        <h2 class="h6 fw-semibold mt-4">1. @L.T("Données collectées", "Collected Data")</h2>
        <p class="text-slate small">
            @L.T(
                "Nous traitons exclusivement les données nécessaires à l'exploitation de votre établissement : coordonnées professionnelles, catalogue, opérations commerciales et journaux de sécurité.",
                "We process strictly the data required to operate your business: company details, catalog, commercial transactions, and security logs.")
        </p>

        <h2 class="h6 fw-semibold mt-4">2. @L.T("Absence de revente", "Zero Third-Party Resale")</h2>
        <p class="text-slate small">
            @L.T(
                "Aucune donnée commerciale ou client n'est vendue, cédée ou exploitée à des fins publicitaires.",
                "No commercial or customer data is ever sold, shared, or used for advertising purposes.")
        </p>

        <h2 class="h6 fw-semibold mt-4">3. @L.T("Vos droits", "Your Rights")</h2>
        <p class="text-slate small mb-0">
            @L.T(
                "Vous disposez d'un droit d'accès, de rectification, d'exportation et d'effacement de vos données depuis votre espace compte ou en écrivant à privacy@adhil-digital.com.",
                "You may access, rectify, export, or delete your personal data from your account settings or by contacting privacy@adhil-digital.com.")
        </p>
    </div>
</div>
