@{
    ViewData["Title"] = L.T("Conditions Générales d'Utilisation", "Terms of Service");
}

<div class="container py-5" style="max-width: 820px;">
    <div class="panel-card p-4 p-lg-5">
        <h1 class="h3 fw-bold mb-1">@ViewData["Title"]</h1>
        <p class="text-slate small mb-4 num">@L.T("Mise à jour :", "Updated:") @DateTime.UtcNow.ToString("dd/MM/yyyy")</p>

        <h2 class="h6 fw-semibold mt-4">1. @L.T("Objet du service", "Scope of Service")</h2>
        <p class="text-slate small">
            @L.T(
                "AdGestionHub est une plateforme SaaS de gestion commerciale, de caisse multi-devises, de stock et de facturation adaptée aux réglementations nationales.",
                "AdGestionHub is a SaaS platform for commercial operations, multi-currency POS, inventory management, and localized invoicing.")
        </p>

        <h2 class="h6 fw-semibold mt-4">2. @L.T("Cloisonnement et propriété des données", "Tenant Isolation & Data Ownership")</h2>
        <p class="text-slate small">
            @L.T(
                "Chaque établissement dispose d'un espace strictement cloisonné. Les écritures comptables et pièces émises conservent intégralement les devises, taux et paramètres fiscaux en vigueur au moment de leur création.",
                "Each business operates in an isolated workspace. Accounting entries and issued documents permanently retain the currencies, rates, and tax parameters active at creation time.")
        </p>

        <h2 class="h6 fw-semibold mt-4">3. @L.T("Sécurité & Responsabilités", "Security & Responsibilities")</h2>
        <p class="text-slate small mb-0">
            @L.T(
                "L'utilisateur demeure responsable de l'exactitude des identifiants légaux et taux de taxe renseignés dans son espace Paramètres.",
                "Users remain responsible for the accuracy of legal identifiers and tax rates configured in their Settings.")
        </p>
    </div>
</div>
