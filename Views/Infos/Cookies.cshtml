@{
    ViewData["Title"] = L.T("Politique de Cookies", "Cookie Policy");
}

<div class="container py-5" style="max-width: 820px;">
    <div class="panel-card p-4 p-lg-5">
        <h1 class="h3 fw-bold mb-1">@ViewData["Title"]</h1>
        <p class="text-slate small mb-4">
            @L.T("AdGestionHub utilise exclusivement des cookies techniques strictement nécessaires.", "AdGestionHub uses strictly necessary technical cookies only.")
        </p>

        <div class="table-responsive">
            <table class="table table-ledger">
                <thead>
                    <tr>
                        <th>Cookie</th>
                        <th>@L.T("Finalité", "Purpose")</th>
                        <th>@L.T("Durée", "Duration")</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-medium">.AspNetCore.Identity /Antiforgery</td>
                        <td class="text-slate small">@L.T("Authentification sécurisée et protection CSRF", "Secure authentication and CSRF protection")</td>
                        <td class="text-slate small">Session</td>
                    </tr>
                    <tr>
                        <td class="fw-medium">.AspNetCore.Culture</td>
                        <td class="text-slate small">@L.T("Mémorisation de la langue d'interface (FR / EN)", "Interface language preference (FR / EN)")</td>
                        <td class="text-slate small num">12 @L.T("mois", "months")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
