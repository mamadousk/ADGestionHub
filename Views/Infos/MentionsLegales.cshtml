@{
    ViewData["Title"] = L.T("Mentions Légales", "Legal Notice");
}

<div class="container py-5" style="max-width: 820px;">
    <div class="panel-card p-4 p-lg-5">
        <h1 class="h3 fw-bold mb-1">@ViewData["Title"]</h1>
        <p class="text-slate small mb-4 num">@L.T("Mise à jour :", "Updated:") @DateTime.UtcNow.ToString("dd/MM/yyyy")</p>

        <h2 class="h6 fw-semibold mt-4">1. @L.T("Éditeur", "Publisher")</h2>
        <p class="text-slate small">
            <strong>AdGestionHub</strong> — @L.T("édité par Adhil Digital.", "published by Adhil Digital.")<br />
            Contact : <a href="mailto:contact@adhil-digital.com" class="text-decoration-none" style="color: var(--accent);">contact@adhil-digital.com</a>
        </p>

        <h2 class="h6 fw-semibold mt-4">2. @L.T("Hébergement & Sécurité", "Hosting & Security")</h2>
        <p class="text-slate small">
            @L.T(
                "Infrastructure cloud sécurisée avec chiffrement TLS, journalisation d'audit et sauvegardes isolées.",
                "Secure cloud infrastructure with TLS encryption, audit logging, and isolated backups.")
        </p>

        <h2 class="h6 fw-semibold mt-4">3. @L.T("Propriété intellectuelle", "Intellectual Property")</h2>
        <p class="text-slate small mb-0">
            @L.T(
                "L'ensemble du logiciel, du code source et de l'interface graphique demeure la propriété exclusive d'Adhil Digital.",
                "All software, source code, and interface components remain the exclusive property of Adhil Digital.")
        </p>
    </div>
</div>
