@model IReadOnlyList<Payment>
@{ ViewData["Title"] = "Mouvements financiers"; }
<div class="page-heading">
    <div><p class="section-eyebrow">Trésorerie</p><h1>Mouvements financiers</h1><p>Chaque règlement est affiché à la date et dans la devise du versement.</p></div>
    <div class="d-flex flex-wrap gap-2"><a asp-controller="Expenses" asp-action="Index" class="btn btn-secondary-outline">Voir les dépenses</a><a asp-action="Create" class="btn btn-accent">Nouvel encaissement</a></div>
</div>
@if (Model.Count == 0)
{
    <div class="panel-card empty-panel"><h2 class="h5">Aucun règlement enregistré</h2><p class="text-slate mb-0">Les règlements des clients et les autres recettes apparaîtront ici.</p></div>
}
else
{
    <div class="panel-card table-responsive"><table class="table table-ledger"><thead><tr><th scope="col">Date</th><th scope="col">Mouvement</th><th scope="col">Moyen</th><th scope="col" class="text-end">Montant versé</th></tr></thead><tbody>
        @foreach (var payment in Model)
        {
            <tr><td class="text-nowrap">@payment.RecordedAt.ToString("dd/MM/yyyy HH:mm")</td><td>
                @if (payment.PurchaseId.HasValue) { <strong>Règlement fournisseur archivé</strong> }
                else if (payment.SaleId is int saleId) { <a asp-controller="Sales" asp-action="Details" asp-route-id="@saleId">Règlement client</a> }
                else if (payment.DebtId is int debtId) { <a asp-controller="Debts" asp-action="Details" asp-route-id="@debtId">Créance manuelle</a> }
                else { <strong>Recette diverse</strong> }
                @if (payment.Description != null) { <div class="text-slate small">@payment.Description</div> }
            </td><td>@PaymentMeans.Display(payment.Method) @if (payment.CdfPerUsd is decimal rate) { <div class="small text-slate">@Money.RateLabel(rate)</div> }</td>
            <td class="text-end text-nowrap fw-semibold @(payment.PurchaseId.HasValue ? "text-sober-red" : "text-forest")">@(payment.PurchaseId.HasValue ? "−" : "+") @Money.Display(payment.Amount, payment.CurrencyCode)</td></tr>
        }
    </tbody></table></div>
}
