@model AdGestionHub.Models.Expense
@{
    var ctx = await TenantCtx.GetContextAsync();
    ViewData["Title"] = L.T("Supprimer la dépense", "Delete Expense");
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="panel-card p-4">
            <h1 class="h5 mb-2">@ViewData["Title"]</h1>
            <p class="text-slate small mb-3">@L.T("Confirmez-vous la suppression de cette écriture de dépense ?", "Are you sure you want to delete this expense entry?")</p>
            <div class="p-3 rounded border mb-4" style="background: var(--bg-canvas);">
                <div class="fw-semibold">@Model.Description</div>
                <div class="num text-sober-red fw-semibold">@ctx.FormatHistorical(Model.Amount, Model.CurrencyCode, Model.CurrencyDecimals, Model.CurrencySymbol)</div>
                <div class="text-slate small num">@Model.Category · @ctx.FormatDateTime(Model.Date)</div>
            </div>
            <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-secondary-outline">@L["Action.Cancel"]</a>
                <button type="submit" class="btn btn-danger-outline">@L["Action.Delete"]</button>
            </form>
        </div>
    </div>
</div>
