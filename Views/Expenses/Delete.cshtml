@model AdGestionHub.Models.Expense

@{
    ViewData["Title"] = "Supprimer la Dépense";
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-danger text-white py-3 px-4 fw-bold">
                <i class="fas fa-exclamation-triangle me-2"></i> Supprimer cette dépense ?
            </div>
            <div class="card-body p-4">
                <p class="mb-3">Confirmez-vous la suppression définitive de l'opération suivante ?</p>
                <div class="alert alert-light border">
                    <strong>@Model.Description</strong> — <span class="text-danger fw-bold">@Model.Amount.ToString("N2") $</span><br />
                    <small class="text-muted">@Model.Category · @Model.Date.ToString("dd/MM/yyyy HH:mm")</small>
                </div>

                <form asp-action="Delete" method="post" class="d-flex justify-content-between mt-4">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-soft">Annuler</a>
                    <button type="submit" class="btn btn-danger px-4"><i class="fas fa-trash me-2"></i>Supprimer</button>
                </form>
            </div>
        </div>
    </div>
</div>
