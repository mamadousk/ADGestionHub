@model AdGestionHub.Models.Expense
@{
    var ctx = await TenantCtx.GetContextAsync();
    ViewData["Title"] = L.T("Nouvelle dépense", "New Expense");
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="panel-card p-4">
            <h1 class="h5 mb-3">@ViewData["Title"]</h1>

            <form asp-action="Create" method="post" id="expenseForm">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">@L["Doc.Description"] *</label>
                    <input asp-for="Description" class="form-control" required />
                    <span asp-validation-for="Description" class="text-sober-red small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Amount" class="form-label">@L.T("Montant", "Amount") (@ctx.PrimaryCurrency.Symbol) *</label>
                        <input asp-for="Amount" type="number" step="@ctx.NumberInputStep" min="0" class="form-control num" required />
                        <span asp-validation-for="Amount" class="text-sober-red small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">@L.T("Catégorie", "Category")</label>
                        <select id="categorySelect" name="Category" class="form-select">
                            <option value="Loyer">@L.T("Loyer", "Rent")</option>
                            <option value="Salaire">@L.T("Salaire", "Payroll")</option>
                            <option value="Transport">@L.T("Transport", "Transport")</option>
                            <option value="Électricité / Eau">@L.T("Électricité / Eau", "Utilities")</option>
                            <option value="Fournitures">@L.T("Fournitures", "Supplies")</option>
                            <option value="Autre">@L.T("Autre...", "Other...")</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3 d-none" id="customCategoryDiv">
                    <label class="form-label">@L.T("Préciser la catégorie", "Specify category")</label>
                    <input type="text" id="customCategoryInput" class="form-control" />
                </div>

                <div class="mb-4">
                    <label asp-for="Date" class="form-label">@L["Doc.Date"]</label>
                    <input asp-for="Date" type="datetime-local" class="form-control num" value="@DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm")" />
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-secondary-outline">@L["Action.Cancel"]</a>
                    <button type="submit" class="btn btn-accent">@L["Action.Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const sel = document.getElementById("categorySelect");
            const div = document.getElementById("customCategoryDiv");
            const inp = document.getElementById("customCategoryInput");
            sel.addEventListener("change", function () {
                if (sel.value === "Autre") {
                    div.classList.remove("d-none");
                    inp.required = true;
                } else {
                    div.classList.add("d-none");
                    inp.required = false;
                }
            });
            document.getElementById("expenseForm").addEventListener("submit", function () {
                if (sel.value === "Autre" && inp.value.trim()) {
                    const opt = document.createElement("option");
                    opt.value = inp.value.trim();
                    opt.selected = true;
                    sel.appendChild(opt);
                }
            });
        })();
    </script>
}
