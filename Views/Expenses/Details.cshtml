@model Expense
@{
    ViewData["Title"] = "Détail de la dépense";
    var authors = ViewData["OperationAuthors"] as IReadOnlyDictionary<string, OperationAuthor>;
}
<div class="page-heading"><div><p class="section-eyebrow"><a asp-action="Index">Dépenses</a></p><h1>@Model.Description</h1><p>@Model.Category · @Model.Date.ToString("dd/MM/yyyy")</p>
    <partial name="_OperationAuthor" model="@(authors?.GetValueOrDefault(Model.UserId))" /></div></div>
<div class="panel-card p-3 p-md-4 compact-form">
    <dl class="row mb-0">
        <dt class="col-sm-5">Montant</dt><dd class="col-sm-7 num">@Money.Display(Model.Amount, Model.CurrencyCode)</dd>
        <dt class="col-sm-5">Moyen de paiement</dt><dd class="col-sm-7">@PaymentMeans.Display(Model.PaymentMethod)</dd>
        @if (Model.CdfPerUsd is decimal rate) { <dt class="col-sm-5">Taux enregistré</dt><dd class="col-sm-7">@Money.RateLabel(rate)</dd> }
    </dl>
    @if (User.IsInRole("Admin"))
    {
        <div class="form-actions"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary-outline">Corriger</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Supprimer cette dépense ?')"><button type="submit" class="btn btn-danger-outline">Supprimer</button></form>
        </div>
    }
</div>
