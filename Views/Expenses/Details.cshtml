@model AdGestionHub.Models.Expense
@{
    var ctx = await TenantCtx.GetContextAsync();
    ViewData["Title"] = L.T("Détails de la dépense", "Expense Details");
    var isAdmin = User.IsInRole("Admin");
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="panel-card p-4">
            <h1 class="h5 mb-3 pb-3 border-bottom">@ViewData["Title"] #@Model.Id</h1>

            <dl class="row mb-0">
                <dt class="col-sm-4 text-slate small">@L["Doc.Description"]</dt>
                <dd class="col-sm-8 fw-medium">@Model.Description</dd>

                <dt class="col-sm-4 text-slate small">@L.T("Catégorie", "Category")</dt>
                <dd class="col-sm-8"><span class="status-pill">@Model.Category</span></dd>

                <dt class="col-sm-4 text-slate small">@L.T("Montant", "Amount")</dt>
                <dd class="col-sm-8 num fw-semibold text-sober-red">
                    @ctx.FormatHistorical(Model.Amount, Model.CurrencyCode, Model.CurrencyDecimals, Model.CurrencySymbol)
                </dd>

                <dt class="col-sm-4 text-slate small">@L["Doc.Date"]</dt>
                <dd class="col-sm-8 num">@ctx.FormatDateTime(Model.Date)</dd>
            </dl>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-secondary-outline">@L["Action.Back"]</a>
                @if (isAdmin)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-accent">@L["Action.Edit"]</a>
                }
            </div>
        </div>
    </div>
</div>
