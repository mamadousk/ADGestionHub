@model AdGestionHub.Models.StoreSettings
@{
    ViewData["Title"] = L.T("Paramètres & Fiscalité", "Settings & Tax");
    var countries = ViewBag.Countries as IReadOnlyList<CountryProfile> ?? CountryProfileCatalog.AllCountries;
    var currencies = ViewBag.Currencies as IReadOnlyCollection<CurrencyInfo> ?? CountryProfileCatalog.AllCurrencies;
    var activeTab = (ViewBag.ActiveTab as string) ?? "general";
    var optedIn = (ViewBag.EInvoicingOptedIn as bool?) ?? false;
    var auditLogs = ViewBag.AuditLogs as List<AdGestionHub.Models.SystemLog> ?? new List<AdGestionHub.Models.SystemLog>();
    var currentCountry = CountryProfileCatalog.GetCountry(Model.CountryCode);
    var currentCurrency = CountryProfileCatalog.GetCurrency(Model.PrimaryCurrencyCode);
    var en = L.IsEnglish;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h1 class="h4 mb-1">@L.T("Paramètres de l'établissement", "Store & Fiscal Settings")</h1>
        <p class="text-slate small mb-0">
            @L.T(
                "Les modifications de devise, de statut formalisé et de TVA s'appliquent exclusivement aux nouvelles opérations.",
                "Changes to currency, formalized status, and VAT apply exclusively to new transactions.")
        </p>
    </div>
</div>

<!-- Formulaire indépendant pour l'inscription à la Facturation Électronique Certifiée -->
<form id="notifyEInvoicingForm" asp-action="NotifyEInvoicing" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>

<div class="settings-tabs" role="tablist">
    <button type="button" class="settings-tab-btn @(activeTab == "general" ? "active" : "")" data-tab="general">
        @L.T("Général & Localisation", "General & Localization")
    </button>
    <button type="button" class="settings-tab-btn @(activeTab == "currencies" ? "active" : "")" data-tab="currencies">
        @L.T("Devises & Taux", "Currencies & Rates")
    </button>
    <button type="button" class="settings-tab-btn @(activeTab == "fiscal" ? "active" : "")" data-tab="fiscal">
        @L.T("Fiscalité & Documents", "Tax & Documents")
    </button>
    <button type="button" class="settings-tab-btn @(activeTab == "audit" ? "active" : "")" data-tab="audit">
        @L.T("Historique d'audit", "Audit Log")
    </button>
</div>

<form asp-action="Edit" method="post" id="settingsForm">
    <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="BoutiqueId" />
    <input type="hidden" name="ActiveTab" id="activeTabInput" value="@activeTab" />

    <div class="row g-4">
        <!-- COLONNE GAUCHE : PARAMÈTRES -->
        <div class="col-lg-7">

            <!-- ONGLET 1 : GÉNÉRAL & LOCALISATION -->
            <div class="tab-section @(activeTab == "general" ? "" : "d-none")" data-tab-panel="general">
                <div class="panel-card p-4 mb-4">
                    <h2 class="h6 mb-3">@L.T("Localisation régionale", "Regional Localization")</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CountryCode" class="form-label">@L.T("Pays d'exercice", "Operating Country")</label>
                            <select asp-for="CountryCode" class="form-select" id="countrySelect">
                                @foreach (var c in countries)
                                {
                                    <option value="@c.Code"
                                            data-currency="@c.PrimaryCurrencyCode"
                                            data-secondary="@c.SuggestedSecondaryCurrencyCode"
                                            data-dial="@c.PhoneDialCode"
                                            data-date="@c.DateFormat"
                                            data-tax-fr="@c.TaxIdLabelFr"
                                            data-tax-en="@c.TaxIdLabelEn"
                                            data-rccm-fr="@c.TradeRegisterLabelFr"
                                            data-rccm-en="@c.TradeRegisterLabelEn"
                                            data-vat="@c.StandardVatRate.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                        @(en ? c.NameEn : c.NameFr) (@c.Code)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PreferredLanguage" class="form-label">@L.T("Langue par défaut", "Default Language")</label>
                            <select asp-for="PreferredLanguage" class="form-select" id="languageSelect">
                                <option value="fr">Français (FR)</option>
                                <option value="en">English (EN)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <div class="p-3 rounded border" style="background: var(--bg-canvas); font-size: 0.82rem;">
                                <div class="d-flex flex-wrap gap-3 num">
                                    <span><strong>@L.T("Indicatif tél.", "Dial code") :</strong> <span id="infoDialCode">@currentCountry.PhoneDialCode</span></span>
                                    <span><strong>@L.T("Format date", "Date format") :</strong> <span id="infoDateFormat">@currentCountry.DateFormat</span></span>
                                    <span><strong>@L.T("Identifiants légaux", "Legal IDs") :</strong> <span id="infoLegalLabels">@(en ? currentCountry.TaxIdLabelEn : currentCountry.TaxIdLabelFr) / @(en ? currentCountry.TradeRegisterLabelEn : currentCountry.TradeRegisterLabelFr)</span></span>
                                    <span><strong>@L.T("TVA standard", "Standard VAT") :</strong> <span id="infoStandardVat">@currentCountry.StandardVatRate.ToString("0.##")%</span></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel-card p-4">
                    <h2 class="h6 mb-3">@L.T("Coordonnées de l'établissement", "Business Identity")</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="StoreName" class="form-label">@L.T("Nom commercial", "Business Name")</label>
                            <input asp-for="StoreName" class="form-control" id="storeNameInput" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">@L.T("Téléphone", "Phone")</label>
                            <input asp-for="Phone" class="form-control num" id="storePhoneInput" placeholder="@currentCountry.PhoneDialCode ..." />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ContactEmail" class="form-label">@L.T("Email professionnel", "Business Email")</label>
                            <input asp-for="ContactEmail" class="form-control" id="storeEmailInput" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Address" class="form-label">@L.T("Adresse physique", "Street Address")</label>
                            <input asp-for="Address" class="form-control" id="storeAddressInput" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label">@L.T("Activité (interne)", "Business Description")</label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="col-12">
                            <label asp-for="FooterMessage" class="form-label">@L.T("Mention de pied de page (reçus & factures)", "Document Footer Note")</label>
                            <input asp-for="FooterMessage" class="form-control" id="footerMsgInput" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- ONGLET 2 : DEVISES & TAUX -->
            <div class="tab-section @(activeTab == "currencies" ? "" : "d-none")" data-tab-panel="currencies">
                <div class="panel-card p-4">
                    <h2 class="h6 mb-1">@L.T("Devise principale et bi-monétarisme", "Primary & Dual Currency")</h2>
                    <p class="text-slate small mb-3">
                        @L.T(
                            "Les ventes et mouvements passés conservent leur devise et leur format d'origine.",
                            "Historical sales and cash entries retain their original currency and precision.")
                    </p>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="PrimaryCurrencyCode" class="form-label">@L.T("Devise principale", "Primary Currency")</label>
                            <select asp-for="PrimaryCurrencyCode" class="form-select num" id="primaryCurrencySelect">
                                @foreach (var cur in currencies)
                                {
                                    <option value="@cur.Code" data-symbol="@cur.Symbol" data-decimals="@cur.Decimals">
                                        @cur.Code (@cur.Symbol) — @(en ? cur.NameEn : cur.NameFr)
                                    </option>
                                }
                            </select>
                            <div class="form-text num" id="currencyPrecisionHint">
                                @L.T("Décimales affichées :", "Displayed decimals:") @currentCurrency.Decimals
                            </div>
                        </div>

                        <div class="col-12 pt-2 border-top">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="SecondaryCurrencyEnabled" id="secondaryCurrencyToggle" />
                                <label class="form-check-label fw-medium" for="secondaryCurrencyToggle">
                                    @L.T("Activer une devise secondaire de caisse", "Enable secondary register currency")
                                </label>
                            </div>
                        </div>

                        <div id="secondaryCurrencyBlock" class="row g-3 mt-1 @(Model.SecondaryCurrencyEnabled ? "" : "d-none")">
                            <div class="col-md-6">
                                <label asp-for="SecondaryCurrencyCode" class="form-label">@L.T("Devise secondaire", "Secondary Currency")</label>
                                <select asp-for="SecondaryCurrencyCode" class="form-select num" id="secondaryCurrencySelect">
                                    @foreach (var cur in currencies)
                                    {
                                        <option value="@cur.Code" data-symbol="@cur.Symbol" data-decimals="@cur.Decimals">
                                            @cur.Code (@cur.Symbol)
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SecondaryExchangeRate" class="form-label" id="exchangeRateLabel">
                                    @L.T("Taux de conversion", "Exchange Rate") (1 <span id="secCodeSpan">@(Model.SecondaryCurrencyCode ?? "USD")</span> = X <span id="priCodeSpan">@Model.PrimaryCurrencyCode</span>)
                                </label>
                                <input asp-for="SecondaryExchangeRate" type="number" step="0.0001" min="0.0001" class="form-control num" id="exchangeRateInput" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ONGLET 3 : FISCALITÉ & DOCUMENTS -->
            <div class="tab-section @(activeTab == "fiscal" ? "" : "d-none")" data-tab-panel="fiscal">
                <!-- 1. Statut de l'entreprise -->
                <div class="panel-card p-4 mb-3">
                    <h2 class="h6 mb-1">@L.T("1. Statut juridique de l'entreprise", "1. Business Legal Status")</h2>
                    <p class="text-slate small mb-3">
                        @L.T(
                            "Pilote l'intitulé des documents (Reçu de vente vs Facture), les Devis/Proformas et les mentions légales.",
                            "Controls document titles (Sales Receipt vs Invoice), Quotes/Proformas, and legal headers.")
                    </p>

                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label class="panel-card p-3 d-block cursor-pointer h-100" style="cursor:pointer;">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <input type="radio" name="IsFormalized" value="false" class="form-check-input mt-0" id="statusInformalRadio" @(!Model.IsFormalized ? "checked" : "") />
                                    <span class="fw-semibold">@L["Status.Informal"]</span>
                                </div>
                                <div class="text-slate" style="font-size:0.78rem;">
                                    @L.T("Justificatifs intitulés « Reçu de vente ». Saisie rapide sans identifiants fiscaux.", "Documents titled 'Sales Receipt'. Fast checkout without tax IDs.")
                                </div>
                            </label>
                        </div>
                        <div class="col-sm-6">
                            <label class="panel-card p-3 d-block h-100" style="cursor:pointer;">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <input type="radio" name="IsFormalized" value="true" class="form-check-input mt-0" id="statusFormalizedRadio" @(Model.IsFormalized ? "checked" : "") />
                                    <span class="fw-semibold">@L["Status.Formalized"]</span>
                                </div>
                                <div class="text-slate" style="font-size:0.78rem;">
                                    @L.T("Documents intitulés « Facture », identifiants légaux requis et module Devis/Proformas activé.", "Documents titled 'Invoice', legal IDs required, and Quotes/Proformas unlocked.")
                                </div>
                            </label>
                        </div>
                    </div>

                    <div id="formalizedFields" class="row g-3 pt-2 border-top @(Model.IsFormalized ? "" : "d-none")">
                        <div class="col-md-6">
                            <label asp-for="TaxIdentificationNumber" class="form-label">
                                <span id="taxIdLabelText">@(en ? currentCountry.TaxIdLabelEn : currentCountry.TaxIdLabelFr)</span> *
                            </label>
                            <input asp-for="TaxIdentificationNumber" class="form-control num" id="taxIdInput" placeholder="@L.T("Numéro fiscal officiel", "Official Tax ID")" />
                            <span asp-validation-for="TaxIdentificationNumber" class="text-sober-red small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TradeRegisterNumber" class="form-label">
                                <span id="rccmLabelText">@(en ? currentCountry.TradeRegisterLabelEn : currentCountry.TradeRegisterLabelFr)</span>
                            </label>
                            <input asp-for="TradeRegisterNumber" class="form-control num" id="rccmInput" placeholder="@L.T("Registre du commerce", "Trade register number")" />
                        </div>
                    </div>
                </div>

                <!-- 2. Gestion de la TVA -->
                <div class="panel-card p-4 mb-3">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <h2 class="h6 mb-1">@L.T("2. Gestion et affichage de la TVA", "2. VAT Calculation & Display")</h2>
                            <p class="text-slate small mb-0">
                                @L.T(
                                    "Lorsqu'elle est désactivée, seuls le Prix Unitaire et le Total Net sont affichés.",
                                    "When disabled, only Unit Price and Net Total are shown on documents.")
                            </p>
                        </div>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" asp-for="IsVatEnabled" id="vatToggle" />
                        </div>
                    </div>

                    <div id="vatRateBlock" class="row g-3 mt-2 pt-3 border-top @(Model.IsVatEnabled ? "" : "d-none")">
                        <div class="col-md-6">
                            <label asp-for="DefaultVatRate" class="form-label">@L.T("Taux de TVA standard (%)", "Standard VAT Rate (%)")</label>
                            <input asp-for="DefaultVatRate" type="number" step="0.01" min="0" max="100" class="form-control num" id="defaultVatInput" />
                            <div class="form-text">
                                @L.T("Appliqué par défaut aux produits et modulable par fiche article.", "Applied by default to products; overridable per item.")
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Facturation Électronique Certifiée (terminologie universelle) -->
                <div class="panel-card p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <h2 class="h6 mb-0">@L["Status.EInvoicingTitle"]</h2>
                        <span class="status-pill warning">@L["Status.IntegrationInProgress"]</span>
                    </div>
                    <p class="text-slate small mb-3">
                        @L["Status.EInvoicingBody"]
                    </p>

                    @if (optedIn)
                    {
                        <span class="status-pill success">
                            @LucideIcons.Svg("check", 14)
                            <span>@L["Status.NotifyRegistered"] (@Model.CountryCode)</span>
                        </span>
                    }
                    else
                    {
                        <button type="submit" form="notifyEInvoicingForm" class="btn btn-secondary-outline btn-sm">
                            @LucideIcons.Svg("bell", 15, "me-1")
                            <span>@L["Status.NotifyMeCountry"]</span>
                        </button>
                    }
                </div>
            </div>

            <!-- ONGLET 4 : HISTORIQUE D'AUDIT -->
            <div class="tab-section @(activeTab == "audit" ? "" : "d-none")" data-tab-panel="audit">
                <div class="panel-card overflow-hidden">
                    <div class="p-3 border-bottom">
                        <h2 class="h6 mb-0">@L.T("Journal d'audit de l'établissement", "Store Audit Trail")</h2>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-ledger">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>@L.T("Opérateur", "User")</th>
                                    <th>@L.T("Événement", "Event")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!auditLogs.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-slate py-4">
                                            @L.T("Aucun événement d'audit enregistré pour le moment.", "No audit events recorded yet.")
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var log in auditLogs)
                                    {
                                        <tr>
                                            <td class="num text-nowrap">@log.DateOccurred.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="text-slate">@log.UserEmail</td>
                                            <td>
                                                <div class="fw-medium">@log.ErrorMessage.Replace("[AUDIT] ", "")</div>
                                                @if (!string.IsNullOrWhiteSpace(log.StackTrace))
                                                {
                                                    <div class="text-slate" style="font-size:0.78rem;">@log.StackTrace</div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex justify-content-end" id="saveButtonWrap">
                <button type="submit" class="btn btn-accent px-4">
                    @LucideIcons.Svg("check", 16, "me-1")
                    <span>@L["Action.Save"]</span>
                </button>
            </div>
        </div>

        <!-- COLONNE DROITE : APERÇU EN DIRECT (58MM & A4) -->
        <div class="col-lg-5">
            <div class="panel-card p-3 position-sticky" style="top: 72px;">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <span class="fw-semibold small">@L.T("Aperçu en direct", "Live Document Preview")</span>
                    <div class="lang-switch" role="group">
                        <a href="#" id="btnPreviewThermal" class="active" onclick="switchPreviewMode('thermal'); return false;">Ticket 58mm</a>
                        <a href="#" id="btnPreviewA4" onclick="switchPreviewMode('a4'); return false;">Format A4</a>
                    </div>
                </div>

                <!-- Aperçu Ticket Thermique 58mm -->
                <div id="previewThermalBox" class="py-2" style="background: var(--bg-canvas);">
                    <div class="preview-thermal-58mm preview-doc">
                        <div class="text-center">
                            <div class="fw-bold" style="font-size:0.86rem;" id="pvThStoreName">@Model.StoreName</div>
                            <div class="text-slate" id="pvThAddress">@Model.Address</div>
                            <div class="text-slate num" id="pvThPhone">@Model.Phone</div>
                            <div class="text-dark fw-medium num mt-1 d-none" id="pvThLegal"></div>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between">
                            <span class="fw-semibold" id="pvThDocTitle">REÇU DE VENTE</span>
                            <span class="num" id="pvThDocNum">REC-00001</span>
                        </div>
                        <div class="d-flex justify-content-between text-slate num">
                            <span>Date</span>
                            <span id="pvThDate">@DateTime.Now.ToString(currentCountry.DateFormat)</span>
                        </div>
                        <div class="text-slate mt-1" id="pvThClientLine">Client : Comptoir</div>
                        <hr />
                        <div class="d-flex justify-content-between num mb-1">
                            <span>Article A x2</span>
                            <span id="pvThLine1"></span>
                        </div>
                        <div class="d-flex justify-content-between num">
                            <span>Article B x1</span>
                            <span id="pvThLine2"></span>
                        </div>
                        <hr />
                        <div id="pvThVatRows" class="d-none">
                            <div class="d-flex justify-content-between num text-slate">
                                <span id="pvThLblHt">Total HT</span>
                                <span id="pvThValHt"></span>
                            </div>
                            <div class="d-flex justify-content-between num text-slate mb-1">
                                <span id="pvThLblVat">Montant TVA</span>
                                <span id="pvThValVat"></span>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between fw-bold num" style="font-size:0.84rem;">
                            <span id="pvThLblTotal">Total Net</span>
                            <span id="pvThValTotal"></span>
                        </div>
                        <div class="d-flex justify-content-between text-slate num mt-1 d-none" id="pvThSecondaryRow" style="font-size:0.7rem;">
                            <span id="pvThLblSec">Contre-valeur</span>
                            <span id="pvThValSec"></span>
                        </div>
                        <div class="text-center text-slate fst-italic mt-2 d-none" id="pvThNoVatNote" style="font-size:0.68rem;">
                            TVA non applicable
                        </div>
                        <hr />
                        <div class="text-center text-slate" style="font-size:0.7rem;" id="pvThFooter">
                            @(string.IsNullOrWhiteSpace(Model.FooterMessage) ? "Merci de votre confiance." : Model.FooterMessage)
                        </div>
                    </div>
                </div>

                <!-- Aperçu Facture / Document A4 -->
                <div id="previewA4Box" class="d-none">
                    <div class="preview-a4 preview-doc">
                        <div class="d-flex justify-content-between align-items-start pb-2 mb-3" style="border-bottom: 1.5px solid var(--accent);">
                            <div>
                                <div class="fw-bold" style="font-size:0.95rem;" id="pvA4StoreName">@Model.StoreName</div>
                                <div class="text-slate" id="pvA4Address">@Model.Address</div>
                                <div class="text-slate num" id="pvA4Phone">@Model.Phone</div>
                                <div class="fw-medium num mt-1 d-none" id="pvA4Legal"></div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold" style="font-size:0.9rem;" id="pvA4DocTitle">REÇU DE VENTE</div>
                                <div class="num fw-medium" id="pvA4DocNum">REC-00001</div>
                                <div class="text-slate num" id="pvA4Date">@DateTime.Now.ToString(currentCountry.DateFormat)</div>
                            </div>
                        </div>

                        <div class="p-2 rounded border mb-3" style="background: var(--bg-canvas);">
                            <div class="text-slate" style="font-size:0.7rem;" id="pvA4ClientHeader">Client</div>
                            <div class="fw-semibold" id="pvA4ClientName">Société Exemple SARL</div>
                            <div class="text-slate num d-none" id="pvA4ClientTaxId"></div>
                        </div>

                        <table class="table table-sm mb-2" style="font-size:0.74rem;">
                            <thead>
                                <tr style="background: var(--bg-canvas);">
                                    <th id="pvA4ColDesc">Désignation</th>
                                    <th class="text-center">Qté</th>
                                    <th class="text-end" id="pvA4ColUnit">Prix Unit.</th>
                                    <th class="text-end" id="pvA4ColTotal">Montant</th>
                                </tr>
                            </thead>
                            <tbody class="num">
                                <tr>
                                    <td>Article A</td>
                                    <td class="text-center">2</td>
                                    <td class="text-end" id="pvA4U1"></td>
                                    <td class="text-end fw-medium" id="pvA4L1"></td>
                                </tr>
                                <tr>
                                    <td>Article B</td>
                                    <td class="text-center">1</td>
                                    <td class="text-end" id="pvA4U2"></td>
                                    <td class="text-end fw-medium" id="pvA4L2"></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="ms-auto p-2 rounded border num" style="max-width: 210px; background: var(--bg-canvas);">
                            <div id="pvA4VatRows" class="d-none">
                                <div class="d-flex justify-content-between text-slate">
                                    <span id="pvA4LblHt">Total HT</span>
                                    <span id="pvA4ValHt"></span>
                                </div>
                                <div class="d-flex justify-content-between text-slate border-bottom pb-1 mb-1">
                                    <span id="pvA4LblVat">Montant TVA</span>
                                    <span id="pvA4ValVat"></span>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between fw-bold">
                                <span id="pvA4LblTotal">Total Net</span>
                                <span id="pvA4ValTotal"></span>
                            </div>
                            <div class="d-flex justify-content-between text-slate mt-1 d-none" id="pvA4SecondaryRow" style="font-size:0.69rem;">
                                <span id="pvA4LblSec">Eq.</span>
                                <span id="pvA4ValSec"></span>
                            </div>
                        </div>

                        <div class="text-end text-slate fst-italic mt-2 d-none" id="pvA4NoVatNote" style="font-size:0.7rem;">
                            TVA non applicable
                        </div>
                        <div class="text-center text-slate border-top pt-2 mt-3" style="font-size:0.7rem;" id="pvA4Footer">
                            @(string.IsNullOrWhiteSpace(Model.FooterMessage) ? "Merci de votre confiance." : Model.FooterMessage)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function switchPreviewMode(mode) {
            const th = document.getElementById("previewThermalBox");
            const a4 = document.getElementById("previewA4Box");
            const btnTh = document.getElementById("btnPreviewThermal");
            const btnA4 = document.getElementById("btnPreviewA4");
            if (mode === "a4") {
                th.classList.add("d-none");
                a4.classList.remove("d-none");
                btnTh.classList.remove("active");
                btnA4.classList.add("active");
            } else {
                a4.classList.add("d-none");
                th.classList.remove("d-none");
                btnA4.classList.remove("active");
                btnTh.classList.add("active");
            }
        }

        (function () {
            "use strict";

            // Navigation par onglets
            document.querySelectorAll(".settings-tab-btn").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    const tab = btn.getAttribute("data-tab");
                    document.getElementById("activeTabInput").value = tab;
                    document.querySelectorAll(".settings-tab-btn").forEach(b => b.classList.remove("active"));
                    btn.classList.add("active");
                    document.querySelectorAll(".tab-section").forEach(sec => {
                        sec.classList.toggle("d-none", sec.getAttribute("data-tab-panel") !== tab);
                    });
                    document.getElementById("saveButtonWrap").classList.toggle("d-none", tab === "audit");
                });
            });

            const countrySelect = document.getElementById("countrySelect");
            const languageSelect = document.getElementById("languageSelect");
            const primaryCurrencySelect = document.getElementById("primaryCurrencySelect");
            const secondaryToggle = document.getElementById("secondaryCurrencyToggle");
            const secondarySelect = document.getElementById("secondaryCurrencySelect");
            const exchangeRateInput = document.getElementById("exchangeRateInput");
            const informalRadio = document.getElementById("statusInformalRadio");
            const formalizedRadio = document.getElementById("statusFormalizedRadio");
            const vatToggle = document.getElementById("vatToggle");
            const defaultVatInput = document.getElementById("defaultVatInput");

            function fmtMoney(amount, decimals, symbol, lang) {
                const rounded = decimals === 0 ? Math.round(amount) : Number(amount.toFixed(decimals));
                const parts = rounded.toFixed(decimals).split(".");
                const sepGroup = lang === "en" ? "," : " ";
                const sepDec = lang === "en" ? "." : ",";
                parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, sepGroup);
                const formatted = decimals > 0 ? parts.join(sepDec) : parts[0];
                if (lang === "en" && (symbol === "$" || symbol === "£" || symbol === "₦")) {
                    return symbol + formatted;
                }
                return formatted + " " + symbol;
            }

            // Changement de pays -> répercussions automatiques (devise, indicatif, libellés légaux, taux TVA suggéré)
            countrySelect.addEventListener("change", function () {
                const opt = countrySelect.options[countrySelect.selectedIndex];
                if (!opt) return;

                const defCurrency = opt.getAttribute("data-currency");
                const defSecondary = opt.getAttribute("data-secondary");
                const defVat = opt.getAttribute("data-vat");
                const dial = opt.getAttribute("data-dial");

                if (defCurrency) primaryCurrencySelect.value = defCurrency;
                if (defSecondary) secondarySelect.value = defSecondary;
                if (defVat) defaultVatInput.value = defVat;

                const phoneInput = document.getElementById("storePhoneInput");
                if (phoneInput && (!phoneInput.value || phoneInput.value.trim().length <= 5)) {
                    phoneInput.placeholder = dial + " ...";
                }

                refreshUI();
            });

            function refreshUI() {
                const lang = languageSelect.value === "en" ? "en" : "fr";
                const cOpt = countrySelect.options[countrySelect.selectedIndex];
                const pOpt = primaryCurrencySelect.options[primaryCurrencySelect.selectedIndex];
                const sOpt = secondarySelect.options[secondarySelect.selectedIndex];

                const dial = cOpt ? cOpt.getAttribute("data-dial") : "+243";
                const dateFmt = cOpt ? cOpt.getAttribute("data-date") : "dd/MM/yyyy";
                const taxLabel = cOpt ? cOpt.getAttribute(lang === "en" ? "data-tax-en" : "data-tax-fr") : "NIF";
                const rccmLabel = cOpt ? cOpt.getAttribute(lang === "en" ? "data-rccm-en" : "data-rccm-fr") : "RCCM";
                const stdVat = cOpt ? cOpt.getAttribute("data-vat") : "16";

                document.getElementById("infoDialCode").textContent = dial;
                document.getElementById("infoDateFormat").textContent = dateFmt;
                document.getElementById("infoLegalLabels").textContent = taxLabel + " / " + rccmLabel;
                document.getElementById("infoStandardVat").textContent = stdVat + "%";
                document.getElementById("taxIdLabelText").textContent = taxLabel;
                document.getElementById("rccmLabelText").textContent = rccmLabel;

                const pCode = pOpt ? pOpt.value : "CDF";
                const pSym = pOpt ? pOpt.getAttribute("data-symbol") : "FC";
                const pDec = pOpt ? parseInt(pOpt.getAttribute("data-decimals") || "2", 10) : 2;
                document.getElementById("currencyPrecisionHint").textContent =
                    (lang === "en" ? "Displayed decimals: " : "Décimales affichées : ") + pDec;

                const secEnabled = secondaryToggle.checked;
                document.getElementById("secondaryCurrencyBlock").classList.toggle("d-none", !secEnabled);
                const sCode = sOpt ? sOpt.value : "USD";
                const sSym = sOpt ? sOpt.getAttribute("data-symbol") : "$";
                const sDec = sOpt ? parseInt(sOpt.getAttribute("data-decimals") || "2", 10) : 2;
                document.getElementById("secCodeSpan").textContent = sCode;
                document.getElementById("priCodeSpan").textContent = pCode;

                const isFormalized = formalizedRadio.checked;
                document.getElementById("formalizedFields").classList.toggle("d-none", !isFormalized);

                const isVat = vatToggle.checked;
                document.getElementById("vatRateBlock").classList.toggle("d-none", !isVat);

                // Mise à jour de l'aperçu en direct (58mm + A4)
                const storeName = document.getElementById("storeNameInput").value.trim() || "AdGestionHub";
                const address = document.getElementById("storeAddressInput").value.trim();
                const phone = document.getElementById("storePhoneInput").value.trim();
                const footer = document.getElementById("footerMsgInput").value.trim()
                    || (lang === "en" ? "Thank you for your business." : "Merci de votre confiance.");
                const taxVal = document.getElementById("taxIdInput").value.trim() || "00012345-A";
                const rccmVal = document.getElementById("rccmInput").value.trim();

                // Montants d'exemple adaptés à l'échelle de la devise
                const baseUnit1 = (pCode === "CDF" || pCode === "GNF") ? 15000 : (pDec === 0 ? 5000 : 25);
                const baseUnit2 = (pCode === "CDF" || pCode === "GNF") ? 10000 : (pDec === 0 ? 3500 : 15);
                const line1 = baseUnit1 * 2;
                const line2 = baseUnit2 * 1;
                const subtotal = line1 + line2;
                const vatRate = isVat ? (parseFloat(String(defaultVatInput.value).replace(",", ".")) || 0) : 0;
                const vatAmt = isVat ? (subtotal * vatRate / 100.0) : 0;
                const grandTotal = subtotal + vatAmt;

                const docTitle = isFormalized
                    ? (lang === "en" ? "INVOICE" : "FACTURE")
                    : (lang === "en" ? "SALES RECEIPT" : "REÇU DE VENTE");
                const docNum = isFormalized ? "FAC-00001" : "REC-00001";

                // Ticket 58mm
                document.getElementById("pvThStoreName").textContent = storeName;
                document.getElementById("pvThAddress").textContent = address;
                document.getElementById("pvThPhone").textContent = phone;
                const pvThLegal = document.getElementById("pvThLegal");
                pvThLegal.classList.toggle("d-none", !isFormalized);
                pvThLegal.textContent = taxLabel + ": " + taxVal + (rccmVal ? " | " + rccmLabel + ": " + rccmVal : "");

                document.getElementById("pvThDocTitle").textContent = docTitle;
                document.getElementById("pvThDocNum").textContent = docNum;
                document.getElementById("pvThClientLine").textContent = isFormalized
                    ? (lang === "en" ? "Customer: Acme Corp (" + taxLabel + ": B2B-901)" : "Client : Société Exemple (" + taxLabel + " : B2B-901)")
                    : (lang === "en" ? "Customer: Walk-in" : "Client : Comptoir");

                document.getElementById("pvThLine1").textContent = fmtMoney(line1, pDec, pSym, lang);
                document.getElementById("pvThLine2").textContent = fmtMoney(line2, pDec, pSym, lang);

                document.getElementById("pvThVatRows").classList.toggle("d-none", !isVat);
                document.getElementById("pvThLblHt").textContent = lang === "en" ? "Subtotal Excl." : "Total HT";
                document.getElementById("pvThValHt").textContent = fmtMoney(subtotal, pDec, pSym, lang);
                document.getElementById("pvThLblVat").textContent = (lang === "en" ? "VAT (" : "TVA (") + vatRate + "%)";
                document.getElementById("pvThValVat").textContent = fmtMoney(vatAmt, pDec, pSym, lang);

                document.getElementById("pvThLblTotal").textContent = isVat
                    ? (lang === "en" ? "Total Incl. Tax" : "Total TTC")
                    : (lang === "en" ? "Net Total" : "Total Net");
                document.getElementById("pvThValTotal").textContent = fmtMoney(grandTotal, pDec, pSym, lang);

                const noVatText = lang === "en" ? "VAT not applicable" : "TVA non applicable";
                const pvThNoVat = document.getElementById("pvThNoVatNote");
                pvThNoVat.textContent = noVatText;
                pvThNoVat.classList.toggle("d-none", !(isFormalized && !isVat));
                document.getElementById("pvThFooter").textContent = footer;

                // Contre-valeur devise secondaire
                const rate = parseFloat(String(exchangeRateInput.value).replace(",", ".")) || 0;
                const showSec = secEnabled && rate > 0 && sCode !== pCode;
                document.getElementById("pvThSecondaryRow").classList.toggle("d-none", !showSec);
                document.getElementById("pvA4SecondaryRow").classList.toggle("d-none", !showSec);
                if (showSec) {
                    const secAmount = grandTotal / rate;
                    const secText = fmtMoney(secAmount, sDec, sSym, lang);
                    document.getElementById("pvThLblSec").textContent = (lang === "en" ? "Eq. " : "Contre-valeur ") + sCode;
                    document.getElementById("pvThValSec").textContent = secText;
                    document.getElementById("pvA4LblSec").textContent = (lang === "en" ? "Eq. " : "Contre-valeur ") + sCode;
                    document.getElementById("pvA4ValSec").textContent = secText;
                }

                // Format A4
                document.getElementById("pvA4StoreName").textContent = storeName;
                document.getElementById("pvA4Address").textContent = address;
                document.getElementById("pvA4Phone").textContent = phone;
                const pvA4Legal = document.getElementById("pvA4Legal");
                pvA4Legal.classList.toggle("d-none", !isFormalized);
                pvA4Legal.textContent = taxLabel + " : " + taxVal + (rccmVal ? " · " + rccmLabel + " : " + rccmVal : "");

                document.getElementById("pvA4DocTitle").textContent = docTitle;
                document.getElementById("pvA4DocNum").textContent = docNum;
                document.getElementById("pvA4ClientHeader").textContent = lang === "en" ? "Customer" : "Client";
                document.getElementById("pvA4ClientName").textContent = isFormalized
                    ? (lang === "en" ? "Acme Business Ltd" : "Société Exemple SARL")
                    : (lang === "en" ? "Walk-in customer" : "Client comptoir");
                const pvA4ClientTax = document.getElementById("pvA4ClientTaxId");
                pvA4ClientTax.classList.toggle("d-none", !isFormalized);
                pvA4ClientTax.textContent = taxLabel + " : B2B-90182";

                document.getElementById("pvA4ColDesc").textContent = lang === "en" ? "Description" : "Désignation";
                document.getElementById("pvA4ColUnit").textContent = isVat
                    ? (lang === "en" ? "Unit Excl." : "P.U. HT")
                    : (lang === "en" ? "Unit Price" : "Prix Unit.");
                document.getElementById("pvA4ColTotal").textContent = isVat
                    ? (lang === "en" ? "Amount Excl." : "Montant HT")
                    : (lang === "en" ? "Amount" : "Montant");

                document.getElementById("pvA4U1").textContent = fmtMoney(baseUnit1, pDec, pSym, lang);
                document.getElementById("pvA4L1").textContent = fmtMoney(line1, pDec, pSym, lang);
                document.getElementById("pvA4U2").textContent = fmtMoney(baseUnit2, pDec, pSym, lang);
                document.getElementById("pvA4L2").textContent = fmtMoney(line2, pDec, pSym, lang);

                document.getElementById("pvA4VatRows").classList.toggle("d-none", !isVat);
                document.getElementById("pvA4LblHt").textContent = lang === "en" ? "Subtotal Excl. Tax" : "Total HT";
                document.getElementById("pvA4ValHt").textContent = fmtMoney(subtotal, pDec, pSym, lang);
                document.getElementById("pvA4LblVat").textContent = (lang === "en" ? "VAT (" : "Montant TVA (") + vatRate + "%)";
                document.getElementById("pvA4ValVat").textContent = fmtMoney(vatAmt, pDec, pSym, lang);

                document.getElementById("pvA4LblTotal").textContent = isVat
                    ? (lang === "en" ? "Total Incl. Tax" : "Total TTC")
                    : (lang === "en" ? "Net Total" : "Total Net");
                document.getElementById("pvA4ValTotal").textContent = fmtMoney(grandTotal, pDec, pSym, lang);

                const pvA4NoVat = document.getElementById("pvA4NoVatNote");
                pvA4NoVat.textContent = noVatText;
                pvA4NoVat.classList.toggle("d-none", !(isFormalized && !isVat));
                document.getElementById("pvA4Footer").textContent = footer;
            }

            [
                "languageSelect", "primaryCurrencySelect", "secondaryCurrencyToggle",
                "secondaryCurrencySelect", "exchangeRateInput", "statusInformalRadio",
                "statusFormalizedRadio", "vatToggle", "defaultVatInput",
                "storeNameInput", "storeAddressInput", "storePhoneInput",
                "footerMsgInput", "taxIdInput", "rccmInput"
            ].forEach(function (id) {
                const el = document.getElementById(id);
                if (el) {
                    el.addEventListener("input", refreshUI);
                    el.addEventListener("change", refreshUI);
                }
            });

            refreshUI();
        })();
    </script>
}
