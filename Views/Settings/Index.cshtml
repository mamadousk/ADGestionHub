@model AdGestionHub.Models.StoreSettings
@{
    ViewData["Title"] = "Paramètres de la boutique";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold mb-0" style="color:#FF8C00;"><i class="fas fa-sliders-h me-2"></i> Paramètres</h1>
        <span class="badge bg-light text-dark border px-3 py-2">Configuration de la boutique</span>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4 p-lg-5">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-modern mb-4"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="BoutiqueId" />

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="StoreName" class="form-control form-control-modern" placeholder="Nom de la boutique" required />
                            <label asp-for="StoreName"><i class="fas fa-store me-2"></i>Nom de la boutique</label>
                            <span asp-validation-for="StoreName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="Address" class="form-control form-control-modern" placeholder="Adresse" />
                            <label asp-for="Address"><i class="fas fa-map-pin me-2"></i>Adresse physique</label>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="Phone" class="form-control form-control-modern" placeholder="Téléphone" />
                            <label asp-for="Phone"><i class="fas fa-phone me-2"></i>Téléphone de contact</label>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="ContactEmail" class="form-control form-control-modern" placeholder="Email de contact" />
                            <label asp-for="ContactEmail"><i class="fas fa-envelope me-2"></i>Email figurant sur les reçus</label>
                            <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-floating mb-3">
                            <textarea asp-for="Description" class="form-control form-control-modern" placeholder="Description de la boutique" style="height: 110px;"></textarea>
                            <label asp-for="Description"><i class="fas fa-align-left me-2"></i>Description de l'activité</label>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="form-floating mb-3">
                            <textarea asp-for="FooterMessage" class="form-control form-control-modern" placeholder="Message de remerciement pour les reçus" style="height: 85px;"></textarea>
                            <label asp-for="FooterMessage"><i class="fas fa-pen me-2"></i>Message de pied de page (reçus clients)</label>
                            <span asp-validation-for="FooterMessage" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-primary-gradient px-5 py-2">
                        <i class="fas fa-save me-2"></i> Enregistrer les modifications
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
