@model ShopSettingsInput
@{
    var setup = ViewData["Setup"] is true;
    ViewData["Title"] = setup ? "Configurer ma boutique" : "Paramètres de l’entreprise";
    ViewData["PublicShell"] = setup;
    ViewData["AccountFlow"] = setup;
    var locked = ViewData["CurrencyLocked"] is true;
    var logo = ViewData["LogoDataUrl"] as string;
}
<div class="page-heading">
    <div>
        <p class="section-eyebrow">@(setup ? "Première connexion · Configuration facultative" : "Administration")</p>
        <h1>@ViewData["Title"]</h1>
        <p>@(setup ? "Personnalisez votre espace maintenant ou commencez avec les réglages par défaut. Vous retrouverez ce formulaire dans Paramètres." : "Identité de la boutique, documents, devises et modes de règlement.")</p>
    </div>
    @if (!setup)
    {
        <div class="d-flex flex-wrap gap-2"><a asp-action="Audit" class="btn btn-secondary-outline">Journal d’activité</a><a asp-controller="Users" asp-action="Index" class="btn btn-secondary-outline">Gérer l’équipe</a></div>
    }
</div>
<form asp-action="@(setup ? "Setup" : "Edit")" method="post" enctype="multipart/form-data" class="settings-form">
    <div asp-validation-summary="All" class="validation-banner" role="alert"></div>
    <div class="dashboard-columns report-pair">
        <section class="panel-card p-3 p-md-4">
            <h2 class="h6 mb-3">Coordonnées de l’entreprise</h2>
            <div class="mb-3"><label asp-for="StoreName" class="form-label">Nom de l’entreprise</label><input asp-for="StoreName" class="form-control" autocomplete="organization" required /></div>
            <div class="mb-3"><label asp-for="Address" class="form-label">Adresse</label><input asp-for="Address" class="form-control" autocomplete="street-address" /></div>
            <div class="mb-3"><label asp-for="Phone" class="form-label">Téléphone</label><input asp-for="Phone" type="tel" class="form-control" autocomplete="tel" placeholder="+243" /></div>
            <div class="mb-3"><label asp-for="ContactEmail" class="form-label">E-mail de contact</label><input asp-for="ContactEmail" type="email" class="form-control" autocomplete="email" /></div>
            <div><label asp-for="Description" class="form-label">Description de l’activité</label><textarea asp-for="Description" class="form-control" rows="2"></textarea></div>
        </section>
        <div class="d-grid gap-3">
            <section class="panel-card p-3 p-md-4">
                <h2 class="h6 mb-3">Reçus et factures</h2>
                @if (logo != null)
                {
                    <div class="settings-logo-preview mb-3"><img class="receipt-logo" src="@logo" alt="Logo actuel de la boutique" /></div>
                }
                <div class="mb-3">
                    <label asp-for="Logo" class="form-label">@(logo == null ? "Logo de la boutique" : "Remplacer le logo")</label>
                    <input asp-for="Logo" type="file" class="form-control" accept="image/png,image/jpeg" aria-describedby="logo-help" />
                    <div class="form-text" id="logo-help">Facultatif. PNG ou JPEG, 2 Mo et 2 048 pixels par côté au maximum. Le logo s’affiche sur les documents consultés, imprimés ou téléchargés en PDF.</div>
                    @if (logo != null)
                    {
                        <div class="form-check mt-2"><input asp-for="RemoveLogo" class="form-check-input" /><label asp-for="RemoveLogo" class="form-check-label">Supprimer le logo actuel</label></div>
                    }
                </div>
                <div><label asp-for="FooterMessage" class="form-label">Message sur les documents</label><textarea asp-for="FooterMessage" class="form-control" rows="2"></textarea></div>
            </section>
            <section class="panel-card p-3 p-md-4">
                <h2 class="h6 mb-3">Devises et paiements</h2>
                <div class="mb-3"><label asp-for="PrimaryCurrencyCode" class="form-label">Devise du catalogue</label>
                    @if (locked)
                    {
                        <input asp-for="PrimaryCurrencyCode" class="form-control" readonly />
                        <div class="form-text">Verrouillée après votre premier produit ou votre première opération pour ne pas relibeller les montants.</div>
                    }
                    else
                    {
                        <select asp-for="PrimaryCurrencyCode" class="form-select"><option value="CDF">Franc congolais (CDF)</option><option value="USD">Dollar américain (USD)</option></select>
                    }
                </div>
                <div class="mb-3">
                    <label asp-for="CdfPerUsd" class="form-label">Taux de change manuel</label>
                    <div class="input-group"><span class="input-group-text">1 USD =</span><input asp-for="CdfPerUsd" asp-format="{0:0.######}" class="form-control num" inputmode="decimal" placeholder="Ex. 2800" /><span class="input-group-text">CDF</span></div>
                    <div class="form-text">Sans taux, saisissez vos opérations dans la devise du catalogue. Un nouveau taux ne modifie pas les opérations déjà enregistrées.</div>
                </div>
                <div>
                    <label asp-for="CustomPaymentMethods" class="form-label">Autres moyens de paiement</label>
                    <textarea asp-for="CustomPaymentMethods" class="form-control" rows="3" placeholder="Un moyen par ligne"></textarea>
                    <div class="form-text">Jusqu’à 8 moyens supplémentaires. Espèces, Mobile Money et Virement bancaire sont déjà proposés.</div>
                </div>
            </section>
        </div>
    </div>
    <div class="form-actions">
        @if (setup) { <button type="submit" form="skip-setup" class="btn btn-secondary-outline">Configurer plus tard</button> }
        <button type="submit" class="btn btn-accent">@(setup ? "Enregistrer et accéder à mon espace" : "Enregistrer les paramètres")</button>
    </div>
</form>
@if (setup) { <form asp-action="SkipSetup" method="post" id="skip-setup"></form> }
