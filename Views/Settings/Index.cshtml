@model ShopSettingsInput
@{
    ViewData["Title"] = "Paramètres de l’entreprise";
    var locked = ViewData["CurrencyLocked"] as bool? == true;
}
<div class="page-heading"><div><p class="section-eyebrow">Administration</p><h1>Paramètres de l’entreprise</h1><p>Coordonnées, devises et modes de règlement.</p></div><div class="d-flex flex-wrap gap-2"><a asp-action="Audit" class="btn btn-secondary-outline">Journal d’activité</a><a asp-controller="Users" asp-action="Index" class="btn btn-secondary-outline">Gérer l’équipe</a></div></div>
<form asp-action="Edit" method="post" class="settings-form">
    <div asp-validation-summary="All" class="validation-banner" role="alert"></div>
    <div class="dashboard-columns report-pair">
        <section class="panel-card p-3 p-md-4">
            <h2 class="h6 mb-3">Coordonnées de l’entreprise</h2>
            <div class="mb-3"><label asp-for="StoreName" class="form-label">Nom de l’entreprise</label><input asp-for="StoreName" class="form-control" required /></div>
            <div class="mb-3"><label asp-for="Address" class="form-label">Adresse</label><input asp-for="Address" class="form-control" /></div>
            <div class="mb-3"><label asp-for="Phone" class="form-label">Téléphone</label><input asp-for="Phone" type="tel" class="form-control" placeholder="+243" /></div>
            <div class="mb-3"><label asp-for="ContactEmail" class="form-label">E-mail de contact</label><input asp-for="ContactEmail" type="email" class="form-control" /></div>
            <div><label asp-for="FooterMessage" class="form-label">Message sur les documents</label><textarea asp-for="FooterMessage" class="form-control" rows="2"></textarea></div>
        </section>
        <section class="panel-card p-3 p-md-4">
            <h2 class="h6 mb-3">Devises et paiements</h2>
            <div class="mb-3"><label asp-for="PrimaryCurrencyCode" class="form-label">Devise du catalogue</label>
                @if (locked)
                {
                    <input asp-for="PrimaryCurrencyCode" class="form-control" readonly />
                    <div class="form-text">Verrouillée après votre premier produit ou votre première opération pour ne pas relibeller les montants.</div>
                }
                else
                {
                    <select asp-for="PrimaryCurrencyCode" class="form-select"><option value="CDF">Franc congolais (CDF)</option><option value="USD">Dollar américain (USD)</option></select>
                }
            </div>
            <div class="mb-3">
                <label asp-for="CdfPerUsd" class="form-label">Taux de change manuel</label>
                <div class="input-group"><span class="input-group-text">1 USD =</span><input asp-for="CdfPerUsd" asp-format="{0:0.######}" class="form-control num" inputmode="decimal" placeholder="Ex. 2800" /><span class="input-group-text">CDF</span></div>
                <div class="form-text">Sans taux, saisissez vos opérations dans la devise du catalogue. Le nouveau taux ne modifie pas les opérations déjà enregistrées.</div>
            </div>
            <div>
                <label asp-for="CustomPaymentMethods" class="form-label">Autres moyens de paiement</label>
                <textarea asp-for="CustomPaymentMethods" class="form-control" rows="4" placeholder="Un moyen par ligne"></textarea>
                <div class="form-text">Jusqu’à 8 moyens supplémentaires. Espèces, Mobile Money, Virement bancaire et les autres moyens standards sont toujours disponibles.</div>
            </div>
        </section>
    </div>
    <div class="form-actions"><button type="submit" class="btn btn-accent">Enregistrer les paramètres</button></div>
</form>
