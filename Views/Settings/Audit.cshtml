@model IReadOnlyList<SystemLog>
@{ ViewData["Title"] = "Journal d’activité"; }
<div class="page-heading"><div><p class="section-eyebrow"><a asp-action="Index">Paramètres</a></p><h1>Journal d’activité</h1><p>Les 100 opérations importantes les plus récentes de votre entreprise.</p></div></div>
@if (Model.Count == 0)
{
    <div class="panel-card empty-panel"><h2 class="h5">Aucune opération journalisée</h2></div>
}
else
{
    <div class="panel-card table-responsive"><table class="table table-ledger"><thead><tr><th scope="col">Date</th><th scope="col">Opération</th><th scope="col">Compte</th></tr></thead><tbody>
        @foreach (var entry in Model)
        {
            <tr><td class="text-nowrap">@entry.DateOccurred.ToString("dd/MM/yyyy HH:mm")</td><td><strong>@entry.ErrorMessage.Substring(SystemLog.AuditPrefix.Length)</strong>@if (entry.StackTrace != null) { <div class="text-slate small">@entry.StackTrace</div> }</td><td class="operation-author">@(new OperationAuthor(entry.ActorName, entry.UserEmail ?? "Système").Caption)</td></tr>
        }
    </tbody></table></div>
}
