@model Purchase
@{
    ViewData["Title"] = $"Achat {Model.Number}";
    var lines = new CommercialTable(Model.Items.Select(i => new CommercialLine(i.ProductName, i.Quantity, i.UnitPrice, i.Total)), Model.CurrencyCode);
}
<div class="page-heading">
    <div><p class="section-eyebrow"><a asp-action="Index">Achats</a></p><h1>Achat @Model.Number</h1><p><a asp-controller="Suppliers" asp-action="Details" asp-route-id="@Model.SupplierId">@Model.SupplierName</a> · @Model.RecordedAt.ToString("dd/MM/yyyy HH:mm")</p></div>
    <span class="status-pill @(Model.ReceivedAt.HasValue ? "success" : "warning")">@(Model.ReceivedAt.HasValue ? $"Reçu le {Model.ReceivedAt.Value:dd/MM/yyyy}" : "En attente de réception")</span>
</div>
@if (!Model.ReceivedAt.HasValue)
{
    <section class="panel-card p-3 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div><h2 class="h6 mb-1">Marchandises arrivées ?</h2><p class="text-slate mb-0">Confirmez la réception pour ajouter les quantités au stock.</p></div>
        <form asp-action="Receive" asp-route-id="@Model.Id" method="post"><button class="btn btn-accent" type="submit">Confirmer la réception</button></form>
    </section>
}
<section class="panel-card mb-3">
    <div class="p-3 p-md-4 pb-md-2"><h2 class="h6 mb-0">Articles achetés</h2>@if (Model.SupplierReference != null) { <p class="text-slate small mb-0 mt-1">Référence fournisseur : @Model.SupplierReference</p> }</div>
    <partial name="_CommercialLines" model="lines" />
    <div class="doc-totals p-3 p-md-4"><div><span>Total de l’achat</span><b>@Money.Display(Model.Total, Model.CurrencyCode)</b></div><div><span>Déjà réglé</span><b>@Money.Display(Model.Paid, Model.CurrencyCode)</b></div>
        <div class="total-line"><span>Reste à payer</span><b>@Money.Display(Model.Balance, Model.CurrencyCode)</b></div>
        @if (Model.CdfPerUsd is decimal rate) { <p class="text-slate small mb-0 mt-2">Taux de l’achat : @Money.RateLabel(rate)</p> }
    </div>
</section>
@if (Model.Balance > 0) { <partial name="_Settle" model="@(new NewPaymentForm("Purchase", Model.Id, Model.CurrencyCode, Model.Balance))" /> }
<section class="panel-card p-3 p-md-4"><h2 class="h6 mb-3">Historique des règlements</h2><partial name="_PaymentHistory" model="Model.Payments" /></section>
