@model AdGestionHub.Models.ReportViewModel

@{
    ViewData["Title"] = "Rapports Financiers";
    var today = DateTime.Today;
    var weekStart = today.AddDays(-6);
    var monthStart = new DateTime(today.Year, today.Month, 1);
}

<div>
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-0"><i class="fas fa-chart-bar text-primary me-2"></i>Rapports Financiers</h1>
            <p class="text-muted mb-0">@Model.StoreName — Analyse des ventes, marges et dépenses</p>
        </div>
        <a asp-action="GenerateDailyReport"
           asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
           asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
           class="btn btn-primary-gradient mt-2 mt-md-0">
            <i class="fas fa-file-pdf me-2"></i> Télécharger le rapport PDF
        </a>
    </div>

    <!-- Sélection de la période -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-lg-4">
            <form method="get" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Date de début</label>
                    <input type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control form-control-modern" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Date de fin</label>
                    <input type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control form-control-modern" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary-gradient w-100">
                        <i class="fas fa-filter me-2"></i> Analyser
                    </button>
                </div>
            </form>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <a asp-action="Index" asp-route-startDate="@today.ToString("yyyy-MM-dd")" asp-route-endDate="@today.ToString("yyyy-MM-dd")" class="btn btn-sm btn-soft">Aujourd'hui</a>
                <a asp-action="Index" asp-route-startDate="@weekStart.ToString("yyyy-MM-dd")" asp-route-endDate="@today.ToString("yyyy-MM-dd")" class="btn btn-sm btn-soft">7 derniers jours</a>
                <a asp-action="Index" asp-route-startDate="@monthStart.ToString("yyyy-MM-dd")" asp-route-endDate="@today.ToString("yyyy-MM-dd")" class="btn btn-sm btn-soft">Mois en cours</a>
            </div>
        </div>
    </div>

    <!-- KPI de la période -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card-dashboard">
                <div class="icon-wrapper orange"><i class="fas fa-coins"></i></div>
                <div class="stat-number">@Model.TotalSales.ToString("N2") $</div>
                <div class="stat-label">Chiffre d'affaires (@Model.Sales.Count vente(s))</div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card-dashboard">
                <div class="icon-wrapper blue"><i class="fas fa-tags"></i></div>
                <div class="stat-number">@Model.GrossProfit.ToString("N2") $</div>
                <div class="stat-label">Marge brute sur ventes</div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card-dashboard">
                <div class="icon-wrapper red"><i class="fas fa-wallet"></i></div>
                <div class="stat-number text-danger">@Model.TotalExpenses.ToString("N2") $</div>
                <div class="stat-label">Dépenses (@Model.Expenses.Count opération(s))</div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card-dashboard">
                <div class="icon-wrapper green"><i class="fas fa-chart-line"></i></div>
                <div class="stat-number @(Model.NetProfit >= 0 ? "text-success" : "text-danger")">@Model.NetProfit.ToString("N2") $</div>
                <div class="stat-label">Bénéfice Net réel</div>
            </div>
        </div>
    </div>

    <!-- Répartition moyens de paiement & catégories dépenses -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0"><i class="fas fa-credit-card text-primary me-2"></i>Ventes par moyen de paiement</h5>
                </div>
                <div class="card-body px-4">
                    @if (Model.SalesByPaymentMethod.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var kv in Model.SalesByPaymentMethod.OrderByDescending(x => x.Value))
                            {
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span>@kv.Key</span>
                                    <strong class="text-success">@kv.Value.ToString("N2") $</strong>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Aucun encaissement sur la période sélectionnée.</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0"><i class="fas fa-layer-group text-danger me-2"></i>Dépenses par catégorie</h5>
                </div>
                <div class="card-body px-4">
                    @if (Model.ExpensesByCategory.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var kv in Model.ExpensesByCategory.OrderByDescending(x => x.Value))
                            {
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span>@kv.Key</span>
                                    <strong class="text-danger">@kv.Value.ToString("N2") $</strong>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Aucune dépense sur la période sélectionnée.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
