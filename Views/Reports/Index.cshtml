@model BusinessReport
@{
    ViewData["Title"] = "Rapports";
    string Display(decimal value) => Money.Display(value, Model.Currency);
    var from = Model.Period.Start.ToString("yyyy-MM-dd");
    var to = Model.Period.End.ToString("yyyy-MM-dd");
    var balances = Model.Outstanding.ToList();
    var exported = new[] { ("pdf", "PDF"), ("xlsx", "Excel"), ("csv", "CSV") };
}
<div class="page-heading">
    <div><p class="section-eyebrow">Pilotage</p><h1>Rapports d’activité</h1><p>Consultez et exportez les mêmes chiffres que sur le tableau de bord.</p></div>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var (format, label) in exported) { <a asp-action="Export" asp-route-format="@format" asp-route-startDate="@from" asp-route-endDate="@to" asp-route-currency="@Model.Currency" class="btn @(format == "pdf" ? "btn-accent" : "btn-secondary-outline")">@label</a> }
    </div>
</div>
<partial name="_PeriodFilter" model="Model" />
<div class="metric-grid mb-4">
    @foreach (var item in new[] { ("Chiffre d’affaires", Model.Revenue), ("Ventes", Model.Invoiced), ("Achats", Model.Purchased), ("Recettes encaissées", Model.Received), ("Dépenses", Model.Expensed), ("Règlements fournisseurs", Model.SupplierPayments), ("Créances à la clôture", Model.Receivables), ("Dettes à la clôture", Model.Payables) })
    { <article class="panel-card metric-tile"><h2 class="h6 mb-2">@item.Item1</h2><strong class="metric-value num">@Display(item.Item2)</strong></article> }
</div>
<div class="dashboard-columns report-pair mb-3">
    <section class="panel-card"><h2 class="h6 p-3 p-md-4 mb-0">Ventes de la période</h2>
        @if (Model.Sales.Count == 0) { <p class="text-slate px-3 pb-3 mb-0">Aucune vente dans cette devise pour la période.</p> }
        else
        {
            <div class="table-responsive"><table class="table table-ledger"><thead><tr><th>Vente</th><th>Client</th><th class="text-end">Total</th></tr></thead><tbody>
                @foreach (var sale in Model.Sales)
                { <tr><td><a asp-controller="Sales" asp-action="Details" asp-route-id="@sale.Id">@sale.Number</a><div class="text-slate small">@sale.SaleDate.ToString("dd/MM/yyyy")</div></td><td>@(sale.CustomerName ?? "Client de passage")</td><td class="text-end text-nowrap">@Display(sale.FinalPrice)</td></tr> }
            </tbody></table></div>
        }
    </section>
    <section class="panel-card"><h2 class="h6 p-3 p-md-4 mb-0">Achats de la période</h2>
        @if (Model.Purchases.Count == 0) { <p class="text-slate px-3 pb-3 mb-0">Aucun achat dans cette devise pour la période.</p> }
        else
        {
            <div class="table-responsive"><table class="table table-ledger"><thead><tr><th>Achat</th><th>Fournisseur</th><th class="text-end">Total</th></tr></thead><tbody>
                @foreach (var purchase in Model.Purchases)
                { <tr><td><a asp-controller="Purchases" asp-action="Details" asp-route-id="@purchase.Id">@purchase.Number</a><div class="text-slate small">@purchase.RecordedAt.ToString("dd/MM/yyyy")</div></td><td>@purchase.SupplierName</td><td class="text-end text-nowrap">@Display(purchase.Total)</td></tr> }
            </tbody></table></div>
        }
    </section>
</div>
<div class="dashboard-columns report-pair mb-3">
    <section class="panel-card"><h2 class="h6 p-3 p-md-4 mb-0">Produits les plus vendus</h2>
        @if (!Model.TopProducts.Any()) { <p class="px-3 pb-3 text-slate mb-0">Aucun produit vendu sur la période.</p> }
        else
        {
            <div class="table-responsive"><table class="table table-ledger"><thead><tr><th>Produit</th><th class="text-end">Unités vendues</th></tr></thead><tbody>
                @foreach (var product in Model.TopProducts) { <tr><td>@product.Name</td><td class="text-end">@product.Units</td></tr> }
            </tbody></table></div>
        }
    </section>
    <section class="panel-card"><div class="p-3 p-md-4"><h2 class="h6 mb-1">État actuel du stock</h2><p class="text-slate small mb-0">Coût catalogue : @Money.Display(Model.StockValue, Model.Settings.PrimaryCurrencyCode)</p></div>
        @if (Model.Stock.Count == 0) { <p class="px-3 pb-3 text-slate mb-0">Le catalogue est vide.</p> }
        else
        {
            <div class="table-responsive"><table class="table table-ledger"><thead><tr><th>Produit</th><th class="text-end">Stock</th><th class="text-end">Valeur</th></tr></thead><tbody>
                @foreach (var product in Model.Stock) { <tr><td><a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">@product.Name</a>@if (product.IsLow) { <div class="text-slate small">Sous le seuil</div> }</td><td class="text-end">@product.Quantity</td><td class="text-end text-nowrap">@Money.Display(product.Value, Model.Settings.PrimaryCurrencyCode)</td></tr> }
            </tbody></table></div>
        }
    </section>
</div>
<section class="panel-card mb-3">
    <div class="p-3 p-md-4"><h2 class="h6 mb-1">Créances clients et dettes fournisseurs</h2><p class="text-slate small mb-0">Soldes des documents au @Model.Period.End.ToString("dd/MM/yyyy") ; les paiements ultérieurs n’y sont pas inclus.</p></div>
    <partial name="_BalanceTable" model="balances" />
</section>
<div class="dashboard-columns report-pair">
    <section class="panel-card"><div class="p-3 p-md-4"><h2 class="h6 mb-1">Encaissements et décaissements</h2><p class="text-slate small mb-0">Date et devise réellement versées.</p></div>
        @if (Model.Payments.Count == 0) { <p class="px-3 pb-3 text-slate mb-0">Aucun règlement pour la période.</p> }
        else
        {
            <div class="table-responsive"><table class="table table-ledger"><thead><tr><th>Date</th><th>Type / moyen</th><th class="text-end">Montant</th></tr></thead><tbody>
                @foreach (var payment in Model.Payments)
                {
                    var kind = payment.PurchaseId.HasValue ? "Fournisseur" : payment.SaleId.HasValue ? "Vente" : payment.DebtId.HasValue ? "Créance manuelle" : "Recette diverse";
                    <tr><td>@payment.RecordedAt.ToString("dd/MM/yyyy")</td><td>@kind<div class="small text-slate">@PaymentMeans.Display(payment.Method)</div></td><td class="text-end text-nowrap">@(payment.PurchaseId.HasValue ? "−" : "+") @Display(payment.Amount)</td></tr>
                }
            </tbody></table></div>
        }
    </section>
    <section class="panel-card"><h2 class="h6 p-3 p-md-4 mb-0">Dépenses de la période</h2>
        @if (Model.Expenses.Count == 0) { <p class="px-3 pb-3 text-slate mb-0">Aucune dépense pour la période.</p> }
        else
        {
            <div class="table-responsive"><table class="table table-ledger"><thead><tr><th>Dépense</th><th>Catégorie</th><th class="text-end">Montant</th></tr></thead><tbody>
                @foreach (var expense in Model.Expenses)
                { <tr><td><a asp-controller="Expenses" asp-action="Details" asp-route-id="@expense.Id">@expense.Description</a><div class="text-slate small">@expense.Date.ToString("dd/MM/yyyy")</div></td><td>@expense.Category</td><td class="text-end text-nowrap">@Display(expense.Amount)</td></tr> }
            </tbody></table></div>
        }
    </section>
</div>
