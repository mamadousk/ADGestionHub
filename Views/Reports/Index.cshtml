@model AdGestionHub.Models.ReportViewModel
@{
    var ctx = await TenantCtx.GetContextAsync();
    ViewData["Title"] = L["Nav.Reports"];
    var today = DateTime.UtcNow.Date;
    var weekStart = today.AddDays(-6);
    var monthStart = new DateTime(today.Year, today.Month, 1);
    var taxFilter = (ViewBag.TaxFilter as string) ?? "";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h4 mb-1">@L["Nav.Reports"]</h1>
        <p class="text-slate small mb-0">@Model.StoreName — @L.T("Synthèse comptable et analytique", "Accounting and financial analytics") (@Model.CurrencyCode)</p>
    </div>
    <a asp-action="GenerateDailyReport"
       asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
       asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
       class="btn btn-accent">
        @LucideIcons.Svg("download", 16, "me-1")
        <span>@L["Action.DownloadPdf"]</span>
    </a>
</div>

<div class="panel-card p-3 p-lg-4 mb-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">@L.T("Du", "Start Date")</label>
            <input type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control num" />
        </div>
        <div class="col-md-3">
            <label class="form-label">@L.T("Au", "End Date")</label>
            <input type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control num" />
        </div>
        @if (Model.IsVatEnabled)
        {
            <div class="col-md-3">
                <label class="form-label">@L.T("Régime de TVA", "Tax Filter")</label>
                <select name="taxFilter" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(taxFilter))">@L.T("Toutes les opérations", "All transactions")</option>
                    <option value="taxed" selected="@(taxFilter == "taxed")">@L.T("Opérations taxées (TVA > 0)", "Taxable (VAT > 0)")</option>
                    <option value="exempt" selected="@(taxFilter == "exempt")">@L.T("Opérations exonérées (TVA = 0)", "Tax-exempt (VAT = 0)")</option>
                </select>
            </div>
        }
        <div class="@(Model.IsVatEnabled ? "col-md-3" : "col-md-6") d-flex gap-2">
            <button type="submit" class="btn btn-secondary-outline w-100">@L["Action.Filter"]</button>
        </div>
    </form>
    <div class="d-flex flex-wrap gap-2 mt-3">
        <a asp-action="Index" asp-route-startDate="@today.ToString("yyyy-MM-dd")" asp-route-endDate="@today.ToString("yyyy-MM-dd")" class="btn btn-secondary-outline btn-sm">@L.T("Aujourd'hui", "Today")</a>
        <a asp-action="Index" asp-route-startDate="@weekStart.ToString("yyyy-MM-dd")" asp-route-endDate="@today.ToString("yyyy-MM-dd")" class="btn btn-secondary-outline btn-sm">@L.T("7 derniers jours", "Last 7 days")</a>
        <a asp-action="Index" asp-route-startDate="@monthStart.ToString("yyyy-MM-dd")" asp-route-endDate="@today.ToString("yyyy-MM-dd")" class="btn btn-secondary-outline btn-sm">@L.T("Mois en cours", "Month to date")</a>
    </div>
</div>

<!-- KPI de la période -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label">
                @(Model.IsVatEnabled ? L.T("Chiffre d'affaires TTC", "Revenue (Incl. Tax)") : L.T("Chiffre d'affaires", "Total Revenue"))
            </div>
            <div class="kpi-value">@ctx.FormatPrimary(Model.TotalSales)</div>
            @if (Model.IsVatEnabled)
            {
                <div class="kpi-sub num">
                    @L["Doc.SubtotalExclTax"] : @ctx.FormatPrimary(Model.TotalSalesExclTax) · TVA : @ctx.FormatPrimary(Model.TotalVatCollected)
                </div>
            }
            else
            {
                <div class="kpi-sub num">@Model.Sales.Count @L.T("opération(s)", "sale(s)")</div>
            }
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label">@L.T("Marge brute sur ventes", "Gross Margin")</div>
            <div class="kpi-value">@ctx.FormatPrimary(Model.GrossProfit)</div>
            <div class="kpi-sub">@L.T("Hors charges fixes", "Before operating expenses")</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label">@L["Nav.Expenses"]</div>
            <div class="kpi-value text-sober-red">@ctx.FormatPrimary(Model.TotalExpenses)</div>
            <div class="kpi-sub num">@Model.Expenses.Count @L.T("écriture(s)", "entry(ies)")</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="kpi-card">
            <div class="kpi-label">@L["Dashboard.NetProfit"]</div>
            <div class="kpi-value @(Model.NetProfit >= 0 ? "text-forest" : "text-sober-red")">@ctx.FormatPrimary(Model.NetProfit)</div>
            <div class="kpi-sub">@L.T("Résultat net de la période", "Period net income")</div>
        </div>
    </div>
</div>

@if (Model.SalesByCurrency.Count > 1)
{
    <div class="panel-card p-3 mb-4">
        <div class="small fw-semibold mb-2">@L.T("Opérations par devise d'origine (non-rétroactivité)", "Historical operations by original currency")</div>
        <div class="d-flex flex-wrap gap-3 num small">
            @foreach (var kv in Model.SalesByCurrency)
            {
                var cProf = CountryProfileCatalog.GetCurrency(kv.Key);
                <span class="status-pill">@kv.Key : @ctx.FormatHistorical(kv.Value, cProf.Code, cProf.Decimals, cProf.Symbol)</span>
            }
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-6">
        <div class="panel-card p-4 h-100">
            <h2 class="h6 mb-3">@L.T("Encaissements par moyen de paiement", "Collections by Payment Method") (@Model.CurrencyCode)</h2>
            @if (Model.SalesByPaymentMethod.Any())
            {
                foreach (var kv in Model.SalesByPaymentMethod.OrderByDescending(x => x.Value))
                {
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="small">@kv.Key</span>
                        <span class="num fw-semibold text-forest">@ctx.FormatPrimary(kv.Value)</span>
                    </div>
                }
            }
            else
            {
                <p class="text-slate small mb-0">@L.T("Aucun encaissement sur la période sélectionnée.", "No collections in selected period.")</p>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="panel-card p-4 h-100">
            <h2 class="h6 mb-3">@L.T("Dépenses par catégorie", "Expenses by Category") (@Model.CurrencyCode)</h2>
            @if (Model.ExpensesByCategory.Any())
            {
                foreach (var kv in Model.ExpensesByCategory.OrderByDescending(x => x.Value))
                {
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <span class="small">@kv.Key</span>
                        <span class="num fw-semibold text-sober-red">@ctx.FormatPrimary(kv.Value)</span>
                    </div>
                }
            }
            else
            {
                <p class="text-slate small mb-0">@L.T("Aucune dépense sur la période sélectionnée.", "No expenses in selected period.")</p>
            }
        </div>
    </div>
</div>
