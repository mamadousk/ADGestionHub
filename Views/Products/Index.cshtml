@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Produits et stocks";
    var isAdmin = User.IsInRole("Admin");
    var currency = (await TenantCtx.GetContextAsync()).PrimaryCurrency.Code;
    var status = ViewData["Status"] as string;
}
<div class="page-heading">
    <div><p class="section-eyebrow">Catalogue</p><h1>Produits et stocks</h1><p>Prix du catalogue en @currency. Les ventes et les réceptions actualisent les quantités.</p></div>
    @if (isAdmin) { <a asp-action="Create" class="btn btn-accent">@LucideIcons.Svg("plus", 17, "me-1") Nouveau produit</a> }
</div>
<form method="get" asp-action="Index" class="panel-card filter-panel mb-3">
    <div class="filter-grow"><label for="productSearch" class="form-label">Rechercher</label><input id="productSearch" name="search" value="@ViewData["Search"]" class="form-control" type="search" placeholder="Nom, référence ou catégorie" /></div>
    <div><label for="stockState" class="form-label">État du stock</label><select id="stockState" name="status" class="form-select">
        <option value="">Produits actifs</option><option value="low" selected="@(status == "low")">Sous le seuil</option><option value="out" selected="@(status == "out")">En rupture</option><option value="ok" selected="@(status == "ok")">Disponible</option><option value="archived" selected="@(status == "archived")">Archivés</option>
    </select></div>
    <button type="submit" class="btn btn-secondary-outline">Filtrer</button>
</form>
@if (Model.Count == 0)
{
    <div class="panel-card empty-panel"><h2 class="h5">Aucun produit dans cette liste</h2><p class="text-slate mb-0">Changez de filtre ou commencez à renseigner votre catalogue.</p></div>
}
else
{
    <div class="panel-card table-responsive"><table class="table table-ledger">
        <thead><tr><th scope="col">Produit</th><th scope="col">Catégorie</th>
            @if (isAdmin) { <th scope="col" class="text-end">Coût d’achat</th> }
            <th scope="col" class="text-end">Prix de vente</th><th scope="col" class="text-end">Stock</th><th scope="col">État</th></tr></thead>
        <tbody>
        @foreach (var product in Model)
        {
            <tr><td><a asp-action="Details" asp-route-id="@product.Id" class="fw-semibold">@product.Name</a><div class="text-slate small">@product.Sku</div></td><td>@(product.Category ?? "—")</td>
                @if (isAdmin) { <td class="text-end text-nowrap">@Money.Display(product.PurchasePrice, currency)</td> }
                <td class="text-end text-nowrap">@Money.Display(product.SalePrice, currency)</td><td class="text-end">@product.StockQuantity</td><td>
                    @if (product.IsArchived) { <span class="status-pill">Archivé</span> }
                    else if (product.StockQuantity == 0) { <span class="status-pill danger">Rupture</span> }
                    else if (product.StockQuantity <= product.StockAlertThreshold) { <span class="status-pill warning">Stock bas</span> }
                    else { <span class="status-pill success">Disponible</span> }
                </td></tr>
        }
        </tbody>
    </table></div>
}
