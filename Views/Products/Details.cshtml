@model Product
@{
    var ctx = await TenantCtx.GetContextAsync();
    ViewData["Title"] = Model.Name;
    var isAdmin = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
    var threshold = Model.LowStockThreshold > 0 ? Model.LowStockThreshold : Model.StockAlertThreshold;
    var margin = Model.SalePrice - Model.PurchasePrice;
    var effectiveVat = Model.VatRate ?? ctx.DefaultVatRate;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="panel-card p-4">
            <div class="d-flex justify-content-between align-items-start mb-3 pb-3 border-bottom">
                <div>
                    <h1 class="h5 mb-1">@Model.Name</h1>
                    @if (!string.IsNullOrWhiteSpace(Model.Sku))
                    {
                        <div class="text-slate small num">SKU : @Model.Sku</div>
                    }
                </div>
                @if (Model.StockQuantity <= 0)
                {
                    <span class="status-pill danger">@L.T("Rupture", "Out of stock")</span>
                }
                else if (Model.StockQuantity <= threshold)
                {
                    <span class="status-pill warning">@L.T("Stock bas", "Low stock")</span>
                }
                else
                {
                    <span class="status-pill success">@L.T("Disponible", "In stock")</span>
                }
            </div>

            <div class="row g-3 num">
                <div class="col-6">
                    <div class="text-slate small">@(ctx.IsVatEnabled ? L.T("Prix de vente HT", "Sale Price Excl. Tax") : L.T("Prix de vente", "Sale Price"))</div>
                    <div class="h5 fw-semibold mb-0">@ctx.FormatPrimary(Model.SalePrice)</div>
                </div>

                @if (ctx.IsVatEnabled)
                {
                    <div class="col-6">
                        <div class="text-slate small">@L.T("Taux de TVA", "VAT Rate")</div>
                        <div class="h5 fw-semibold mb-0">@effectiveVat.ToString("0.##")%</div>
                    </div>
                }

                @if (isAdmin)
                {
                    <div class="col-6">
                        <div class="text-slate small">@L.T("Coût d'achat", "Unit Cost")</div>
                        <div class="fw-medium">@ctx.FormatPrimary(Model.PurchasePrice)</div>
                    </div>
                    <div class="col-6">
                        <div class="text-slate small">@L.T("Marge unitaire", "Unit Margin")</div>
                        <div class="fw-semibold @(margin >= 0 ? "text-forest" : "text-sober-red")">@ctx.FormatPrimary(margin)</div>
                    </div>
                }

                <div class="col-6">
                    <div class="text-slate small">@L.T("Stock disponible", "Current Stock")</div>
                    <div class="fw-semibold">@Model.StockQuantity</div>
                </div>

                <div class="col-6">
                    <div class="text-slate small">@L.T("Seuil d'alerte", "Alert Threshold")</div>
                    <div class="fw-medium">@threshold</div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Variations))
                {
                    <div class="col-12">
                        <div class="text-slate small">@L.T("Variantes", "Variants")</div>
                        <div>@Model.Variations</div>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <a asp-action="Index" class="btn btn-secondary-outline">@L["Action.Back"]</a>
                @if (isAdmin)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-accent">@L["Action.Edit"]</a>
                }
            </div>
        </div>
    </div>
</div>
