@model Product
@{
    var ctx = await TenantCtx.GetContextAsync();
    ViewData["Title"] = L.T("Supprimer le produit", "Delete Product");
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="panel-card p-4">
            <h1 class="h5 mb-2">@ViewData["Title"]</h1>
            <p class="text-slate small mb-3">
                @L.T(
                    "L'article sera retiré du catalogue actif. Les reçus et factures historiques conserveront leur désignation et leur prix d'origine.",
                    "The item will be removed from your active catalog. Historical receipts and invoices will retain their original description and price.")
            </p>
            <div class="p-3 rounded border mb-4" style="background: var(--bg-canvas);">
                <div class="fw-semibold">@Model.Name</div>
                <div class="text-slate small num">@ctx.FormatPrimary(Model.SalePrice) · @L.T("Stock :", "Stock:") @Model.StockQuantity</div>
            </div>
            <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-secondary-outline">@L["Action.Cancel"]</a>
                <button type="submit" class="btn btn-danger-outline">@L["Action.Delete"]</button>
            </form>
        </div>
    </div>
</div>
