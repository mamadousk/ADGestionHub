@model ProductFormViewModel
@{
    var id = ViewData["ProductId"] as int?;
    ViewData["Title"] = id.HasValue ? "Modifier le produit" : "Nouveau produit";
}
<div class="page-heading"><div><p class="section-eyebrow"><a asp-action="Index">Produits et stocks</a></p><h1>@ViewData["Title"]</h1><p>Enregistrez les informations et les prix de l’article en @Model.CatalogCurrencyCode.</p></div></div>
<form asp-action="@(id.HasValue ? "Edit" : "Create")" asp-route-id="@id" method="post" class="panel-card p-3 p-md-4 compact-form">
    <input asp-for="CatalogCurrencyCode" type="hidden" />
    <div asp-validation-summary="All" class="validation-banner" role="alert"></div>
    <div class="row g-3">
        <div class="col-12"><label asp-for="Name" class="form-label">Nom du produit</label><input asp-for="Name" class="form-control" required /></div>
        <div class="col-sm-6"><label asp-for="Sku" class="form-label">Référence (facultatif)</label><input asp-for="Sku" class="form-control" /></div>
        <div class="col-sm-6"><label asp-for="Category" class="form-label">Catégorie (facultatif)</label><input asp-for="Category" class="form-control" /></div>
        <div class="col-12"><label asp-for="Description" class="form-label">Description (facultatif)</label><textarea asp-for="Description" class="form-control" rows="2"></textarea></div>
        <div class="col-sm-6"><label asp-for="PurchasePrice" class="form-label">Prix d’achat unitaire (@Model.CatalogCurrencyCode)</label><input asp-for="PurchasePrice" class="form-control num" inputmode="decimal" required /></div>
        <div class="col-sm-6"><label asp-for="SalePrice" class="form-label">Prix de vente unitaire (@Model.CatalogCurrencyCode)</label><input asp-for="SalePrice" class="form-control num" inputmode="decimal" required /></div>
        @if (!id.HasValue)
        {
            <div class="col-sm-6"><label asp-for="StockQuantity" class="form-label">Quantité initiale</label><input asp-for="StockQuantity" class="form-control num" type="number" min="0" max="10000000" required /></div>
        }
        <div class="col-sm-6"><label asp-for="StockAlertThreshold" class="form-label">Seuil d’alerte de stock</label><input asp-for="StockAlertThreshold" class="form-control num" type="number" min="0" max="1000000" required /></div>
    </div>
    @if (id.HasValue) { <p class="form-text mt-3">Pour corriger la quantité, utilisez le mouvement de stock sur la fiche du produit.</p> }
    <div class="form-actions"><a asp-action="Index" class="btn btn-secondary-outline">Annuler</a><button type="submit" class="btn btn-accent">Enregistrer le produit</button></div>
</form>
