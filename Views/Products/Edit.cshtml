@model Product
@{
    var ctx = await TenantCtx.GetContextAsync();
    ViewData["Title"] = L.T("Modifier le produit", "Edit Product");
    var sym = ctx.PrimaryCurrency.Symbol;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="panel-card p-4">
            <h1 class="h5 mb-1">@ViewData["Title"]</h1>
            <p class="text-slate small mb-4">@Model.Name</p>

            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label">@L.T("Désignation de l'article", "Product Name") *</label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-sober-red small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Sku" class="form-label">@L.T("Référence / SKU", "SKU / Code")</label>
                        <input asp-for="Sku" class="form-control num" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PurchasePrice" class="form-label">@L.T("Prix d'achat unitaire", "Unit Cost") (@sym)</label>
                        <input asp-for="PurchasePrice" class="form-control num" type="number" step="@ctx.NumberInputStep" min="0" />
                        <span asp-validation-for="PurchasePrice" class="text-sober-red small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SalePrice" class="form-label">
                            @(ctx.IsVatEnabled ? L.T("Prix de vente unitaire HT", "Unit Sale Price (Excl. Tax)") : L.T("Prix de vente unitaire", "Unit Sale Price")) (@sym)
                        </label>
                        <input asp-for="SalePrice" class="form-control num" type="number" step="@ctx.NumberInputStep" min="0" />
                        <span asp-validation-for="SalePrice" class="text-sober-red small"></span>
                    </div>

                    @if (ctx.IsVatEnabled)
                    {
                        <div class="col-md-6">
                            <label asp-for="VatRate" class="form-label">@L.T("Taux de TVA applicable (%)", "Product VAT Rate (%)")</label>
                            <input asp-for="VatRate" class="form-control num" type="number" step="0.01" min="0" max="100" />
                        </div>
                    }

                    <div class="col-md-6">
                        <label asp-for="StockQuantity" class="form-label">@L.T("Quantité en stock", "Stock Quantity")</label>
                        <input asp-for="StockQuantity" class="form-control num" type="number" min="0" />
                        <span asp-validation-for="StockQuantity" class="text-sober-red small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StockAlertThreshold" class="form-label">@L.T("Seuil d'alerte stock", "Low Stock Threshold")</label>
                        <input asp-for="StockAlertThreshold" class="form-control num" type="number" min="0" />
                        <span asp-validation-for="StockAlertThreshold" class="text-sober-red small"></span>
                    </div>

                    <div class="@(ctx.IsVatEnabled ? "col-md-6" : "col-12")">
                        <label asp-for="Variations" class="form-label">@L.T("Variantes / Conditionnement", "Variants / Packaging")</label>
                        <input asp-for="Variations" class="form-control" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-secondary-outline">@L["Action.Cancel"]</a>
                    <button type="submit" class="btn btn-accent">@L["Action.Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
