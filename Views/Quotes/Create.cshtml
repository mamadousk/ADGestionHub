@model QuoteInput
@{
    var id = ViewData["QuoteId"] as int?;
    ViewData["Title"] = id.HasValue ? "Modifier le brouillon" : "Nouveau devis";
    var contacts = (IReadOnlyList<ContactPick>)ViewData["TradeContacts"]!;
    var products = (IReadOnlyList<CatalogPick>)ViewData["TradeProducts"]!;
}
<div class="page-heading">
    <div><p class="section-eyebrow">Documents commerciaux</p><h1>@ViewData["Title"]</h1><p>Un devis ne modifie ni le stock ni la trésorerie avant sa conversion.</p></div>
    <a asp-action="Index" class="btn btn-secondary-outline">Tous les devis</a>
</div>
@if (products.Count == 0)
{
    <div class="panel-card empty-panel"><h2 class="h5">Le catalogue est vide</h2><p class="text-slate">Ajoutez un produit avant de préparer un devis.</p>
        @if (User.IsInRole("Admin")) { <a asp-controller="Products" asp-action="Create" class="btn btn-accent">Ajouter un produit</a> }
    </div>
}
else
{
    <form asp-action="@(id.HasValue ? "Edit" : "Create")" asp-route-id="@id" method="post" data-trade>
        <div asp-validation-summary="All" class="validation-banner" role="alert"></div>
        <section class="panel-card p-3 p-md-4 mb-3">
            <h2 class="h6 mb-3">Client et validité</h2>
            <div class="row g-3">
                <div class="col-md-4"><label asp-for="ClientId" class="form-label">Client du répertoire</label><select asp-for="ClientId" class="form-select">
                    <option value="">Choisir un client (facultatif)</option>
                    @foreach (var contact in contacts) { <option value="@contact.Id">@contact.Name</option> }
                </select></div>
                <div class="col-md-4"><label asp-for="CustomerName" class="form-label">Ou nom du client</label><input asp-for="CustomerName" class="form-control" /></div>
                <div class="col-md-4"><partial name="_TradeCurrency" model="Model" /></div>
                <div class="col-md-4"><label asp-for="ValidUntil" class="form-label">Valable jusqu’au</label><input asp-for="ValidUntil" type="date" class="form-control" /></div>
                <div class="col-md-8"><label asp-for="Notes" class="form-label">Notes pour le client</label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
            </div>
        </section>
        <partial name="_TradeLines" model="Model" />
        <div class="panel-card p-3 p-md-4">
            @if (id.HasValue) { <p class="text-slate small">À l’enregistrement, les prix du brouillon sont recalculés au tarif et au taux en vigueur.</p> }
            <div class="trade-totals mt-0 pt-0 border-0"><div><span>Total du devis</span><strong class="num" data-trade-total aria-live="polite">—</strong></div>
                <div class="d-flex flex-wrap gap-2"><button type="submit" name="Publish" value="false" class="btn btn-secondary-outline">Enregistrer le brouillon</button><button type="submit" name="Publish" value="true" class="btn btn-accent">Émettre le devis</button></div>
            </div>
        </div>
    </form>
}
@section Scripts { <script src="~/js/trade.js" asp-append-version="true"></script> }
