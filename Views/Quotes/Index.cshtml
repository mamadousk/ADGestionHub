@model IReadOnlyList<Quote>
@{ ViewData["Title"] = "Devis"; }
<div class="page-heading">
    <div><p class="section-eyebrow">Documents commerciaux</p><h1>Devis</h1><p>Préparez un brouillon, émettez un devis et convertissez-le quand votre client accepte.</p></div>
    <a asp-action="Create" class="btn btn-accent">@LucideIcons.Svg("plus", 17, "me-1") Nouveau devis</a>
</div>
@if (Model.Count == 0)
{
    <div class="panel-card empty-panel"><h2 class="h5">Aucun devis enregistré</h2><p class="text-slate mb-0">Tous vos brouillons et devis émis apparaîtront ici.</p></div>
}
else
{
    <div class="panel-card table-responsive"><table class="table table-ledger"><thead><tr><th scope="col">Devis</th><th scope="col">Client</th><th scope="col">Validité</th><th scope="col" class="text-end">Total</th><th scope="col">État</th></tr></thead><tbody>
        @foreach (var quote in Model)
        {
            var status = quote.Status == QuoteStatus.Pending && CommerceOperations.IsExpired(quote) ? "Expiré" : QuoteStatus.Label(quote.Status);
            <tr><td><a class="fw-semibold" asp-action="Details" asp-route-id="@quote.Id">@quote.DocumentNumber</a><div class="text-slate small">@quote.CreatedAt.ToString("dd/MM/yyyy")</div></td>
                <td>@quote.CustomerName</td><td>@(quote.ValidUntil?.ToString("dd/MM/yyyy") ?? "—")</td><td class="text-end text-nowrap">@Money.Display(quote.TotalAmount, quote.CurrencyCode)</td><td><span class="status-pill">@status</span></td></tr>
        }
    </tbody></table></div>
}
