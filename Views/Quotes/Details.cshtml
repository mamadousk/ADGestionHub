@model Quote
@{
    ViewData["Title"] = $"Devis {Model.DocumentNumber}";
    var settings = (await TenantCtx.GetContextAsync()).Settings;
    var expired = Model.Status == QuoteStatus.Pending && CommerceOperations.IsExpired(Model);
    var lines = new CommercialTable(Model.Items.Select(i => new CommercialLine(i.ProductName, i.Quantity, i.UnitPrice, i.LineTotal)), Model.CurrencyCode);
    var rate = PdfReportService.HistoricalRate(Model.CdfPerUsd, Model.SecondaryCurrencyCode, Model.ExchangeRateToSecondary, Model.CurrencyCode);
}
<div class="page-heading no-print">
    <div><p class="section-eyebrow"><a asp-action="Index">Devis</a></p><h1>Devis @Model.DocumentNumber</h1><p>Les prix et la devise restent identiques lors de la conversion d’un devis accepté.</p></div>
    <div class="d-flex flex-wrap gap-2"><button type="button" class="btn btn-secondary-outline" onclick="window.print()">Imprimer</button><a asp-action="DownloadPdf" asp-route-id="@Model.Id" class="btn btn-accent">Télécharger le PDF</a></div>
</div>
<section class="panel-card print-document mb-3">
    <div class="d-flex flex-wrap justify-content-between gap-3 p-3 p-md-4">
        <div><p class="section-eyebrow mb-1">@settings.StoreName</p><h2 class="h5 mb-1">Devis @Model.DocumentNumber</h2><p class="text-slate mb-1">@Model.CreatedAt.ToString("dd/MM/yyyy") · @Model.CurrencyCode</p><span class="status-pill">@(expired ? "Expiré" : QuoteStatus.Label(Model.Status))</span></div>
        <div class="small"><strong>Client : @Model.CustomerName</strong><div>@Model.CustomerPhone</div>@if (Model.ValidUntil is DateTime end) { <div>Valable jusqu’au @end.ToString("dd/MM/yyyy")</div> }</div>
    </div>
    <partial name="_CommercialLines" model="lines" />
    <div class="doc-totals p-3 p-md-4">
        @if (Model.TaxAmount != 0) { <div><span>Taxe historique</span><b>@Money.Display(Model.TaxAmount, Model.CurrencyCode)</b></div> }
        <div class="total-line"><span>Total du devis</span><b>@Money.Display(Model.TotalAmount, Model.CurrencyCode)</b></div>
        @if (rate != null) { <p class="text-slate small mb-0 mt-2">Taux enregistré : @rate</p> }
    </div>
    @if (Model.Notes != null) { <p class="px-3 px-md-4 mb-2">@Model.Notes</p> }
    <p class="border-top p-3 p-md-4 mb-0 text-slate small">Document commercial ordinaire — non normalisé DGI.</p>
</section>
<div class="d-flex flex-wrap gap-2 no-print">
    @if (Model.Status == QuoteStatus.Draft) { <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-accent">Reprendre le brouillon</a> }
    else if (Model.Status == QuoteStatus.Pending && !expired)
    {
        <form asp-action="Accept" asp-route-id="@Model.Id" method="post"><button type="submit" class="btn btn-accent">Marquer comme accepté</button></form>
    }
    else if (Model.Status == QuoteStatus.Accepted)
    {
        <form asp-action="ConvertToSale" asp-route-id="@Model.Id" method="post"><button type="submit" class="btn btn-accent">Transformer en vente (non réglée)</button></form>
    }
    else if (Model.ConvertedSaleId is int saleId) { <a asp-controller="Sales" asp-action="Details" asp-route-id="@saleId" class="btn btn-accent">Voir la vente liée</a> }
</div>
