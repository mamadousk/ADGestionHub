@page
@model RegisterConfirmationModel
@{ ViewData["Title"] = "Confirmation de l’adresse e-mail"; }
<div class="container py-4">
    <h1>Confirmation de l’adresse e-mail</h1>
    <p>Si vous avez reçu un message de confirmation, ouvrez le lien qu’il contient.</p>
    <a asp-page="./Login" class="btn btn-accent">Aller à la connexion</a>
</div>
