@page
@model LoginWithEmailModel
@{
    ViewData["Title"] = "Connexion par code e-mail";
}

<div class="py-4 auth-shell">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="panel-card auth-card p-4 p-md-5">
                <h1 class="h5 mb-2">@ViewData["Title"]</h1>
                <p class="text-slate small mb-4">
                    Saisissez votre adresse e-mail. Nous vous enverrons un code de connexion à 6 chiffres, valable quelques minutes.
                </p>

                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Adresse e-mail</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="nom@entreprise.com" />
                        <span asp-validation-for="Input.Email" class="text-sober-red small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label small text-slate" asp-for="Input.RememberMe">Maintenir la session active</label>
                    </div>

                    <button type="submit" class="btn btn-accent w-100 py-2">Envoyer le code</button>
                </form>

                <div class="mt-4 pt-3 border-top text-center small text-slate">
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-orange fw-medium text-decoration-none">
                        Se connecter avec un mot de passe
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
