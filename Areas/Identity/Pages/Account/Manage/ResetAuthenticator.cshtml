@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = L.T("Réinitialiser la clé TOTP", "Reset Authenticator Key");
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h2 class="h5 fw-semibold mb-1">@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="alert alert-warning mb-3 small">
    @L.T("La réinitialisation désactive temporairement la double authentification jusqu'à la reconfiguration.", "Resetting disables 2FA until you reconfigure your authenticator app.")
</div>

<form id="reset-authenticator-form" method="post">
    <button id="reset-authenticator-button" class="btn btn-danger-outline">@L.T("Réinitialiser la clé", "Reset key")</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
