@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="mb-3">
    <h1 class="h4 mb-1">@L["Nav.Profile"]</h1>
    <p class="text-slate small mb-0">@L.T("Sécurité du compte et préférences personnelles", "Account security and personal preferences")</p>
</div>

<div class="row g-4">
    <div class="col-lg-3">
        <div class="panel-card p-2">
            <partial name="_ManageNav" />
        </div>
    </div>
    <div class="col-lg-9">
        <div class="panel-card p-4">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
