@page
@model IndexModel
@{
    ViewData["Title"] = L.T("Profil", "Profile");
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h2 class="h5 fw-semibold mb-1">@ViewData["Title"]</h2>
<p class="text-slate small mb-4">@L.T("Mettez à jour vos coordonnées de compte.", "Update your personal account details.")</p>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="profile-form" method="post" style="max-width: 480px;">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Username" class="form-label">@L.T("Identifiant", "Username")</label>
        <input asp-for="Username" class="form-control" disabled />
    </div>

    <div class="mb-3">
        <label asp-for="Input.PhoneNumber" class="form-label">@L.T("Téléphone", "Phone number")</label>
        <input asp-for="Input.PhoneNumber" class="form-control num" />
        <span asp-validation-for="Input.PhoneNumber" class="text-sober-red small"></span>
    </div>

    <button id="update-profile-button" type="submit" class="btn btn-accent">@L["Action.Save"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
