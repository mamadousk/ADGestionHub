@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = L.T("Application d'authentification", "Authenticator App");
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h2 class="h5 fw-semibold mb-1">@ViewData["Title"]</h2>
<p class="text-slate small mb-4">@L.T("Associez une application TOTP (Microsoft Authenticator, Google Authenticator).", "Pair a TOTP authenticator application.")</p>

<partial name="_StatusMessage" for="StatusMessage" />

<div style="max-width: 560px;">
    <div class="p-3 rounded border mb-3" style="background: var(--bg-canvas);">
        <div id="qrCode"></div>
        <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
        <div class="small text-slate mt-2 num">@L.T("Clé secrète :", "Secret key:") <code>@Model.SharedKey</code></div>
    </div>

    <form id="send-code" method="post">
        <div class="mb-3">
            <label asp-for="Input.Code" class="form-label">@L.T("Code à 6 chiffres", "6-digit verification code")</label>
            <input asp-for="Input.Code" class="form-control num" placeholder="123456" />
            <span asp-validation-for="Input.Code" class="text-sober-red small"></span>
        </div>
        <button type="submit" class="btn btn-accent">@L.T("Vérifier", "Verify")</button>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mt-3" role="alert"></div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
