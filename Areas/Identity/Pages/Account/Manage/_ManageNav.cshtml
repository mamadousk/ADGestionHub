@using AdGestionHub.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

@{
    var user = await UserManager.GetUserAsync(User);
    var isAdmin = User.IsInRole("Admin");
    var isSuperAdmin = User.IsInRole("SuperAdmin");
}

<ul class="nav nav-pills flex-column">
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">
            <i class="fas fa-user me-2"></i> Profil
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.EmailNavClass(ViewContext)" id="email" asp-page="./Email">
            <i class="fas fa-envelope me-2"></i> Email
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">
            <i class="fas fa-key me-2"></i> Mot de passe
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" id="two-factor" asp-page="./TwoFactorAuthentication">
            <i class="fas fa-shield-alt me-2"></i> Authentification à deux facteurs
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData">
            <i class="fas fa-database me-2"></i> Données personnelles
        </a>
    </li>

    @if (isAdmin || isSuperAdmin)
    {
        <li class="nav-item mt-3">
            <a class="nav-link text-primary fw-bold" asp-controller="Settings" asp-action="Index">
                <i class="fas fa-store me-2"></i> Gérer ma boutique
            </a>
        </li>
    }
    @if (isSuperAdmin)
    {
        <li class="nav-item">
            <a class="nav-link text-danger fw-bold" asp-controller="SuperAdmin" asp-action="Index">
                <i class="fas fa-user-shield me-2"></i> Console SuperAdmin
            </a>
        </li>
    }
</ul>