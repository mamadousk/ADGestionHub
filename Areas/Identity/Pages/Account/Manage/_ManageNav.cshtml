@using AdGestionHub.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

@{
    var isAdmin = User.IsInRole("Admin");
    var isSuperAdmin = User.IsInRole("SuperAdmin");
}

<ul class="nav flex-column gap-1">
    <li class="nav-item">
        <a class="sidebar-link @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">
            @L.T("Informations du profil", "Profile details")
        </a>
    </li>
    <li class="nav-item">
        <a class="sidebar-link @ManageNavPages.EmailNavClass(ViewContext)" id="email" asp-page="./Email">
            Email
        </a>
    </li>
    <li class="nav-item">
        <a class="sidebar-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">
            @L.T("Mot de passe", "Password")
        </a>
    </li>
    <li class="nav-item">
        <a class="sidebar-link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" id="two-factor" asp-page="./TwoFactorAuthentication">
            @L.T("Double authentification (2FA)", "Two-factor authentication")
        </a>
    </li>
    <li class="nav-item">
        <a class="sidebar-link @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData">
            @L.T("Données personnelles", "Personal data")
        </a>
    </li>

    @if (isAdmin)
    {
        <li class="nav-item pt-2 mt-2 border-top">
            <a class="sidebar-link" asp-area="" asp-controller="Settings" asp-action="Index">
                @LucideIcons.Svg("settings", 16)
                <span>@L["Nav.MyStore"]</span>
            </a>
        </li>
    }
    @if (isSuperAdmin)
    {
        <li class="nav-item pt-2 mt-2 border-top">
            <a class="sidebar-link" asp-area="" asp-controller="SuperAdmin" asp-action="Index">
                @LucideIcons.Svg("shield", 16)
                <span>@L["Nav.SystemConsole"]</span>
            </a>
        </li>
    }
</ul>
