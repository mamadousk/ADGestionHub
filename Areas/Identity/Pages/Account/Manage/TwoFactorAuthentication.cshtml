@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = L.T("Double authentification (2FA)", "Two-Factor Authentication (2FA)");
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h2 class="h5 fw-semibold mb-1">@ViewData["Title"]</h2>
<p class="text-slate small mb-4">@L.T("Renforcez la sécurité de votre compte.", "Protect your account with a second factor.")</p>

<partial name="_StatusMessage" for="StatusMessage" />

@{
    var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
    if (consentFeature?.CanTrack ?? true)
    {
        if (Model.Is2faEnabled)
        {
            if (Model.RecoveryCodesLeft <= 3)
            {
                <div class="alert alert-warning mb-3 small num">
                    @L.T("Codes de récupération restants :", "Recovery codes remaining:") <strong>@Model.RecoveryCodesLeft</strong> —
                    <a asp-page="./GenerateRecoveryCodes">@L.T("Générer de nouveaux codes", "Generate new codes")</a>
                </div>
            }

            if (Model.IsMachineRemembered)
            {
                <form method="post" class="d-inline-block mb-2">
                    <button type="submit" class="btn btn-secondary-outline btn-sm">@L.T("Oublier ce navigateur", "Forget this browser")</button>
                </form>
            }

            <div class="d-flex flex-wrap gap-2 mb-4">
                <a asp-page="./Disable2fa" class="btn btn-danger-outline">@L.T("Désactiver la 2FA", "Disable 2FA")</a>
                <a asp-page="./GenerateRecoveryCodes" class="btn btn-secondary-outline">@L.T("Codes de secours", "Recovery codes")</a>
            </div>
        }

        <h3 class="h6 fw-semibold mb-2">@L.T("Application TOTP", "Authenticator App")</h3>
        @if (!Model.HasAuthenticator)
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-accent">
                @L.T("Configurer une application", "Add authenticator app")
            </a>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2">
                <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-secondary-outline">@L.T("Reconfigurer", "Reconfigure")</a>
                <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-danger-outline">@L.T("Réinitialiser", "Reset key")</a>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning small">
            @L.T("Veuillez accepter les cookies techniques pour activer la double authentification.", "Please accept technical cookies to enable two-factor authentication.")
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
