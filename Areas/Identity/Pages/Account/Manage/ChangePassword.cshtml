@page
@model ChangePasswordModel
@{
    ViewData["Title"] = L.T("Mot de passe", "Password");
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h2 class="h5 fw-semibold mb-1">@ViewData["Title"]</h2>
<p class="text-slate small mb-4">@L.T("Modifiez votre mot de passe de connexion.", "Change your account password.")</p>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post" style="max-width: 480px;">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Input.OldPassword" class="form-label">@L.T("Mot de passe actuel", "Current password")</label>
        <input asp-for="Input.OldPassword" class="form-control" />
        <span asp-validation-for="Input.OldPassword" class="text-sober-red small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.NewPassword" class="form-label">@L.T("Nouveau mot de passe", "New password")</label>
        <input asp-for="Input.NewPassword" class="form-control" />
        <span asp-validation-for="Input.NewPassword" class="text-sober-red small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label">@L.T("Confirmer", "Confirm new password")</label>
        <input asp-for="Input.ConfirmPassword" class="form-control" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-sober-red small"></span>
    </div>

    <button type="submit" class="btn btn-accent">@L["Action.Save"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
