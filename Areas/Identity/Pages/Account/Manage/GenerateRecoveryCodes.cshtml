@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = L.T("Codes de récupération (2FA)", "2FA Recovery Codes");
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h2 class="h5 fw-semibold mb-1">@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="alert alert-warning mb-3">
    <strong>@L.T("Conservez ces codes en lieu sûr.", "Store recovery codes securely.")</strong>
    <div class="small mt-1">@L.T("Sans vos codes de secours ni votre appareil, l'accès au compte sera bloqué.", "Without recovery codes or your device, account access cannot be recovered.")</div>
</div>

<form method="post">
    <button class="btn btn-accent" type="submit">@L.T("Générer de nouveaux codes", "Generate recovery codes")</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
