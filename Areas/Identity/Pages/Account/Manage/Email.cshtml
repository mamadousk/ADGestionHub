@page
@model EmailModel
@{
    ViewData["Title"] = "Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h2 class="h5 fw-semibold mb-1">@ViewData["Title"]</h2>
<p class="text-slate small mb-4">@L.T("Modifiez votre adresse email de connexion.", "Manage your login email address.")</p>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="email-form" method="post" style="max-width: 480px;">
    <div asp-validation-summary="All" class="alert alert-danger mb-3" role="alert"></div>

    @if (Model.IsEmailConfirmed)
    {
        <div class="mb-3">
            <label asp-for="Email" class="form-label">@L.T("Email actuel", "Current email")</label>
            <div class="input-group">
                <input asp-for="Email" class="form-control" disabled />
                <span class="input-group-text status-pill success rounded-end">@L.T("Confirmé", "Verified")</span>
            </div>
        </div>
    }
    else
    {
        <div class="mb-3">
            <label asp-for="Email" class="form-label">@L.T("Email actuel", "Current email")</label>
            <div class="input-group">
                <input asp-for="Email" class="form-control" disabled />
                <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-secondary-outline">
                    @L.T("Vérifier", "Verify")
                </button>
            </div>
        </div>
    }

    <div class="mb-3">
        <label asp-for="Input.NewEmail" class="form-label">@L.T("Nouvel email", "New email")</label>
        <input asp-for="Input.NewEmail" class="form-control" />
        <span asp-validation-for="Input.NewEmail" class="text-sober-red small"></span>
    </div>

    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-accent">
        @L["Action.Save"]
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
