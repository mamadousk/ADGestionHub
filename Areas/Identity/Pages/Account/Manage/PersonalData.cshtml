@page
@model PersonalDataModel
@{
    ViewData["Title"] = L.T("Données personnelles", "Personal Data");
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h2 class="h5 fw-semibold mb-1">@ViewData["Title"]</h2>
<p class="text-slate small mb-4">@L.T("Exportez ou supprimez les données personnelles liées à votre compte.", "Export or delete personal data associated with your account.")</p>

<div style="max-width: 560px;">
    <div class="p-3 rounded border mb-3" style="background: var(--bg-canvas);">
        <p class="small mb-2">@L.T("Vous pouvez télécharger une archive JSON de vos données personnelles ou demander la clôture définitive de votre compte.", "You can download a JSON archive of your personal data or permanently close your account.")</p>
        <p class="small text-sober-red fw-medium mb-0">@L.T("La suppression des données entraîne la fermeture irréversible du compte.", "Deleting personal data permanently closes your account.")</p>
    </div>

    <div class="d-flex gap-2">
        <form id="download-data" asp-page="DownloadPersonalData" method="post">
            <button class="btn btn-secondary-outline" type="submit">@L.T("Télécharger mes données", "Download data")</button>
        </form>
        <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger-outline">@L.T("Supprimer mon compte", "Delete account")</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
