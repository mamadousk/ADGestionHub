@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Demande de réinitialisation";
}

<div class="py-4 auth-shell">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="panel-card auth-card p-4 p-md-5 text-center">
                <h1 class="h5 mb-3">Demande prise en compte</h1>
                <p class="text-slate small mb-3">
                    Si votre adresse est associée à un compte confirmé, vous recevrez un lien de réinitialisation.
                    Si elle n’est pas encore confirmée, un lien de confirmation vous a été envoyé.
                </p>
                <p class="text-slate small mb-4">
                    Vérifiez vos courriers indésirables. Si vous ne recevez rien, réessayez dans quelques minutes.
                </p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a asp-page="./Login" class="btn btn-accent">Aller à la connexion</a>
                    <a asp-page="./ForgotPassword" class="btn btn-secondary-outline">Renvoyer la demande</a>
                </div>
            </div>
        </div>
    </div>
</div>
