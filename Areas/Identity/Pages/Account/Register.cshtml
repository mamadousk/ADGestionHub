@page
@model RegisterModel
@{
    ViewData["Title"] = "Créer mon entreprise";
}
<div class="auth-surface mx-auto">
    <div class="panel-card p-4 p-md-5">
        <p class="section-eyebrow">Inscription gratuite · Première étape</p>
        <h1 class="h3 mb-2">Créer mon entreprise</h1>
        <p class="text-slate mb-4">Créez votre compte administrateur sans carte bancaire. Vous pourrez ensuite lire et accepter les conditions d’utilisation, puis configurer votre boutique maintenant ou plus tard.</p>
        <p class="small mb-4"><a asp-area="" asp-controller="Infos" asp-action="CGU">Conditions d’utilisation</a> · <a asp-area="" asp-controller="Infos" asp-action="Confidentialite">Confidentialité</a></p>
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="All" class="validation-banner" role="alert"></div>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Input.StoreName" class="form-label">Nom de l’entreprise</label>
                    <input asp-for="Input.StoreName" class="form-control" autocomplete="organization" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.PrimaryCurrencyCode" class="form-label">Devise du catalogue</label>
                    <select asp-for="Input.PrimaryCurrencyCode" class="form-select">
                        <option value="CDF">Franc congolais (CDF)</option><option value="USD">Dollar américain (USD)</option>
                    </select>
                    <div class="form-text">Choisissez la devise de vos prix habituels.</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.PhoneNumber" class="form-label">Téléphone <small class="text-slate">(facultatif)</small></label>
                    <input asp-for="Input.PhoneNumber" type="tel" class="form-control" autocomplete="tel" placeholder="+243" />
                </div>
                <div class="col-12">
                    <label asp-for="Input.Email" class="form-label">Adresse e-mail</label>
                    <input asp-for="Input.Email" class="form-control" type="email" autocomplete="email" required />
                </div>
                <div class="col-12">
                    <label asp-for="Input.Password" class="form-label">Mot de passe</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" minlength="8" required />
                    <div class="form-text">8 caractères minimum, avec majuscule, minuscule, chiffre et caractère spécial.</div>
                </div>
                <div class="col-12">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirmer le mot de passe</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" required />
                </div>
            </div>
            <button type="submit" class="btn btn-accent w-100 mt-4">Créer mon entreprise</button>
        </form>
        <p class="text-slate text-center small mb-0 mt-4">Déjà un compte ? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Se connecter</a></p>
    </div>
</div>
