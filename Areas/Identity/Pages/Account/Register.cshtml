@page
@model RegisterModel
@{
    ViewData["Title"] = "Inscription";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden fade-in-up">
                <div class="card-header bg-gradient-orange-soft text-white text-center py-4 border-0">
                    <h2 class="fw-bold mb-0">
                        <i class="fas fa-user-plus me-2"></i> Créer ma boutique
                    </h2>
                    <p class="text-white-50 mb-0 small">Démarrez gratuitement sur AdGestionHub</p>
                </div>

                <div class="card-body p-4 p-lg-5">
                    <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-modern" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.StoreName" class="form-control form-control-modern" placeholder="Nom de la boutique" />
                            <label asp-for="Input.StoreName"><i class="fas fa-store me-2"></i>Nom de la boutique</label>
                            <span asp-validation-for="Input.StoreName" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.PhoneNumber" class="form-control form-control-modern" placeholder="Téléphone" autocomplete="tel" />
                            <label asp-for="Input.PhoneNumber"><i class="fas fa-phone me-2"></i>Téléphone (WhatsApp)</label>
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control form-control-modern" placeholder="Email" autocomplete="email" />
                            <label asp-for="Input.Email"><i class="fas fa-envelope me-2"></i>Email professionnel</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3 position-relative">
                            <input asp-for="Input.Password" class="form-control form-control-modern" placeholder="Mot de passe" id="password" autocomplete="new-password" />
                            <label asp-for="Input.Password"><i class="fas fa-lock me-2"></i>Mot de passe (8+ car., Maj, chiffre, symbole)</label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            <span class="position-absolute end-0 top-50 translate-middle-y me-3 toggle-password" onclick="togglePassword('password')">
                                <i class="far fa-eye" id="eye-icon"></i>
                            </span>
                        </div>

                        <div class="form-floating mb-4 position-relative">
                            <input asp-for="Input.ConfirmPassword" class="form-control form-control-modern" placeholder="Confirmer" id="confirm-password" autocomplete="new-password" />
                            <label asp-for="Input.ConfirmPassword"><i class="fas fa-check-circle me-2"></i>Confirmer le mot de passe</label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                            <span class="position-absolute end-0 top-50 translate-middle-y me-3 toggle-password" onclick="togglePassword('confirm-password')">
                                <i class="far fa-eye" id="confirm-eye-icon"></i>
                            </span>
                        </div>

                        <button type="submit" class="btn btn-primary-gradient w-100 py-3 fw-bold rounded-3">
                            <i class="fas fa-rocket me-2"></i> Créer mon compte gratuit
                        </button>
                    </form>

                    <div class="mt-4 text-center">
                        <p class="text-muted small mb-0">
                            Vous avez déjà un compte ?
                            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-orange fw-bold text-decoration-none">Connectez-vous</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(fieldId) {
            var field = document.getElementById(fieldId);
            var icon = document.getElementById(fieldId === 'password' ? 'eye-icon' : 'confirm-eye-icon');
            if (field.type === "password") {
                field.type = "text";
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                field.type = "password";
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
}
