@page
@model RegisterModel
@{
    ViewData["Title"] = L["Nav.Register"];
    var countries = CountryProfileCatalog.AllCountries;
    var en = L.IsEnglish;
}

<div class="container py-4 auth-shell">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-6">
            <div class="panel-card auth-card p-4 p-md-5">
                <div class="mb-4">
                    <h1 class="h5 mb-1">@L.T("Créer un espace établissement", "Create your business workspace")</h1>
                    <p class="text-slate small mb-0">
                        @L.T(
                            "La devise principale, les formats régionaux et les paramètres fiscaux s'ajustent automatiquement selon votre pays.",
                            "Primary currency, regional formats, and tax defaults adjust automatically to your country.")
                    </p>
                </div>

                <form asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Input.StoreName" class="form-label">@L.T("Nom de l'établissement", "Business / Store Name")</label>
                            <input asp-for="Input.StoreName" class="form-control" placeholder="@L.T("Ex : Quincaillerie Centrale", "e.g. Central Hardware")" />
                            <span asp-validation-for="Input.StoreName" class="text-sober-red small"></span>
                        </div>

                        <div class="col-md-7">
                            <label asp-for="Input.CountryCode" class="form-label">@L.T("Pays", "Country")</label>
                            <select asp-for="Input.CountryCode" class="form-select" id="regCountrySelect">
                                @foreach (var c in countries)
                                {
                                    <option value="@c.Code"
                                            data-currency="@c.PrimaryCurrencyCode"
                                            data-dial="@c.PhoneDialCode"
                                            data-lang="@c.DefaultLanguage"
                                            data-vat="@c.StandardVatRate.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-legal="@(en ? c.TaxIdLabelEn : c.TaxIdLabelFr) / @(en ? c.TradeRegisterLabelEn : c.TradeRegisterLabelFr)">
                                        @(en ? c.NameEn : c.NameFr) (@c.PrimaryCurrencyCode)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="Input.PreferredLanguage" class="form-label">@L.T("Langue", "Language")</label>
                            <select asp-for="Input.PreferredLanguage" class="form-select" id="regLanguageSelect">
                                <option value="fr">Français (FR)</option>
                                <option value="en">English (EN)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <div class="p-2 px-3 rounded border num text-slate" style="background: var(--bg-canvas); font-size: 0.78rem;">
                                <span>@L.T("Devise par défaut :", "Default currency:") <strong id="regPreviewCurrency" class="text-dark">CDF</strong></span>
                                <span class="mx-2">·</span>
                                <span>@L.T("Référentiel légal :", "Legal IDs:") <strong id="regPreviewLegal" class="text-dark">NIF / RCCM</strong></span>
                                <span class="mx-2">·</span>
                                <span>@L.T("TVA standard :", "Standard VAT:") <strong id="regPreviewVat" class="text-dark">16%</strong></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.PhoneNumber" class="form-label">@L.T("Téléphone", "Phone")</label>
                            <input asp-for="Input.PhoneNumber" class="form-control num" id="regPhoneInput" autocomplete="tel" />
                            <span asp-validation-for="Input.PhoneNumber" class="text-sober-red small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.Email" class="form-label">@L.T("Email professionnel", "Work Email")</label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="contact@entreprise.com" />
                            <span asp-validation-for="Input.Email" class="text-sober-red small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.Password" class="form-label">@L.T("Mot de passe", "Password")</label>
                            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Input.Password" class="text-sober-red small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Input.ConfirmPassword" class="form-label">@L.T("Confirmation", "Confirm Password")</label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-sober-red small"></span>
                        </div>
                    </div>

                    <div class="form-text mt-2 mb-4">
                        @L.T("Minimum 8 caractères incluant majuscule, minuscule, chiffre et caractère spécial.", "Minimum 8 characters including uppercase, lowercase, digit, and special character.")
                    </div>

                    <button type="submit" class="btn btn-accent w-100 py-2">
                        @L.T("Ouvrir mon compte", "Create workspace")
                    </button>
                </form>

                <div class="mt-4 pt-3 border-top text-center small text-slate">
                    @L.T("Déjà inscrit ?", "Already registered?")
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-orange fw-medium text-decoration-none ms-1">
                        @L["Nav.Login"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const countrySel = document.getElementById("regCountrySelect");
            const langSel = document.getElementById("regLanguageSelect");
            const phoneInput = document.getElementById("regPhoneInput");
            let lastDial = "+243";

            function updateCountryMeta(changedByUser) {
                const opt = countrySel.options[countrySel.selectedIndex];
                if (!opt) return;
                const cur = opt.getAttribute("data-currency");
                const dial = opt.getAttribute("data-dial") || "+243";
                const legal = opt.getAttribute("data-legal");
                const vat = opt.getAttribute("data-vat");
                const defLang = opt.getAttribute("data-lang");

                document.getElementById("regPreviewCurrency").textContent = cur;
                document.getElementById("regPreviewLegal").textContent = legal;
                document.getElementById("regPreviewVat").textContent = vat + "%";

                if (changedByUser) {
                    const currentPhone = phoneInput.value.trim();
                    if (!currentPhone || currentPhone === lastDial) {
                        phoneInput.value = dial + " ";
                    }
                    if (defLang) {
                        langSel.value = defLang;
                    }
                }
                lastDial = dial;
            }

            countrySel.addEventListener("change", function () { updateCountryMeta(true); });
            updateCountryMeta(false);
        })();
    </script>
}
