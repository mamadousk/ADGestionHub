@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Accès refusé";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 text-center">
            <div class="card border-0 shadow-sm rounded-4 p-5">
                <div class="mb-3">
                    <i class="fas fa-shield-alt text-danger" style="font-size: 4rem;"></i>
                </div>
                <h2 class="fw-bold text-danger mb-2">Accès restreint</h2>
                <p class="text-muted mb-4">
                    Vous ne disposez pas des autorisations nécessaires pour accéder à cette section.
                    Cette fonctionnalité est réservée au gérant (Administrateur) de la boutique.
                </p>
                <div>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary-gradient px-4">
                        <i class="fas fa-arrow-left me-2"></i> Retour au tableau de bord
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
