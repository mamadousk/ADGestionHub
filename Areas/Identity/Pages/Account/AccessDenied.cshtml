@page
@model AccessDeniedModel
@{
    ViewData["Title"] = L.T("Accès restreint", "Access Denied");
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="panel-card p-4 text-center">
                <div class="mb-2 text-sober-red">
                    @LucideIcons.Svg("lock", 28)
                </div>
                <h1 class="h5 mb-2">@L.T("Accès non autorisé", "Restricted Access")</h1>
                <p class="text-slate small mb-4">
                    @L.T(
                        "Votre profil ne dispose pas des permissions nécessaires pour consulter cette section.",
                        "Your account role does not have permission to view this section.")
                </p>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-secondary-outline">
                    @L["Action.Back"]
                </a>
            </div>
        </div>
    </div>
</div>
