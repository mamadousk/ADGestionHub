@page
@model LoginWithEmailCodeModel
@{
    ViewData["Title"] = "Vérification du code e-mail";
}

<div class="py-4 auth-shell">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="panel-card auth-card p-4 p-md-5">
                <h1 class="h5 mb-2">Vérifiez votre code</h1>
                <p class="text-slate small mb-4">
                    Si un compte existe pour <strong>@Model.MaskedEmail</strong>, un code à 6 chiffres vient d’être envoyé.
                    Saisissez-le ci-dessous.
                </p>

                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Code" class="form-label">Code de connexion</label>
                        <input asp-for="Input.Code" class="form-control" autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]*" maxlength="6" />
                        <span asp-validation-for="Input.Code" class="text-sober-red small"></span>
                    </div>

                    <button type="submit" class="btn btn-accent w-100 py-2">Valider</button>
                </form>

                <div class="mt-4 pt-3 border-top text-center small text-slate">
                    <a asp-page="./LoginWithEmail" asp-route-returnUrl="@Model.ReturnUrl" class="text-orange fw-medium text-decoration-none">Renvoyer un code</a>
                    <span class="mx-2">·</span>
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-slate text-decoration-none">Retour à la connexion</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
