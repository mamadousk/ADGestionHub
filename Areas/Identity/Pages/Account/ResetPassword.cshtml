@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Nouveau mot de passe";
}

<div class="py-4 auth-shell">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="panel-card auth-card p-4 p-md-5">
                <h1 class="h5 mb-2">@ViewData["Title"]</h1>
                <p class="text-slate small mb-4">Choisissez un nouveau mot de passe pour votre compte.</p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>
                    <input asp-for="Input.Code" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Adresse e-mail</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Input.Email" class="text-sober-red small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Nouveau mot de passe</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.Password" class="text-sober-red small"></span>
                        <div class="form-text">8 caractères minimum, avec majuscule, minuscule, chiffre et caractère spécial.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Confirmer le mot de passe</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-sober-red small"></span>
                    </div>

                    <button type="submit" class="btn btn-accent w-100 py-2">Enregistrer le nouveau mot de passe</button>
                </form>

                <div class="text-center mt-3 pt-3 border-top">
                    <a asp-page="./Login" class="text-slate text-decoration-none small">Retour à la connexion</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
