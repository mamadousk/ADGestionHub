@page
@model ConfirmEmailChangeModel
@{
    ViewData["Title"] = "Confirmation du changement d’adresse e-mail";
}

<div class="py-4 auth-shell">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="panel-card auth-card p-4 p-md-5 text-center">
                <h1 class="h5 mb-3">@ViewData["Title"]</h1>
                <partial name="_StatusMessage" model="Model.StatusMessage" />
                <a asp-page="./Manage/Email" class="btn btn-accent mt-3">Gérer mon adresse e-mail</a>
            </div>
        </div>
    </div>
</div>
