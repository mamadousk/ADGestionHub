@page
@model LoginModel
@{
    ViewData["Title"] = L["Nav.Login"];
    var lang = L.CurrentLanguage;
    var returnUrl = HttpContext.Request.Path + HttpContext.Request.QueryString;
}

<div class="container py-4 auth-shell">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="panel-card auth-card p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <h1 class="h5 mb-1">@L["Nav.Login"]</h1>
                        <p class="text-slate small mb-0">
                            @L.T("Accédez à votre espace de gestion", "Sign in to your workspace")
                        </p>
                    </div>
                    <div class="lang-switch" role="group" aria-label="Language">
                        <a href="@Url.Action("Set", "Localization", new { lang = "fr", returnUrl })" class="@(lang == "fr" ? "active" : "")">FR</a>
                        <a href="@Url.Action("Set", "Localization", new { lang = "en", returnUrl })" class="@(lang == "en" ? "active" : "")">EN</a>
                    </div>
                </div>

                <form id="account" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">@L.T("Email ou identifiant", "Email or username")</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="nom@entreprise.com" />
                        <span asp-validation-for="Input.Email" class="text-sober-red small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">@L.T("Mot de passe", "Password")</label>
                        <input asp-for="Input.Password" class="form-control" id="login-password" autocomplete="current-password" />
                        <span asp-validation-for="Input.Password" class="text-sober-red small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label small text-slate" asp-for="Input.RememberMe">
                            @L.T("Maintenir la session active", "Keep me signed in")
                        </label>
                    </div>

                    <button type="submit" class="btn btn-accent w-100 py-2">
                        @L["Nav.Login"]
                    </button>
                </form>

                <div class="mt-4 pt-3 border-top text-center small text-slate">
                    @L.T("Nouvel établissement ?", "New business?")
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-orange fw-medium text-decoration-none ms-1">
                        @L["Nav.Register"]
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
