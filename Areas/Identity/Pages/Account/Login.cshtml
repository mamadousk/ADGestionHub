@page
@model LoginModel
@{
    ViewData["Title"] = "Connexion";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden fade-in-up">
                <div class="card-header bg-gradient-orange-soft text-white text-center py-4 border-0">
                    <h2 class="fw-bold mb-0">
                        <i class="fas fa-sign-in-alt me-2"></i> Connexion
                    </h2>
                    <p class="text-white-50 mb-0 small">Accédez à votre espace de gestion</p>
                </div>

                <div class="card-body p-4 p-lg-5">
                    <form id="account" method="post">
                        <div asp-validation-summary="All" class="alert alert-danger alert-modern" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control form-control-modern" placeholder="Email" />
                            <label asp-for="Input.Email"><i class="fas fa-envelope me-2"></i>Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="form-floating mb-3 position-relative">
                            <input asp-for="Input.Password" class="form-control form-control-modern" placeholder="Mot de passe" id="login-password" />
                            <label asp-for="Input.Password"><i class="fas fa-lock me-2"></i>Mot de passe</label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            <span class="position-absolute end-0 top-50 translate-middle-y me-3 toggle-password" onclick="togglePassword('login-password')">
                                <i class="far fa-eye" id="login-eye-icon"></i>
                            </span>
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label" asp-for="Input.RememberMe">
                                <i class="fas fa-check-circle me-1 text-orange"></i> Se souvenir de moi
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary-gradient w-100 py-3 fw-bold rounded-3">
                            <i class="fas fa-sign-in-alt me-2"></i> Se connecter
                        </button>
                    </form>

                    <div class="mt-4 text-center">
                        <p class="text-muted small">
                            Pas encore de compte ?
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-orange fw-bold text-decoration-none">Inscrivez-vous</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(fieldId) {
            var field = document.getElementById(fieldId);
            var icon = document.getElementById('login-eye-icon');
            if (field.type === "password") {
                field.type = "text";
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                field.type = "password";
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    </script>
}