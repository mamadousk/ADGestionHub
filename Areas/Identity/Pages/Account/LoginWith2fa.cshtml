@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Double authentification";
}

<div class="py-4 auth-shell">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="panel-card auth-card p-4 p-md-5">
                <h1 class="h5 mb-2">@ViewData["Title"]</h1>
                <p class="text-slate small mb-4">
                    Saisissez le code temporaire affiché par votre application d’authentification.
                </p>

                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <input asp-for="RememberMe" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.TwoFactorCode" class="form-label">Code temporaire</label>
                        <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="off" inputmode="numeric" />
                        <span asp-validation-for="Input.TwoFactorCode" class="text-sober-red small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" asp-for="Input.RememberMachine" />
                        <label class="form-check-label small text-slate" asp-for="Input.RememberMachine">
                            Faire confiance à cet appareil
                        </label>
                    </div>

                    <button type="submit" class="btn btn-accent w-100 py-2">Se connecter</button>
                </form>

                <div class="mt-4 pt-3 border-top">
                    <h2 class="h6 fw-semibold mb-1">Code par e-mail</h2>
                    <p class="text-slate small mb-3">
                        Si vous n’avez pas votre application d’authentification, recevez un code à 6 chiffres sur votre adresse e-mail.
                    </p>

                    @if (Model.EmailCodeSent)
                    {
                        <div class="alert alert-success small" role="status">
                            Un code a été envoyé à votre adresse e-mail. Vérifiez vos courriers indésirables si nécessaire.
                        </div>

                        <form method="post" asp-page-handler="VerifyEmailCode" asp-route-returnUrl="@Model.ReturnUrl"
                              asp-route-rememberMe="@Model.RememberMe" class="mb-2">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="EmailCode" class="form-label">Code reçu par e-mail</label>
                                <input asp-for="EmailCode" class="form-control" autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]*" maxlength="6" />
                                <span asp-validation-for="EmailCode" class="text-sober-red small"></span>
                            </div>

                            <div class="form-check mb-3">
                                <input class="form-check-input" asp-for="Input.RememberMachine" />
                                <label class="form-check-label small text-slate" asp-for="Input.RememberMachine">
                                    Faire confiance à cet appareil
                                </label>
                            </div>

                            <button type="submit" class="btn btn-accent w-100 py-2">Valider le code</button>
                        </form>

                        <form method="post" asp-page-handler="SendEmailCode" asp-route-returnUrl="@Model.ReturnUrl"
                              asp-route-rememberMe="@Model.RememberMe" class="text-center">
                            <button type="submit" class="btn btn-link btn-sm text-slate text-decoration-none">Renvoyer le code</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="SendEmailCode" asp-route-returnUrl="@Model.ReturnUrl"
                              asp-route-rememberMe="@Model.RememberMe">
                            <button type="submit" class="btn btn-secondary-outline w-100 py-2">Recevoir un code par e-mail</button>
                        </form>
                    }
                </div>

                <div class="text-center mt-3 pt-3 border-top small">
                    <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="text-slate text-decoration-none">
                        Se connecter avec un code de secours
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
