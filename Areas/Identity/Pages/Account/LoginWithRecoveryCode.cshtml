@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Code de secours";
}

<h1>@ViewData["Title"]</h1>
<hr />
<p>
    Saisissez l’un de vos codes de secours. Cette connexion n’ajoute pas cet appareil à vos appareils de confiance.
</p>
<div class="row">
    <div class="col-md-4">
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="Code de secours" />
                <label asp-for="Input.RecoveryCode" class="form-label">Code de secours</label>
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Se connecter</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
