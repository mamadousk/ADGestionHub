@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Mot de passe réinitialisé";
}

<div class="py-4 auth-shell">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="panel-card auth-card p-4 p-md-5 text-center">
                <h1 class="h5 mb-3">Mot de passe réinitialisé</h1>
                <p class="text-slate small mb-4">Vous pouvez vous reconnecter avec votre nouveau mot de passe.</p>
                <a asp-page="./Login" class="btn btn-accent">Aller à la connexion</a>
            </div>
        </div>
    </div>
</div>
