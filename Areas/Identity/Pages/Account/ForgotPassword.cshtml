@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = L["Auth.ForgotPassword"];
}

<div class="py-4 auth-shell">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="panel-card auth-card p-4 p-md-5">
                <h1 class="h5 mb-2">@L["Auth.ForgotPassword"]</h1>
                <p class="text-slate small mb-4">
                    Saisissez votre adresse e-mail. Si votre compte est confirmé, vous recevrez un lien de réinitialisation.
                    Si l’adresse n’est pas encore confirmée, un lien de confirmation vous sera envoyé.
                </p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Adresse e-mail</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Input.Email" class="text-sober-red small"></span>
                    </div>

                    <button type="submit" class="btn btn-accent w-100 py-2">Envoyer le lien</button>
                </form>

                <div class="text-center mt-3 pt-3 border-top small">
                    <a asp-page="./ResendEmailConfirmation" class="text-slate text-decoration-none d-block mb-2">
                        Renvoyer l’e-mail de confirmation
                    </a>
                    <a asp-page="./Login" class="text-slate text-decoration-none">Retour à la connexion</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
