@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = L["Auth.ForgotPassword"];
}

<div class="auth-shell">
    <div class="auth-card">
        <h1 class="h4 fw-bold mb-1">@L["Auth.ForgotPassword"]</h1>
        <p class="text-slate small mb-4">@L.T("Saisissez votre adresse email pour recevoir un lien de réinitialisation.", "Enter your email address to receive a password reset link.")</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">@L["Auth.Email"]</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-sober-red small"></span>
            </div>

            <button type="submit" class="btn btn-accent w-100 py-2">
                @L.T("Envoyer le lien", "Send reset link")
            </button>
        </form>

        <div class="text-center mt-3 pt-3 border-top">
            <a asp-page="./Login" class="text-slate text-decoration-none small">@L["Action.Back"]</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
